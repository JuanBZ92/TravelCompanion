@page "/admin/reservations"
@model TravelCompanion.Api.Pages.Admin.ReservationsModel
@{
    ViewData["Title"] = "Schedule";
}

<h1>Schedule</h1>
<p class="lede">Viajes y elementos de agenda que aparecen en el itinerary del viajero.</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="alert">
        <strong>@Model.StatusMessage</strong>
    </section>
}

<section class="panel">
    <div class="section-header">
        <div>
            <h2>@(Model.TripInput.Id.HasValue ? "Editar viaje" : "Nuevo viaje")</h2>
            <p class="muted">Un viaje pertenece a un usuario y agrupa reservas, recomendaciones y eventos por destino.</p>
        </div>
        <span class="badge">Itinerario</span>
    </div>
    <form method="post" asp-page-handler="SaveTrip">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="TripInput.Id" />
        <div class="form-grid">
            <div>
                <label asp-for="TripInput.ExternalId">External ID <span class="muted">(import)</span></label>
                <input asp-for="TripInput.ExternalId" placeholder="japan-demo-2026" />
                <span asp-validation-for="TripInput.ExternalId"></span>
            </div>
            <div>
                <label asp-for="TripInput.UserId" class="required">Usuario</label>
                <select asp-for="TripInput.UserId" asp-items="Model.UserOptions" data-trip-user-select></select>
                <span asp-validation-for="TripInput.UserId"></span>
            </div>
            <div>
                <label asp-for="TripInput.DestinationId" class="required">Destino</label>
                <select asp-for="TripInput.DestinationId" asp-items="Model.DestinationOptions"></select>
                <span asp-validation-for="TripInput.DestinationId"></span>
            </div>
            <div>
                <label asp-for="TripInput.TravelerName" class="required">Viajero</label>
                <input asp-for="TripInput.TravelerName" data-trip-traveler-name required />
                <span asp-validation-for="TripInput.TravelerName"></span>
            </div>
            <div>
                <label asp-for="TripInput.TimeZoneId">Zona horaria del viaje</label>
                <input asp-for="TripInput.TimeZoneId" placeholder="Asia/Tokyo" />
                <p class="form-hint">Los horarios del viaje se interpretan en esta zona y se convierten a UTC para notificaciones.</p>
                <span asp-validation-for="TripInput.TimeZoneId"></span>
            </div>
            <div>
                <label asp-for="TripInput.AccessPin">PIN de acceso <span class="muted">(4 numeros)</span></label>
                <input asp-for="TripInput.AccessPin" inputmode="numeric" maxlength="4" placeholder="1908" autocomplete="off" />
                <p class="form-hint">Dejalo vacio al editar para conservar el PIN actual.</p>
                <span asp-validation-for="TripInput.AccessPin"></span>
            </div>
            <div>
                <label asp-for="TripInput.StartsOn" class="required">Inicio</label>
                <input asp-for="TripInput.StartsOn" type="date" />
                <span asp-validation-for="TripInput.StartsOn"></span>
            </div>
            <div>
                <label asp-for="TripInput.EndsOn" class="required">Fin</label>
                <input asp-for="TripInput.EndsOn" type="date" />
                <span asp-validation-for="TripInput.EndsOn"></span>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Guardar viaje</button>
            @if (Model.TripInput.Id.HasValue)
            {
                <a class="button secondary" asp-page="/Admin/Reservations" asp-route-selectedTripId="@Model.TripInput.Id">Cancelar</a>
            }
        </div>
    </form>
</section>

<section class="panel" style="margin-top: 18px;">
    <h2>Viajes</h2>
    <table>
        <thead>
            <tr>
                <th>Viaje</th>
                <th>Usuario</th>
                <th>Fechas</th>
                <th>PIN</th>
                <th>Agenda</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var trip in Model.Trips)
        {
            <tr>
                <td>
                    <strong>@trip.TravelerName</strong><br />
                    <span class="muted">@trip.DestinationName</span>
                    <br />
                    <span class="mono">@trip.TimeZoneId</span>
                    @if (!string.IsNullOrWhiteSpace(trip.ExternalId))
                    {
                        <br />
                        <span class="mono">@trip.ExternalId</span>
                    }
                </td>
                <td>@trip.UserEmail</td>
                <td>
                    @trip.StartsOn.ToString("yyyy-MM-dd")<br />
                    <span class="muted">@trip.EndsOn.ToString("yyyy-MM-dd")</span>
                </td>
                <td>
                    <span class="badge">@(trip.HasAccessPin ? "Configurado" : "Sin PIN")</span>
                </td>
                <td>@trip.ReservationCount</td>
                <td>
                    <div class="row-actions">
                        <a class="button secondary" asp-page="/Admin/Reservations" asp-route-selectedTripId="@trip.Id" asp-fragment="reservations-list">Ver agenda</a>
                        <a class="button secondary" asp-page="/Admin/Reservations" asp-route-editTripId="@trip.Id">Editar</a>
                        <form method="post" asp-page-handler="DeleteTrip" asp-route-id="@trip.Id">
                            <button class="danger" type="submit">Borrar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

<section class="panel" style="margin-top: 18px;">
    <div class="section-header">
        <div>
            <h2>@(Model.Input.Id.HasValue ? "Editar elemento de agenda" : "Nuevo elemento de agenda")</h2>
            <p class="muted">Define si es una reserva confirmada, una recomendacion asignada o un evento manual.</p>
        </div>
        <span class="badge">Evento / vuelo / hospedaje</span>
    </div>
    <form method="post" asp-page-handler="Save">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="Input.Id" />
        <div class="field-group">
            <h3>Datos comunes</h3>
        <div class="form-grid">
            <div>
                <label asp-for="Input.ExternalId">External ID <span class="muted">(import)</span></label>
                <input asp-for="Input.ExternalId" placeholder="sch-demo-event-ginza" />
                <span asp-validation-for="Input.ExternalId"></span>
            </div>
            <div>
                <label asp-for="Input.TripId" class="required">Viaje</label>
                <select asp-for="Input.TripId" asp-items="Model.TripOptions"></select>
                <span asp-validation-for="Input.TripId"></span>
            </div>
            <div>
                <label asp-for="Input.Type" class="required">Tipo</label>
                <select asp-for="Input.Type" asp-items="Model.TypeOptions" data-reservation-type></select>
                <span asp-validation-for="Input.Type"></span>
            </div>
            <div>
                <label asp-for="Input.PlanningKind" class="required">Naturaleza</label>
                <select asp-for="Input.PlanningKind" asp-items="Model.PlanningKindOptions" data-planning-kind></select>
                <p class="form-hint">Distingue una reserva confirmada de una recomendacion asignada o un evento manual.</p>
                <span asp-validation-for="Input.PlanningKind"></span>
            </div>
            <div>
                <label asp-for="Input.RecommendationId">Recomendacion vinculada <span class="muted">(opcional)</span></label>
                <select asp-for="Input.RecommendationId" asp-items="Model.RecommendationOptions" data-recommendation-select></select>
                <p class="form-hint">Usalo para planes curados asignados a un dia/hora. Today no volvera a proponerla en otro hueco.</p>
                <span asp-validation-for="Input.RecommendationId"></span>
            </div>
            <div>
                <label asp-for="Input.Date" class="required">Fecha</label>
                <input asp-for="Input.Date" type="date" />
                <span asp-validation-for="Input.Date"></span>
            </div>
            <div>
                <label asp-for="Input.StartsAt" class="required">Hora</label>
                <input asp-for="Input.StartsAt" type="time" />
                <span asp-validation-for="Input.StartsAt"></span>
            </div>
            <div>
                <label asp-for="Input.TimeZoneId">Zona horaria override <span class="muted">(opcional)</span></label>
                <input asp-for="Input.TimeZoneId" placeholder="Europe/Paris" />
                <p class="form-hint">Dejalo vacio para usar la zona del viaje. Usalo para vuelos o eventos en otra zona.</p>
                <span asp-validation-for="Input.TimeZoneId"></span>
            </div>
            <div>
                <label asp-for="Input.Title" class="required">Titulo</label>
                <input asp-for="Input.Title" />
                <span asp-validation-for="Input.Title"></span>
            </div>
            <div>
                <label asp-for="Input.City" class="required">Ciudad</label>
                <input asp-for="Input.City" />
                <span asp-validation-for="Input.City"></span>
            </div>
            <div data-reservation-section="Event,Lodging">
                <label asp-for="Input.LocationName" class="required">Lugar <span class="muted">(eventos/hospedajes)</span></label>
                <input asp-for="Input.LocationName" />
                <span asp-validation-for="Input.LocationName"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmationCode">Codigo <span class="muted">(opcional)</span></label>
                <input asp-for="Input.ConfirmationCode" />
                <span asp-validation-for="Input.ConfirmationCode"></span>
            </div>
        </div>
        </div>
        <div class="field-group" data-reservation-section="Flight,Lodging">
            <h3>Fin / hospedaje</h3>
            <p class="form-hint">Usa estos campos para checkout de hospedajes o llegada de vuelos.</p>
            <div class="form-grid">
                <div>
                    <label asp-for="Input.EndsOn">Fecha fin <span class="muted">(obligatoria para hospedajes)</span></label>
                    <input asp-for="Input.EndsOn" type="date" />
                    <span asp-validation-for="Input.EndsOn"></span>
                </div>
                <div>
                    <label asp-for="Input.EndsAt">Hora fin <span class="muted">(opcional)</span></label>
                    <input asp-for="Input.EndsAt" type="time" />
                    <span asp-validation-for="Input.EndsAt"></span>
                </div>
            </div>
        </div>
        <div class="field-group" data-reservation-section="Flight">
            <h3>Datos de vuelo</h3>
        <div class="form-grid">
            <div>
                <label asp-for="Input.Airline">Aerolinea <span class="muted">(vuelos, opcional)</span></label>
                <input asp-for="Input.Airline" />
                <span asp-validation-for="Input.Airline"></span>
            </div>
            <div>
                <label asp-for="Input.FlightNumber">Numero de vuelo <span class="muted">(obligatorio para vuelos)</span></label>
                <input asp-for="Input.FlightNumber" />
                <span asp-validation-for="Input.FlightNumber"></span>
            </div>
            <div>
                <label asp-for="Input.OriginName">Origen <span class="muted">(obligatorio para vuelos)</span></label>
                <input asp-for="Input.OriginName" />
                <span asp-validation-for="Input.OriginName"></span>
            </div>
            <div>
                <label asp-for="Input.DestinationName">Destino <span class="muted">(obligatorio para vuelos)</span></label>
                <input asp-for="Input.DestinationName" />
                <span asp-validation-for="Input.DestinationName"></span>
            </div>
            <div>
                <label asp-for="Input.OriginAirport">Aeropuerto origen <span class="muted">(opcional)</span></label>
                <input asp-for="Input.OriginAirport" />
                <span asp-validation-for="Input.OriginAirport"></span>
            </div>
            <div>
                <label asp-for="Input.DestinationAirport">Aeropuerto destino <span class="muted">(opcional)</span></label>
                <input asp-for="Input.DestinationAirport" />
                <span asp-validation-for="Input.DestinationAirport"></span>
            </div>
        </div>
        </div>
        <div style="margin-top: 12px;" data-reservation-section="Event,Lodging">
            <label asp-for="Input.Address">Direccion <span class="muted">(opcional)</span></label>
            <input asp-for="Input.Address" />
            <span asp-validation-for="Input.Address"></span>
        </div>
        <div style="margin-top: 12px;">
            <label asp-for="Input.Notes">Notas <span class="muted">(opcional)</span></label>
            <textarea asp-for="Input.Notes"></textarea>
            <span asp-validation-for="Input.Notes"></span>
        </div>
        <div class="form-grid" style="margin-top: 12px;">
            <div>
                <label asp-for="Input.SourceName">Fuente <span class="muted">(opcional)</span></label>
                <input asp-for="Input.SourceName" placeholder="Curador Japon 2026" />
                <span asp-validation-for="Input.SourceName"></span>
            </div>
            <div>
                <label asp-for="Input.SourceUrl">URL fuente <span class="muted">(opcional)</span></label>
                <input asp-for="Input.SourceUrl" placeholder="https://..." />
                <span asp-validation-for="Input.SourceUrl"></span>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Guardar</button>
            @if (Model.Input.Id.HasValue)
            {
                <a class="button secondary" asp-page="/Admin/Reservations" asp-route-selectedTripId="@Model.Input.TripId">Cancelar</a>
            }
        </div>
    </form>
</section>

<section id="reservations-list" class="panel" style="margin-top: 18px;">
    <h2>Agenda @(Model.SelectedTripId.HasValue ? "del viaje seleccionado" : "")</h2>
    <table>
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Naturaleza</th>
                <th>Elemento</th>
                <th>Ciudad</th>
                <th>Lugar</th>
                <th>Codigo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var reservation in Model.Reservations)
        {
            <tr>
                <td>
                    <strong>@reservation.Date.ToString("MMM d")</strong><br />
                    <span class="muted">@reservation.StartsAt.ToString("HH\\:mm")</span>
                    @if (!string.IsNullOrWhiteSpace(reservation.TimeZoneId))
                    {
                        <br />
                        <span class="mono">@reservation.TimeZoneId</span>
                    }
                </td>
                <td>@reservation.TypeLabel</td>
                <td><span class="badge">@reservation.PlanningKindLabel</span></td>
                <td>
                    <strong>@reservation.Title</strong><br />
                    <span class="muted">@reservation.TripName</span>
                    @if (!string.IsNullOrWhiteSpace(reservation.ExternalId))
                    {
                        <br />
                        <span class="mono">@reservation.ExternalId</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(reservation.SourceName))
                    {
                        <br />
                        <span class="muted">@reservation.SourceName</span>
                    }
                    @if (reservation.HasRecommendation)
                    {
                        <br />
                        <span class="badge">Recommendation</span>
                        <span class="muted">@reservation.RecommendationTitle</span>
                    }
                </td>
                <td>@reservation.City</td>
                <td>
                    @reservation.PlaceLabel<br />
                    <span class="muted">@reservation.Address</span>
                </td>
                <td>@reservation.ConfirmationCode</td>
                <td>
                    <div class="row-actions">
                        <a class="button secondary" asp-page="/Admin/Reservations" asp-route-editId="@reservation.Id">Editar</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@reservation.Id" asp-route-selectedTripId="@Model.SelectedTripId">
                            <button class="danger" type="submit">Borrar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>
