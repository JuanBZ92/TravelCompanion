@page "/admin/users"
@model TravelCompanion.Api.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<h1>Users & access</h1>
<p class="lede">Usuarios de la app y accesos activos por pago, paquete o suscripcion.</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="notice">
        <strong>@Model.StatusMessage</strong>
        <p style="margin: 6px 0 0;">Comparte esta password temporal solo por un canal seguro. El usuario debera cambiarla en el primer ingreso.</p>
    </section>
}

<section class="grid">
    <div class="panel">
        <div class="section-header">
            <div>
                <h2>@(Model.UserInput.Id.HasValue ? "Editar usuario" : "Nuevo usuario")</h2>
                <p class="muted">Al crear un usuario se genera una password temporal y se marca cambio obligatorio.</p>
            </div>
            <span class="badge">Password temporal</span>
        </div>
        <form method="post" asp-page-handler="SaveUser">
            <div asp-validation-summary="All"></div>
            <input type="hidden" asp-for="UserInput.Id" />
            <div class="form-grid">
                <div>
                    <label asp-for="UserInput.Email" class="required">Email</label>
                    <input asp-for="UserInput.Email" type="email" />
                    <span asp-validation-for="UserInput.Email"></span>
                </div>
                <div>
                    <label asp-for="UserInput.DisplayName" class="required">Nombre visible</label>
                    <input asp-for="UserInput.DisplayName" />
                    <span asp-validation-for="UserInput.DisplayName"></span>
                </div>
            </div>
            <div class="actions">
                <button type="submit">Guardar usuario</button>
                @if (Model.UserInput.Id.HasValue)
                {
                    <a class="button secondary" asp-page="/Admin/Users">Cancelar</a>
                }
            </div>
        </form>
    </div>

    <div class="panel">
        <div class="section-header">
            <div>
                <h2>Asignar acceso</h2>
                <p class="muted">Usa paquetes cuando el acceso pertenece a un producto vendible. Usa destino/tipo solo para excepciones puntuales.</p>
            </div>
        </div>
        @if (Model.UserOptions.Count == 0)
        {
            <p class="muted">Crea un usuario antes de asignar accesos.</p>
        }
        else
        {
            <form method="post" asp-page-handler="GrantEntitlement">
                <div asp-validation-summary="All"></div>
                <div class="form-grid">
                    <div>
                        <label asp-for="EntitlementInput.UserId" class="required">Usuario</label>
                        <select asp-for="EntitlementInput.UserId" asp-items="Model.UserOptions"></select>
                        <span asp-validation-for="EntitlementInput.UserId"></span>
                    </div>
                    <div>
                        <label asp-for="EntitlementInput.AccessLevel" class="required">Tipo de acceso</label>
                        <select asp-for="EntitlementInput.AccessLevel" asp-items="Model.AccessLevelOptions"></select>
                        <span asp-validation-for="EntitlementInput.AccessLevel"></span>
                    </div>
                    <div>
                        <label asp-for="EntitlementInput.DestinationId">Destino <span class="muted">(opcional)</span></label>
                        <select asp-for="EntitlementInput.DestinationId" asp-items="Model.DestinationOptions"></select>
                        <span asp-validation-for="EntitlementInput.DestinationId"></span>
                    </div>
                    <div>
                        <label asp-for="EntitlementInput.TravelPackageId">Paquete <span class="muted">(opcional)</span></label>
                        <select asp-for="EntitlementInput.TravelPackageId" asp-items="Model.PackageOptions"></select>
                        <p class="muted">Si eliges paquete, el tipo se ajusta automaticamente a paquete o suscripcion.</p>
                        <span asp-validation-for="EntitlementInput.TravelPackageId"></span>
                    </div>
                    <div>
                        <label asp-for="EntitlementInput.ExpiresOn">Expira <span class="muted">(opcional)</span></label>
                        <input asp-for="EntitlementInput.ExpiresOn" type="date" />
                        <span asp-validation-for="EntitlementInput.ExpiresOn"></span>
                    </div>
                    <div>
                        <label asp-for="EntitlementInput.Source">Origen <span class="muted">(opcional)</span></label>
                        <input asp-for="EntitlementInput.Source" />
                        <span asp-validation-for="EntitlementInput.Source"></span>
                    </div>
                </div>
                <div class="actions">
                    <button type="submit">Asignar acceso</button>
                </div>
            </form>
        }
    </div>
</section>

<section class="panel" style="margin-top: 18px;">
    <h2>Usuarios</h2>
    <table>
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Login</th>
                <th>Accesos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>
                    <strong>@user.DisplayName</strong><br />
                    <span class="muted">@user.Email</span>
                </td>
                <td>
                    @(user.MustChangePassword ? "Password temporal" : "Activo")
                    @if (user.MustChangePassword)
                    {
                        <br />
                        <span class="muted">Pendiente de cambio</span>
                    }
                </td>
                <td>
                    @user.ActiveEntitlementCount activo(s)<br />
                    <span class="muted">@user.EntitlementCount total(es)</span>
                </td>
                <td>
                    <div class="row-actions">
                        <a class="button secondary" asp-page="/Admin/Users" asp-route-editUserId="@user.Id">Editar</a>
                        <form method="post" asp-page-handler="ResetPassword" asp-route-id="@user.Id">
                            <button class="secondary" type="submit">Reset password</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteUser" asp-route-id="@user.Id">
                            <button class="danger" type="submit">Borrar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

<section class="panel" style="margin-top: 18px;">
    <h2>Accesos asignados</h2>
    <table>
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Acceso</th>
                <th>Scope</th>
                <th>Vigencia</th>
                <th>Origen</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var entitlement in Model.Entitlements)
        {
            <tr>
                <td>@entitlement.UserEmail</td>
                <td>
                    <strong>@entitlement.AccessLevelLabel</strong><br />
                    <span class="muted">@entitlement.Status</span>
                </td>
                <td>
                    @entitlement.DestinationName<br />
                    <span class="muted">@entitlement.PackageName</span>
                </td>
                <td>
                    Desde @entitlement.GrantedAt.ToLocalTime().ToString("yyyy-MM-dd")<br />
                    <span class="muted">Hasta @(entitlement.ExpiresAt.HasValue ? entitlement.ExpiresAt.Value.ToLocalTime().ToString("yyyy-MM-dd") : "sin vencimiento")</span>
                </td>
                <td>@entitlement.Source</td>
                <td>
                    <form method="post" asp-page-handler="DeleteEntitlement" asp-route-id="@entitlement.Id">
                        <button class="danger" type="submit">Quitar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>
