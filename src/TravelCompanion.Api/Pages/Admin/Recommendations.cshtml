@page "/admin/recommendations"
@model TravelCompanion.Api.Pages.Admin.RecommendationsModel
@{
    ViewData["Title"] = "Recommendations";
}

<div class="page-heading">
    <div>
        <h1>Recommendations</h1>
        <p class="lede">Lugares curados que aparecen en recomendaciones y mapa.</p>
    </div>
    <span class="eyebrow">Contenido</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="notice">
        <strong>@Model.StatusMessage</strong>
    </section>
}

<section class="panel">
    <div class="section-header">
        <div>
            <h2>@(Model.Input.Id.HasValue ? "Editar recomendacion" : "Nueva recomendacion")</h2>
            <p class="form-hint">Define si la recomendacion es gratis, exclusiva para suscripcion o parte de uno o mas paquetes.</p>
        </div>
    </div>
    <form method="post" asp-page-handler="Save">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="Input.Id" />
        <div class="form-grid">
            <div>
                <label asp-for="Input.ExternalId">External ID <span class="muted">(import)</span></label>
                <input asp-for="Input.ExternalId" placeholder="rec-tokyo-tsukiji-snack-walk" />
                <span asp-validation-for="Input.ExternalId"></span>
                <p class="form-hint">Usado por CSV/API para actualizar sin duplicar.</p>
            </div>
            <div>
                <label asp-for="Input.DestinationId" class="required">Destino</label>
                <select asp-for="Input.DestinationId" asp-items="Model.DestinationOptions"></select>
                <span asp-validation-for="Input.DestinationId"></span>
            </div>
            <div>
                <label asp-for="Input.Title" class="required">Titulo</label>
                <input asp-for="Input.Title" />
                <span asp-validation-for="Input.Title"></span>
            </div>
            <div>
                <label asp-for="Input.Category" class="required">Categoria</label>
                <input asp-for="Input.Category" />
                <span asp-validation-for="Input.Category"></span>
            </div>
            <div>
                <label asp-for="Input.Neighborhood">Barrio <span class="muted">(opcional)</span></label>
                <input asp-for="Input.Neighborhood" />
                <span asp-validation-for="Input.Neighborhood"></span>
            </div>
            <div>
                <label asp-for="Input.Latitude" class="required">Latitud</label>
                <input asp-for="Input.Latitude" type="number" step="0.000001" />
                <span asp-validation-for="Input.Latitude"></span>
            </div>
            <div>
                <label asp-for="Input.Longitude" class="required">Longitud</label>
                <input asp-for="Input.Longitude" type="number" step="0.000001" />
                <span asp-validation-for="Input.Longitude"></span>
            </div>
            <div>
                <label asp-for="Input.SuggestedDurationMinutes" class="required">Duracion min</label>
                <input asp-for="Input.SuggestedDurationMinutes" type="number" min="1" />
                <span asp-validation-for="Input.SuggestedDurationMinutes"></span>
            </div>
            <div>
                <label asp-for="Input.PriceLevel" class="required">Precio</label>
                <input asp-for="Input.PriceLevel" />
                <span asp-validation-for="Input.PriceLevel"></span>
                <p class="form-hint">Usa free, low, medium o high.</p>
            </div>
            <div>
                <label asp-for="Input.Rating">Rating <span class="muted">(opcional)</span></label>
                <input asp-for="Input.Rating" type="number" min="0" max="5" step="0.1" />
                <span asp-validation-for="Input.Rating"></span>
            </div>
            <div>
                <label asp-for="Input.OpeningHours">Horario <span class="muted">(opcional)</span></label>
                <input asp-for="Input.OpeningHours" placeholder="09:00-18:00" />
                <span asp-validation-for="Input.OpeningHours"></span>
                <p class="form-hint">Varias franjas: 09:00-12:00; 14:00-18:00.</p>
            </div>
            <div>
                <label asp-for="Input.AccessLevel" class="required">Acceso</label>
                <select asp-for="Input.AccessLevel" asp-items="Model.AccessLevelOptions" data-recommendation-access></select>
                <span asp-validation-for="Input.AccessLevel"></span>
                <p class="form-hint">Suscripcion desbloquea contenido exclusivo para suscriptores del destino.</p>
            </div>
            <div data-recommendation-package-field>
                <label asp-for="Input.PackageIds" class="required">Paquetes</label>
                <select asp-for="Input.PackageIds" asp-items="Model.PackageOptions" multiple size="5"></select>
                <span asp-validation-for="Input.PackageIds"></span>
                <p class="form-hint">Puedes seleccionar varios paquetes. Los suscriptores del destino tambien los desbloquean.</p>
            </div>
        </div>
        <div style="margin-top: 12px;">
            <label asp-for="Input.Description" class="required">Descripcion</label>
            <textarea asp-for="Input.Description"></textarea>
            <span asp-validation-for="Input.Description"></span>
        </div>
        <div style="margin-top: 12px;">
            <label asp-for="Input.TagsText">Tags <span class="muted">(opcional)</span></label>
            <input asp-for="Input.TagsText" placeholder="local food, vegetarian, shopping" />
            <span asp-validation-for="Input.TagsText"></span>
            <p class="form-hint">Se guardan normalizados contra el catalogo canonico que tambien usa el assistant.</p>
            <div class="tag-catalog">
                <div class="chip-list">
                    @foreach (var tag in Model.TagCatalog.Where(tag => !tag.IsCategory).Take(24))
                    {
                        <span class="chip subtle">@tag.Tag</span>
                    }
                </div>
                <details>
                    <summary>Ver categorias y aliases reconocidos</summary>
                    <div class="tag-catalog-grid">
                        @foreach (var tag in Model.TagCatalog)
                        {
                            <div class="tag-catalog-item">
                                <strong>@tag.Tag</strong>
                                <span class="muted">@(tag.IsCategory ? "categoria" : "tag") · @tag.RecommendationCount recomendaciones</span>
                                @if (tag.Aliases.Count > 0)
                                {
                                    <span class="mono">Aliases: @string.Join(", ", tag.Aliases)</span>
                                }
                            </div>
                        }
                    </div>
                </details>
            </div>
        </div>
        <div class="form-grid" style="margin-top: 12px;">
            <div>
                <label asp-for="Input.SourceName">Fuente <span class="muted">(opcional)</span></label>
                <input asp-for="Input.SourceName" placeholder="Curador Japon 2026" />
                <span asp-validation-for="Input.SourceName"></span>
            </div>
            <div>
                <label asp-for="Input.SourceUrl">URL fuente <span class="muted">(opcional)</span></label>
                <input asp-for="Input.SourceUrl" placeholder="https://..." />
                <span asp-validation-for="Input.SourceUrl"></span>
            </div>
        </div>
        <div style="margin-top: 12px;">
            <label asp-for="Input.CurationNotes">Notas de curaduria <span class="muted">(opcional)</span></label>
            <textarea asp-for="Input.CurationNotes"></textarea>
            <span asp-validation-for="Input.CurationNotes"></span>
        </div>
        <div class="actions">
            <button type="submit">Guardar</button>
            @if (Model.Input.Id.HasValue)
            {
                <a class="button secondary" asp-page="/Admin/Recommendations">Cancelar</a>
            }
        </div>
    </form>
</section>

<section class="panel" style="margin-top: 18px;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Titulo</th>
                    <th>Categoria</th>
                    <th>Paquetes</th>
                    <th>Barrio</th>
                    <th>Senales</th>
                    <th>Coordenadas</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var recommendation in Model.Recommendations)
            {
                <tr>
                    <td>
                        <strong>@recommendation.Title</strong><br />
                        <span class="muted">@recommendation.DestinationName</span>
                        @if (!string.IsNullOrWhiteSpace(recommendation.ExternalId))
                        {
                            <br />
                            <span class="mono">@recommendation.ExternalId</span>
                        }
                    </td>
                    <td><span class="badge">@recommendation.Category</span></td>
                    <td>
                        <div class="chip-list">
                            @if (recommendation.PackageNames.Count > 0)
                            {
                                foreach (var packageName in recommendation.PackageNames)
                                {
                                    <span class="chip">@packageName</span>
                                }
                            }
                            else
                            {
                                <span class="chip subtle">@recommendation.AccessSummary</span>
                            }
                        </div>
                    </td>
                    <td>@recommendation.Neighborhood</td>
                    <td>
                        <span class="mono">@recommendation.PriceLevel</span>
                        @if (recommendation.Rating.HasValue)
                        {
                            <br />
                            <span class="muted">@recommendation.Rating.Value.ToString("0.0") rating</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(recommendation.OpeningHours))
                        {
                            <br />
                            <span class="muted">@recommendation.OpeningHours</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(recommendation.SourceName))
                        {
                            <br />
                            <span class="muted">@recommendation.SourceName</span>
                        }
                        @if (recommendation.Tags.Count > 0)
                        {
                            <div class="chip-list table-chips">
                                @foreach (var tag in recommendation.Tags)
                                {
                                    <span class="chip subtle">@tag</span>
                                }
                            </div>
                        }
                    </td>
                    <td><span class="mono">@recommendation.Latitude, @recommendation.Longitude</span></td>
                    <td>
                        <div class="row-actions">
                            <a class="button secondary" asp-page="/Admin/Recommendations" asp-route-editId="@recommendation.Id">Editar</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@recommendation.Id">
                                <button class="danger" type="submit">Borrar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
