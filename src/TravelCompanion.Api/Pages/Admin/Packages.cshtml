@page "/admin/packages"
@model TravelCompanion.Api.Pages.Admin.PackagesModel
@{
    ViewData["Title"] = "Packages";
}

<h1>Packages</h1>
<p class="lede">Paquetes de pago fijo o suscripcion que habilitan contenido y pueden activarse para usuarios.</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="notice">
        <strong>@Model.StatusMessage</strong>
    </section>
}

<section class="panel">
    <div class="section-header">
        <div>
            <h2>@(Model.Input.Id.HasValue ? "Editar paquete" : "Nuevo paquete")</h2>
            <p class="muted">Crea paquetes reutilizables por destino. Luego asigna usuarios desde la seccion inferior.</p>
        </div>
        <span class="badge">Producto reusable</span>
    </div>
    <form method="post" asp-page-handler="Save">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="Input.Id" />
        <div class="form-grid">
            <div>
                <label asp-for="Input.DestinationId" class="required">Destino</label>
                <select asp-for="Input.DestinationId" asp-items="Model.DestinationOptions"></select>
                <span asp-validation-for="Input.DestinationId"></span>
            </div>
            <div>
                <label asp-for="Input.Name" class="required">Nombre</label>
                <input asp-for="Input.Name" />
                <span asp-validation-for="Input.Name"></span>
            </div>
            <div>
                <label asp-for="Input.Slug" class="required">Slug</label>
                <input asp-for="Input.Slug" />
                <p class="form-hint">Identificador estable, por ejemplo <code>japon-essentials</code>.</p>
                <span asp-validation-for="Input.Slug"></span>
            </div>
            <div>
                <label asp-for="Input.Price" class="required">Precio</label>
                <input asp-for="Input.Price" type="number" step="0.01" min="0" />
                <span asp-validation-for="Input.Price"></span>
            </div>
            <div>
                <label asp-for="Input.Currency" class="required">Moneda</label>
                <input asp-for="Input.Currency" maxlength="3" />
                <span asp-validation-for="Input.Currency"></span>
            </div>
            <div>
                <label asp-for="Input.IsSubscription" class="required">Tipo</label>
                <select asp-for="Input.IsSubscription">
                    <option value="false">Pago fijo</option>
                    <option value="true">Suscripcion</option>
                </select>
            </div>
        </div>
        <div style="margin-top: 12px;">
            <label asp-for="Input.Description">Descripcion <span class="muted">(opcional)</span></label>
            <textarea asp-for="Input.Description"></textarea>
            <span asp-validation-for="Input.Description"></span>
        </div>
        <div class="actions">
            <button type="submit">Guardar</button>
            @if (Model.Input.Id.HasValue)
            {
                <a class="button secondary" asp-page="/Admin/Packages">Cancelar</a>
            }
        </div>
    </form>
</section>

<section class="panel" style="margin-top: 18px;">
    <h2>Catalogo de paquetes</h2>
    <p class="muted">Crea un paquete una sola vez y asignale todos los usuarios que correspondan.</p>
    <table>
        <thead>
            <tr>
                <th>Paquete</th>
                <th>Destino</th>
                <th>Precio</th>
                <th>Tipo</th>
                <th>Accesos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var package in Model.Packages)
        {
            <tr>
                <td>
                    <strong>@package.Name</strong><br />
                    <span class="muted">@package.Slug</span>
                </td>
                <td>@package.DestinationName</td>
                <td>@package.Currency @package.Price.ToString("0.00")</td>
                <td>@(package.IsSubscription ? "Suscripcion" : "Pago fijo")</td>
                <td>@package.EntitlementCount usuario(s)</td>
                <td>
                    <div class="row-actions">
                        <a class="button secondary" asp-page="/Admin/Packages" asp-route-selectedPackageId="@package.Id">Usuarios</a>
                        <a class="button secondary" asp-page="/Admin/Packages" asp-route-editId="@package.Id">Editar</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@package.Id">
                            <button class="danger" type="submit">Borrar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

@if (Model.SelectedPackage is not null)
{
    <section id="package-users" class="panel" style="margin-top: 18px;">
        <div class="section-header">
            <div>
                <h2>Usuarios de @Model.SelectedPackage.Name</h2>
                <p class="muted">Este paquete puede tener muchos usuarios asignados. No hace falta crear un paquete por persona.</p>
            </div>
            <span class="badge">@Model.AssignedUsers.Count usuario(s)</span>
        </div>

        @if (Model.UserOptions.Count == 0)
        {
            <p class="muted">Crea usuarios antes de asignarlos a un paquete.</p>
        }
        else if (Model.AvailableUserOptions.Count == 0)
        {
            <p class="muted">Todos los usuarios disponibles ya tienen acceso activo a este paquete.</p>
        }
        else
        {
            <form method="post" asp-page-handler="GrantAccess" asp-route-packageId="@Model.SelectedPackage.Id" class="inline-form">
                <div>
                    <label for="package-user" class="required">Usuario</label>
                    <select id="package-user" name="userId" asp-items="Model.AvailableUserOptions"></select>
                </div>
                <div>
                    <label for="package-expires">Expira <span class="muted">(opcional)</span></label>
                    <input id="package-expires" name="expiresOn" type="date" />
                </div>
                <button type="submit">Asignar usuario</button>
            </form>
        }

        <div class="table-wrap" style="margin-top: 16px;">
            <table>
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Acceso</th>
                        <th>Vigencia</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.AssignedUsers)
                {
                    <tr>
                        <td>
                            <strong>@user.DisplayName</strong><br />
                            <span class="muted">@user.Email</span>
                        </td>
                        <td>
                            @user.AccessLevel<br />
                            <span class="muted">@user.Status</span>
                        </td>
                        <td>
                            Desde @user.GrantedAt.ToLocalTime().ToString("yyyy-MM-dd")<br />
                            <span class="muted">Hasta @(user.ExpiresAt.HasValue ? user.ExpiresAt.Value.ToLocalTime().ToString("yyyy-MM-dd") : "sin vencimiento")</span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="RevokeAccess" asp-route-entitlementId="@user.EntitlementId" asp-route-selectedPackageId="@Model.SelectedPackage.Id">
                                <button class="danger" type="submit">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
