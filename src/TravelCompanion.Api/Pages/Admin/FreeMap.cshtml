@page "/admin/free-map"
@model TravelCompanion.Api.Pages.Admin.FreeMapModel
@{
    ViewData["Title"] = "Free";
}

<div class="page-heading">
    <div>
        <h1>Free</h1>
        <p class="lede">Centros fijos y radios visibles para el acceso promocional con PIN 0000.</p>
    </div>
    <span class="eyebrow">Conversion</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="notice"><strong>@Model.StatusMessage</strong></section>
}

<section class="panel">
    <h2>@(Model.Input.Id.HasValue ? "Editar ciudad" : "Nueva ciudad")</h2>
    <form method="post" asp-page-handler="Save">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="Input.Id" />
        <div class="form-grid">
            <div>
                <label asp-for="Input.DestinationId" class="required">Destino</label>
                <select asp-for="Input.DestinationId" asp-items="Model.DestinationOptions"></select>
            </div>
            <div>
                <label asp-for="Input.CitySlug" class="required">City slug</label>
                <input asp-for="Input.CitySlug" placeholder="tokyo" />
                <span asp-validation-for="Input.CitySlug"></span>
            </div>
            <div>
                <label asp-for="Input.DisplayName" class="required">Nombre visible</label>
                <input asp-for="Input.DisplayName" placeholder="Tokyo" />
                <span asp-validation-for="Input.DisplayName"></span>
            </div>
            <div>
                <label asp-for="Input.SortOrder">Orden</label>
                <input asp-for="Input.SortOrder" type="number" />
            </div>
            <div>
                <label asp-for="Input.CenterLatitude" class="required">Latitud centro</label>
                <input asp-for="Input.CenterLatitude" type="number" step="0.000001" />
                <span asp-validation-for="Input.CenterLatitude"></span>
            </div>
            <div>
                <label asp-for="Input.CenterLongitude" class="required">Longitud centro</label>
                <input asp-for="Input.CenterLongitude" type="number" step="0.000001" />
                <span asp-validation-for="Input.CenterLongitude"></span>
            </div>
            <div>
                <label asp-for="Input.FreeRadiusKm" class="required">Radio gratuito (km)</label>
                <input asp-for="Input.FreeRadiusKm" type="number" min="0.25" max="10" step="0.25" />
                <span asp-validation-for="Input.FreeRadiusKm"></span>
            </div>
            <div>
                <label asp-for="Input.CoverageRadiusKm" class="required">Cobertura urbana (km)</label>
                <input asp-for="Input.CoverageRadiusKm" type="number" min="1" max="100" step="1" />
                <span asp-validation-for="Input.CoverageRadiusKm"></span>
            </div>
            <div>
                <label asp-for="Input.ContactUrl">URL solicitar acceso</label>
                <input asp-for="Input.ContactUrl" placeholder="https://wa.me/..." />
                <span asp-validation-for="Input.ContactUrl"></span>
            </div>
            <div>
                <label><input asp-for="Input.IsEnabled" style="width:auto" /> Visible</label>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Guardar</button>
            @if (Model.Input.Id.HasValue)
            {
                <a class="button secondary" asp-page="/Admin/FreeMap">Cancelar</a>
            }
        </div>
    </form>
</section>

<section class="panel" style="margin-top:18px">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Ciudad</th><th>Centro</th><th>Radios</th><th>Contenido</th><th></th></tr></thead>
            <tbody>
            @foreach (var city in Model.Cities)
            {
                <tr>
                    <td><strong>@city.DisplayName</strong><br /><span class="mono">@city.CitySlug</span><br /><span class="muted">@city.DestinationName</span></td>
                    <td class="mono">@city.CenterLatitude, @city.CenterLongitude</td>
                    <td>@city.FreeRadiusKm km free<br /><span class="muted">@city.CoverageRadiusKm km cobertura</span></td>
                    <td>@city.RecommendationCount recomendacion(es)<br /><span class="badge">@(city.IsEnabled ? "Visible" : "Oculta")</span></td>
                    <td><div class="row-actions">
                        <a class="button secondary" asp-page="/Admin/FreeMap" asp-route-editId="@city.Id">Editar</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@city.Id"><button type="submit" class="danger">Borrar</button></form>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
