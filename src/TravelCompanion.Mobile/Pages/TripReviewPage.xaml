<?xml version="1.0" encoding="utf-8" ?>
<pages:TripScopedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:pages="clr-namespace:TravelCompanion.Mobile.Pages"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.TripReviewPage"
             x:DataType="vm:TripReviewViewModel" Title="{Binding Title}"
             SafeAreaEdges="All" BackgroundColor="{StaticResource Mist}">
    <ContentPage.Resources>
        <Style x:Key="ReviewAction" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,12" RowSpacing="8">
        <Label Text="{Binding Coverage}" FontSize="12" TextColor="{StaticResource Muted}" LineHeight="1.15" Margin="0,0,0,8" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Days}" SelectionMode="None">
            <CollectionView.EmptyView><Label Text="{Binding EmptyText}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TripReviewDayViewModel">
                    <Border BackgroundColor="#FFFDF9" Stroke="#E6DFD6" StrokeShape="RoundRectangle 18" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                <Label Text="{Binding Date}" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
                                <ImageButton Grid.Column="1" Source="tab_trip.svg" Command="{Binding ViewDayCommand}" Style="{StaticResource ReviewAction}" SemanticProperties.Description="{Binding ViewDayText}" ToolTipProperties.Text="{Binding ViewDayText}" />
                                <ImageButton Grid.Column="2" Source="today_bulb.svg" Command="{Binding ImproveCommand}" IsVisible="{Binding CanImprove}" Style="{StaticResource ReviewAction}" SemanticProperties.Description="{Binding ImproveText}" ToolTipProperties.Text="{Binding ImproveText}" />
                            </Grid>
                            <Label Text="{Binding Title}" FontSize="20" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding Summary}" FontSize="14" TextColor="{StaticResource Muted}" LineHeight="1.15" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Issues}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TripReviewIssueViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,8,0,0">
                                            <Label Text="{Binding Message}" FontSize="14" LineHeight="1.15" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                            <ImageButton Grid.Column="1" Source="today_arrow_dark.svg" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" Style="{StaticResource ReviewAction}" SemanticProperties.Description="{Binding OpenText}" ToolTipProperties.Text="{Binding OpenText}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:TripScopedPage>
