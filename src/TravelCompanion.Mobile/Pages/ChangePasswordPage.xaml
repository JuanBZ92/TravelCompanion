<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ChangePasswordPage"
             x:DataType="viewModels:ChangePasswordViewModel"
             Title="Nueva password"
             Shell.NavBarIsVisible="False">
    <Grid Padding="24" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="20">
            <VerticalStackLayout Spacing="8">
                <Label Text="Cuenta" Style="{StaticResource Eyebrow}" />
                <Label Text="Crea tu password" Style="{StaticResource Headline}" />
                <Label Text="Por seguridad, reemplaza la password temporal antes de entrar a tu viaje." Style="{StaticResource SubHeadline}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nueva password" Style="{StaticResource Metadata}" />
                        <Entry Text="{Binding NewPassword}" IsPassword="True" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmar password" Style="{StaticResource Metadata}" />
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" />
                    </VerticalStackLayout>

                    <Border Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                            Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                            StrokeThickness="1"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
                    </Border>

                    <Button Text="Guardar password"
                            Command="{Binding ChangePasswordCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
