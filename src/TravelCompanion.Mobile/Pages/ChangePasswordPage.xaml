<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ChangePasswordPage"
             x:DataType="viewModels:ChangePasswordViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Mist}">
    <ScrollView x:Name="FormScroll">
        <VerticalStackLayout Padding="24,28" Spacing="20" MaximumWidthRequest="480">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding AccountLabel}"
                       CharacterSpacing="6"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D" />
                <Label Text="{Binding PasswordTitle}"
                       FontFamily="serif"
                       FontSize="34"
                       SemanticProperties.HeadingLevel="Level1"
                       TextColor="#1A1714" />
                <Label Text="{Binding PasswordDescription}"
                       FontSize="16"
                       LineHeight="1.45"
                       TextColor="#6E675F" />
            </VerticalStackLayout>

            <Border Style="{StaticResource EditorialCard}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding NewPasswordLabel}" Style="{StaticResource Metadata}" />
                        <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="{Binding NewPasswordLabel}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ConfirmPasswordLabel}" Style="{StaticResource Metadata}" />
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="{Binding ConfirmPasswordLabel}" />
                    </VerticalStackLayout>

                    <Border Padding="12"
                            BackgroundColor="{StaticResource AccentSoft}"
                            Stroke="{StaticResource Rose}"
                            StrokeThickness="1"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <Label x:Name="ValidationMessage" Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
                    </Border>

                    <Button Text="{Binding SavePasswordLabel}"
                            Command="{Binding ChangePasswordCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
