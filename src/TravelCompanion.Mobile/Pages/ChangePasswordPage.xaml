<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ChangePasswordPage"
             x:DataType="viewModels:ChangePasswordViewModel"
             Title="Nueva password"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">
    <Grid Padding="28" RowDefinitions="*,Auto,*" BackgroundColor="#F8F3ED">
        <VerticalStackLayout Grid.Row="1" Spacing="20">
            <VerticalStackLayout Spacing="10">
                <Label Text="CUENTA"
                       CharacterSpacing="6"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D" />
                <Label Text="Crea tu password"
                       FontFamily="serif"
                       FontSize="34"
                       TextColor="#1A1714" />
                <Label Text="Por seguridad, reemplaza la password temporal antes de entrar a tu viaje."
                       FontSize="16"
                       LineHeight="1.45"
                       TextColor="#6E675F" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nueva password" Style="{StaticResource Metadata}" />
                        <Entry Text="{Binding NewPassword}" IsPassword="True" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmar password" Style="{StaticResource Metadata}" />
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" />
                    </VerticalStackLayout>

                    <Border Padding="12"
                            BackgroundColor="#F6F1EA"
                            Stroke="{StaticResource Rose}"
                            StrokeThickness="1"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
                    </Border>

                    <Button Text="Guardar password"
                            Command="{Binding ChangePasswordCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
