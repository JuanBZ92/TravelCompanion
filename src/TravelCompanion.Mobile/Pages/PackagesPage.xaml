<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.PackagesPage"
             x:DataType="viewModels:PackagesViewModel"
             Title="Packs"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,0" RowDefinitions="Auto,*" RowSpacing="14">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Border Style="{StaticResource SoftPanel}" IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadPackagesCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Packages}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="0"
                                       SnapPointsType="None" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="Todavia no hay paquetes disponibles." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="28" Opacity="0" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="itemViewModels:PackageListItemViewModel">
                        <Grid HeightRequest="136"
                              RowDefinitions="*,1"
                              BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource Night}}">
                            <Grid Padding="0,14"
                                  ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource SectionTitle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Grid.Column="1"
                                       Text="{Binding Price}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}" />
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding PackageType}" Style="{StaticResource Metadata}" />
                                        <Label Text="{Binding RequiredAccess}" Style="{StaticResource Metadata}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding AccessStatus}"
                                           Style="{StaticResource Metadata}"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </Grid>
                            </Grid>
                            <BoxView Grid.Row="1"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
