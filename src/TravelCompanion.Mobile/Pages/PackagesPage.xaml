<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.PackagesPage"
             x:DataType="viewModels:PackagesViewModel"
             Title="Packs"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,0" RowDefinitions="Auto,*" RowSpacing="14">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Packs"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                    <Label Text="{Binding LastUpdatedMessage}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                           IsVisible="{Binding HasLastUpdated}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource NoticePanel}" IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Reintentar"
                            Command="{Binding LoadPackagesCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="12,8"
                            MinimumHeightRequest="34" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <Label Text="Todavia no hay paquetes disponibles."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding ShowEmptyState}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Packages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="itemViewModels:PackageListItemViewModel">
                            <Border HeightRequest="136"
                                    Padding="14"
                                    Margin="0,0,0,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource SectionTitle}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Price}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}" />
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           Margin="0,8,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8" Margin="0,9,0,0">
                                        <Label Text="{Binding PackageType}" Style="{StaticResource Metadata}" />
                                        <Label Text="{Binding RequiredAccess}" Style="{StaticResource Metadata}" />
                                        <Label Text="{Binding AccessStatus}"
                                               Style="{StaticResource Metadata}"
                                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <BoxView HeightRequest="28" Opacity="0" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowInitialLoading}">
            <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                               WidthRequest="28"
                               HeightRequest="28" />
            <Label Text="Cargando packs"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
