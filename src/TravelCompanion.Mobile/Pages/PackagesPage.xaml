<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.PackagesPage"
             x:DataType="viewModels:PackagesViewModel"
             Title="Packs"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,0" RowDefinitions="Auto,*" RowSpacing="14">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Border Style="{StaticResource SoftPanel}" IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadPackagesCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Packages}">
                <CollectionView.EmptyView>
                    <Label Text="Todavia no hay paquetes disponibles." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="itemViewModels:PackageListItemViewModel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Price}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="14" />
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                    <Label Text="{Binding PackageType}" Style="{StaticResource Metadata}" />
                                    <Label Text="{Binding RequiredAccess}" Style="{StaticResource Metadata}" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="3"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding AccessStatus}"
                                       Style="{StaticResource Metadata}"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
