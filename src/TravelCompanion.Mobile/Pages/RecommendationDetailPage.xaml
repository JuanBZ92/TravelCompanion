<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationDetailPage"
             x:DataType="viewModels:RecommendationDetailViewModel"
             Title="{Binding Recommendation.Title}">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="Recomendacion" Style="{StaticResource Eyebrow}" />
                <Label Text="{Binding Recommendation.Title}" Style="{StaticResource Headline}" />
                <Label Text="{Binding Recommendation.Neighborhood}" Style="{StaticResource SubHeadline}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="{Binding FavoriteButtonText}"
                        Command="{Binding ToggleFavoriteCommand}" />
                <Button Grid.Column="1"
                        Text="Abrir mapa"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenMapsCommand}"
                        IsEnabled="{Binding IsUnlocked}" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding Recommendation.Category}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="{Binding AccessLevelText}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding AccessStatus}" Style="{StaticResource Metadata}" />
                    <Label Text="{Binding Recommendation.Description}" FontSize="16" />
                    <Label Text="{Binding Recommendation.SuggestedDurationMinutes, StringFormat='Duracion sugerida: {0} min'}" Style="{StaticResource Metadata}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Ubicacion" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Recommendation.Latitude, StringFormat='Latitud: {0:F6}'}" FontSize="14" />
                    <Label Text="{Binding Recommendation.Longitude, StringFormat='Longitud: {0:F6}'}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
