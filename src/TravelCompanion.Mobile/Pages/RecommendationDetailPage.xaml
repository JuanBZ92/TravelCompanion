<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationDetailPage"
             x:DataType="viewModels:RecommendationDetailViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             Shell.BackgroundColor="#F8F3ED"
             BackgroundColor="#F8F3ED">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="0">
            <Border HeightRequest="300"
                    BackgroundColor="#F6F1EA"
                    Stroke="#D8CFC4"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid x:Name="MapContainer">
                    <VerticalStackLayout x:Name="MapFallback"
                                         Padding="28"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="{Binding Recommendation.Title}"
                               FontFamily="serif"
                               FontSize="24"
                               TextColor="#1A1714"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                        <Label Text="{Binding Recommendation.Neighborhood}"
                               FontSize="13"
                               TextColor="#8A8078"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                    </VerticalStackLayout>

                    <Button Text="&lt;"
                            Clicked="OnBackClicked"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            Margin="20,22,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            BackgroundColor="#F8F3ED"
                            TextColor="#1A1714"
                            BorderColor="#D8CFC4"
                            BorderWidth="1"
                            CornerRadius="0"
                            FontSize="20" />
                </Grid>
            </Border>

            <VerticalStackLayout Padding="28,28,28,40"
                                 Spacing="24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="LOCATION · YUKU JAPAN"
                           CharacterSpacing="6"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#9B9288" />
                    <Label Text="{Binding Recommendation.Title}"
                           FontFamily="serif"
                           FontSize="34"
                           TextColor="#1A1714"
                           LineBreakMode="WordWrap"
                           MaxLines="3" />
                    <Label Text="{Binding Recommendation.Neighborhood}"
                           FontSize="15"
                           TextColor="#8A8078"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="ABOUT THIS EXPERIENCE"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#9B9288" />
                    <Label Text="{Binding Recommendation.Description}"
                           FontSize="16"
                           LineHeight="1.45"
                           TextColor="#4D4741" />
                </VerticalStackLayout>

                <Button Text="View on Map"
                        Command="{Binding OpenMapsCommand}"
                        IsEnabled="{Binding IsUnlocked}"
                        BackgroundColor="#3D3329"
                        TextColor="#FFFFFF"
                        HeightRequest="54"
                        CornerRadius="0"
                        FontSize="16"
                        FontAttributes="Bold" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
