<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.MapPage"
             x:DataType="viewModels:MapViewModel"
             Title="Map"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">

    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <!-- Map Section -->
        <Grid Grid.Row="0">
            <Border x:Name="MapHost"
                    BackgroundColor="#F6F1EA"
                    Stroke="Transparent"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid x:Name="MapContainer">
                    <VerticalStackLayout x:Name="MapFallback"
                                         Padding="24"
                                         Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="Map View"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Interactive map available on mobile devices"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Status Messages Overlay -->
            <VerticalStackLayout Padding="24,24,24,0" Spacing="8" VerticalOptions="Start">
                <Border Style="{StaticResource NoticePanel}"
                        IsVisible="{Binding HasStatus}">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                </Border>

                <Border Style="{StaticResource ErrorPanel}"
                        IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Reintentar"
                                Command="{Binding LoadNearbyRecommendationsCommand}"
                                Style="{StaticResource GhostButton}"
                                FontSize="12"
                                Padding="12,8"
                                MinimumHeightRequest="34" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- Nearby Places List -->
        <Grid Grid.Row="1"
              Padding="18,10,18,0"
              HeightRequest="300"
              RowDefinitions="Auto,*"
              RowSpacing="6"
              IsVisible="{Binding ShowRecommendationBrowser}">
            <SearchBar x:Name="PlaceSearch" Grid.Row="0"
                       Placeholder="Buscar restaurante, café o lugar"
                       Text="{Binding SearchText}"
                       SearchButtonPressed="OnSearchSubmitted"
                       HeightRequest="38"
                       FontSize="13"
                       BackgroundColor="#F8F3ED"
                       CancelButtonColor="#8E867D" />

            <ScrollView x:Name="ResultsScroll"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24"
                                         IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding ShowEmptyState}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="No nearby places found"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Cambia de pagina o intenta nuevamente"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding VisibleNearbyRecommendations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:RecommendationDto">
                                <Border MinimumHeightRequest="66"
                                        Padding="6,8"
                                        Margin="0"
                                        BackgroundColor="Transparent"
                                        Stroke="Transparent"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecommendationTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,1"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding Title, Mode=OneTime}"
                                               FontSize="15"
                                               FontAttributes="None"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Row="1"
                                               Text="{Binding Neighborhood, Mode=OneTime}"
                                               FontSize="11"
                                               Margin="0,2,0,7"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Column="1"
                                               Text="{Binding DistanceKm, StringFormat='{0:F1} km', Mode=OneTime}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                               HorizontalTextAlignment="End" />
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Category, Mode=OneTime}"
                                               FontSize="10"
                                               Margin="0,2,0,7"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               HorizontalTextAlignment="End"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <BoxView Grid.Row="2"
                                                 Grid.ColumnSpan="2"
                                                 HeightRequest="1"
                                                 BackgroundColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                                 Opacity="0.55" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          HeightRequest="48"
                          Margin="0,4,0,12">
                        <Button Text="‹"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                Style="{StaticResource PagerButton}" />
                        <Label Grid.Column="1"
                               Text="{Binding PageSummary}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />
                        <Button Grid.Column="2"
                                Text="›"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                Style="{StaticResource PagerButton}" />
                    </Grid>
                    <BoxView HeightRequest="28" Opacity="0" />
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding ShowInitialLoading}">
                <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                                   WidthRequest="28"
                                   HeightRequest="28" />
                <Label Text="Cargando lugares cercanos"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Shared visual language for paid and premium recommendation previews. -->
        <Border Grid.Row="1"
                Margin="0"
                Style="{StaticResource MapPreviewPanel}"
                IsVisible="{Binding HasSelectedRecommendation}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="32">
                    <Label Text="{Binding SelectedRecommendationPosition}"
                           FontSize="11"
                           TextColor="{StaticResource Muted}"
                           VerticalTextAlignment="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding SelectedRecommendationType}"
                           CharacterSpacing="2"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Button Grid.Column="2"
                            Text="×"
                            Command="{Binding ClearRecommendationSelectionCommand}"
                            Style="{StaticResource MapPreviewNavigationButton}"
                            WidthRequest="32"
                            MinimumWidthRequest="32"
                            HeightRequest="32"
                            MinimumHeightRequest="32"
                            FontSize="16"
                            SemanticProperties.Description="Cerrar preview" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="5">
                        <Label Text="{Binding SelectedRecommendation.Title}"
                               FontFamily="serif"
                               FontSize="22"
                               TextColor="{StaticResource Ink}"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding SelectedRecommendationMeta}"
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource Muted}" />
                        <ActivityIndicator IsVisible="{Binding IsSelectedRecommendationLoading}"
                                           IsRunning="{Binding IsSelectedRecommendationLoading}"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           HorizontalOptions="Start"
                                           Margin="0,4" />
                        <Label Text="{Binding SelectedRecommendation.DisplayDescription}"
                               IsVisible="{Binding ShowSelectedRecommendationDescription}"
                               FontSize="13"
                               LineHeight="1.2"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource InkSoft}" />
                </VerticalStackLayout>

                <Grid Grid.Row="2" ColumnDefinitions="40,*,40" ColumnSpacing="8" HeightRequest="44">
                    <Button Text="‹"
                            Command="{Binding SelectPreviousRecommendationCommand}"
                            IsEnabled="{Binding CanBrowseSelectedRecommendations}"
                            Style="{StaticResource MapPreviewNavigationButton}"
                            SemanticProperties.Description="Lugar anterior" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                        <ImageButton Source="itinerary_add.svg"
                                     Command="{Binding AddToItineraryCommand}"
                                     CommandParameter="{Binding SelectedRecommendation}"
                                     IsVisible="{Binding CanAddToItinerary}"
                                     Style="{StaticResource MapPreviewIconButton}"
                                     SemanticProperties.Description="Agregar al itinerario" />
                        <ImageButton Source="tab_map.svg"
                                     Command="{Binding OpenInGoogleMapsCommand}"
                                     CommandParameter="{Binding SelectedRecommendation}"
                                     Style="{StaticResource MapPreviewIconButton}"
                                     SemanticProperties.Description="Abrir ubicación en Google Maps" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="2"
                            Text="›"
                            Command="{Binding SelectNextRecommendationCommand}"
                            IsEnabled="{Binding CanBrowseSelectedRecommendations}"
                            Style="{StaticResource MapPreviewNavigationButton}"
                            SemanticProperties.Description="Lugar siguiente" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
