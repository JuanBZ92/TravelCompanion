<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.MapPage"
             x:Name="PageRoot"
             x:DataType="viewModels:MapViewModel"
             Title="Map"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid RowDefinitions="280,*" RowSpacing="0">
        <!-- Map Section -->
        <Grid Grid.Row="0">
            <Border x:Name="MapHost"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource NightSurface}}"
                    Stroke="Transparent"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid x:Name="MapContainer">
                    <VerticalStackLayout x:Name="MapFallback"
                                         Padding="24"
                                         Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="Map View"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Interactive map available on mobile devices"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Status Messages Overlay -->
            <VerticalStackLayout Padding="24,24,24,0" Spacing="8" VerticalOptions="Start">
                <Border Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource NightSurfaceAlt}}"
                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                        StrokeThickness="1"
                        IsVisible="{Binding HasStatus}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                </Border>

                <Border Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                        Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                        StrokeThickness="1"
                        IsVisible="{Binding HasError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- Nearby Places List -->
        <Grid Grid.Row="1" Padding="24,24,24,0" RowDefinitions="Auto,Auto,*" RowSpacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="Near You"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"/>
                <Label Text="Places within walking distance"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="40,*,40,40,76" ColumnSpacing="8" HeightRequest="40">
                <Button Text="‹"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        FontSize="18"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        CornerRadius="18"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Label Grid.Column="1"
                       Text="{Binding PageSummary}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Button Grid.Column="2" 
                        Text="›"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        FontSize="18"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        CornerRadius="18"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Button Grid.Column="3"
                        Text="↻"
                        Command="{Binding LoadNearbyRecommendationsCommand}"
                        FontSize="16"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        CornerRadius="18"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Picker Grid.Column="4"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}"
                        FontSize="12"
                        HeightRequest="36"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            </Grid>

            <ScrollView Grid.Row="2"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24"
                                         IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding ShowEmptyState}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="No nearby places found"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Use refresh button to retry"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding NearbyRecommendations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:RecommendationDto">
                                <Border HeightRequest="104"
                                        Padding="14"
                                        Margin="0,0,0,10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenRecommendationCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="*,86">
                                        <Label Text="{Binding Title, Mode=OneTime}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Row="1"
                                               Text="{Binding Neighborhood, Mode=OneTime}"
                                               FontSize="13"
                                               Margin="0,6,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Column="1"
                                               Text="{Binding DistanceKm, StringFormat='{0:F1} km', Mode=OneTime}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}"
                                               HorizontalTextAlignment="End" />
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Category, Mode=OneTime}"
                                               FontSize="12"
                                               Margin="0,6,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               HorizontalTextAlignment="End"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="28" Opacity="0" />
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding ShowInitialLoading}">
                <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                                   WidthRequest="28"
                                   HeightRequest="28" />
                <Label Text="Cargando lugares cercanos"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
