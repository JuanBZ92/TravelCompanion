<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.MapPage"
             x:DataType="viewModels:MapViewModel"
             Title="Mapa">
    <Grid Padding="20" RowDefinitions="Auto,Auto,260,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Cerca de ti" FontSize="28" FontAttributes="Bold" />
            <Label Text="Recomendaciones curadas alrededor de tu punto de referencia." FontSize="15" TextColor="{AppThemeBinding Light=#58616A, Dark=#C7CDD3}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="#FFF4E5"
                Stroke="#F2C078"
                StrokeThickness="1"
                IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="#5F3D00" />
        </Border>

        <Border x:Name="MapHost"
                Grid.Row="2"
                Stroke="#D8DEE4"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#1E2329}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid x:Name="MapContainer">
                <VerticalStackLayout x:Name="MapFallback"
                                     Padding="20"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="Mapa disponible en Android, iOS y MacCatalyst." FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="En Windows usamos la lista cercana como fallback." FontSize="13" TextColor="{AppThemeBinding Light=#68727D, Dark=#BDC4CC}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <RefreshView Grid.Row="3"
                     Command="{Binding LoadNearbyRecommendationsCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding NearbyRecommendations}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenRecommendationCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedRecommendation}">
                <CollectionView.EmptyView>
                    <Label Text="Todavia no hay lugares cercanos." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:RecommendationDto">
                        <Grid Padding="0,0,0,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding Category}" FontSize="13" TextColor="{AppThemeBinding Light=#68727D, Dark=#BDC4CC}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding DistanceKm, StringFormat='{0} km'}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
