<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels" xmlns:services="clr-namespace:TravelCompanion.Mobile.Services" x:Class="TravelCompanion.Mobile.Pages.TripFolderPanel" x:DataType="vm:TripPreparationViewModel">
 <Grid RowDefinitions="Auto,*">
  <Border Style="{StaticResource ErrorPanel}" Margin="24,12,24,0" IsVisible="{Binding HasError}">
   <VerticalStackLayout Spacing="8">
    <Label x:Name="PreparationError" Text="{Binding ErrorMessage}" Style="{StaticResource EditorialBody}"/>
    <Button Text="{Binding [UxRetry], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding LoadPreparationCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource EditorialSecondaryButton}"/>
   </VerticalStackLayout>
  </Border>
 <ScrollView Grid.Row="1">
  <VerticalStackLayout Padding="24,16,24,28" Spacing="16">
   <Label Text="{Binding Title}" Style="{StaticResource EditorialHeading}"/>
   <Label Text="{Binding Destination}" Style="{StaticResource EditorialBody}"/>
   <Label Text="{Binding Summary}" Style="{StaticResource EditorialCaption}"/>
   <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource EditorialSuccess}"/>
   <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
   <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" IsEnabled="{Binding CanSave}" Spacing="10">
    <BindableLayout.ItemTemplate>
     <DataTemplate x:DataType="vm:PreparationRow">
      <Border Padding="10" Style="{StaticResource EditorialCard}">
       <Grid ColumnDefinitions="*,48,48" ColumnSpacing="2" MinimumHeightRequest="68">
        <Grid ColumnDefinitions="32,*" ColumnSpacing="10" Padding="4,6" InputTransparent="True">
         <Image Source="tab_docs.svg" WidthRequest="24" HeightRequest="24" AutomationProperties.IsInAccessibleTree="False">
          <Image.Triggers>
           <DataTrigger TargetType="Image" Binding="{Binding IsOrganized}" Value="False">
            <Setter Property="Source" Value="preparation_pending.svg"/>
           </DataTrigger>
          </Image.Triggers>
         </Image>
         <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
          <Label Text="{Binding Label}" FontSize="16" TextColor="{StaticResource Ink}"/>
          <Label Text="{Binding StateText}" Style="{StaticResource EditorialCaption}"/>
         </VerticalStackLayout>
        </Grid>
        <Button Command="{Binding ViewCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" Padding="0" MinimumHeightRequest="68" SemanticProperties.Description="{Binding ViewDescription}"/>
        <ImageButton Grid.Column="1" Source="journal_add.svg" Command="{Binding AttachCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" VerticalOptions="Center" SemanticProperties.Description="{Binding CardDescription}"/>
        <ImageButton Grid.Column="2" Source="itinerary_menu.svg" Command="{Binding MoreCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" VerticalOptions="Center" SemanticProperties.Description="{Binding MenuDescription}"/>
       </Grid>
      </Border>
     </DataTemplate>
    </BindableLayout.ItemTemplate>
   </VerticalStackLayout>
   <Button Text="{Binding DocumentsAction}" Command="{Binding DocumentsCommand}" Style="{StaticResource EditorialSecondaryButton}"/>
   <Label Text="{Binding LocalNotice}" Style="{StaticResource EditorialCaption}"/>
   <Label Text="{Binding ImportNotice}" IsVisible="{Binding HasImportNotice}" Style="{StaticResource EditorialCaption}"/>
   <BoxView HeightRequest="1" Color="{StaticResource EditorialLine}" Margin="0,8"/>
   <Button Text="{Binding OfflineAction}" Command="{Binding PrepareOfflineCommand}" Style="{StaticResource EditorialSecondaryButton}" BackgroundColor="{StaticResource AccentSoft}"/>
   <Label Text="{Binding OfflineStatus}" Style="{StaticResource EditorialCaption}"/>
   <Label Text="{Binding OfflineScope}" Style="{StaticResource EditorialCaption}"/>
   <Button Text="{Binding ReviewAction}" Command="{Binding ReviewCommand}" Style="{StaticResource EditorialSecondaryButton}"/>
  </VerticalStackLayout>
 </ScrollView>
 </Grid>
</ContentView>
