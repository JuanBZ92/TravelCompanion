<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels" x:Class="TravelCompanion.Mobile.Pages.TripFolderPanel" x:DataType="vm:TripPreparationViewModel">
 <ScrollView>
  <VerticalStackLayout Padding="24,16,24,28" Spacing="16">
   <Label Text="{Binding Title}" FontFamily="serif" FontSize="30" TextColor="#302920" SemanticProperties.HeadingLevel="Level1"/>
   <Label Text="{Binding Destination}" FontSize="15" TextColor="#765831"/>
   <Label Text="{Binding Summary}" FontSize="13" TextColor="#71675D"/>
   <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#9A493F"/>
   <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="#49634D"/>
   <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
   <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" IsEnabled="{Binding CanSave}" Spacing="10">
    <BindableLayout.ItemTemplate>
     <DataTemplate x:DataType="vm:PreparationRow">
      <Border Padding="10" BackgroundColor="#FFFCF8" Stroke="#E5DDD3" StrokeShape="RoundRectangle 14">
       <Grid ColumnDefinitions="*,48,48" ColumnSpacing="2" MinimumHeightRequest="68">
        <Grid ColumnDefinitions="32,*" ColumnSpacing="10" Padding="4,6" InputTransparent="True">
         <Image Source="tab_docs.svg" WidthRequest="24" HeightRequest="24" AutomationProperties.IsInAccessibleTree="False"/>
         <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
          <Label Text="{Binding Label}" FontSize="16" TextColor="#302920"/>
          <Label Text="{Binding StateText}" FontSize="12" TextColor="#71675D"/>
         </VerticalStackLayout>
        </Grid>
        <Button Command="{Binding ViewCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" Padding="0" MinimumHeightRequest="68" SemanticProperties.Description="{Binding ViewDescription}"/>
        <ImageButton Grid.Column="1" Source="journal_add.svg" Command="{Binding AttachCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" VerticalOptions="Center" SemanticProperties.Description="{Binding CardDescription}"/>
        <ImageButton Grid.Column="2" Source="itinerary_menu.svg" Command="{Binding MoreCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" VerticalOptions="Center" SemanticProperties.Description="{Binding MenuDescription}"/>
       </Grid>
      </Border>
     </DataTemplate>
    </BindableLayout.ItemTemplate>
   </VerticalStackLayout>
   <Button Text="{Binding DocumentsAction}" Command="{Binding DocumentsCommand}" BackgroundColor="Transparent" TextColor="#765831" MinimumHeightRequest="48"/>
   <Label Text="{Binding LocalNotice}" FontSize="12" TextColor="#71675D"/>
   <BoxView HeightRequest="1" Color="#E5DDD3" Margin="0,8"/>
   <Button Text="{Binding OfflineAction}" Command="{Binding PrepareOfflineCommand}" BackgroundColor="#F0E8DE" TextColor="#302920" CornerRadius="12" MinimumHeightRequest="48"/>
   <Label Text="{Binding OfflineStatus}" FontSize="12" TextColor="#71675D"/>
   <Label Text="{Binding OfflineScope}" FontSize="12" TextColor="#71675D"/>
   <Button Text="{Binding ReviewAction}" Command="{Binding ReviewCommand}" BackgroundColor="Transparent" TextColor="#765831" MinimumHeightRequest="48"/>
  </VerticalStackLayout>
 </ScrollView>
</ContentView>
