<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             x:Class="TravelCompanion.Mobile.Pages.JournalPage"
             x:DataType="vm:JournalViewModel" x:Name="JournalRoot"
             Title="Journal" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Mist}">
    <Grid Padding="24,20" RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <VerticalStackLayout Spacing="8">
            <Label Text="YUKU · JAPAN" CharacterSpacing="3" FontSize="10" TextColor="{StaticResource InkSoft}" />
            <Label Text="Journal" FontFamily="serif" FontSize="34" TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Introduction}" FontSize="14" TextColor="{StaticResource InkSoft}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource InkSoft}" />
        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="{Binding EmptyText}" Margin="0,24" TextColor="{StaticResource InkSoft}" FontSize="15" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:JournalEntry">
                        <VerticalStackLayout Padding="0,16" Spacing="10">
                            <Label Text="{Binding Context}" TextColor="{StaticResource InkSoft}" FontSize="12" />
                            <Label Text="{Binding Title}" TextColor="{StaticResource Ink}" FontFamily="serif" FontSize="23" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding Notes}" TextColor="{StaticResource InkSoft}" FontSize="15" LineHeight="1.25" />
                            <ImageButton Source="action_info.svg" HorizontalOptions="End" WidthRequest="44" HeightRequest="44"
                                         BackgroundColor="Transparent" Padding="12" SemanticProperties.Description="{Binding Title}"
                                         Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}" />
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
