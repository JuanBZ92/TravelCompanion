<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.JournalPage" x:DataType="vm:JournalViewModel" x:Name="JournalRoot"
             Title="Journal" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Mist}">
    <Grid Padding="24,20,24,0" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="TU DIARIO DE VIAJE" CharacterSpacing="3" FontSize="10" TextColor="{StaticResource InkSoft}" />
            <Grid ColumnDefinitions="*,48,48">
                <Label Text="Journal" FontFamily="serif" FontSize="36" TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level1" />
                <ImageButton Grid.Column="1" Source="journal_add.svg" Command="{Binding AddMemoryCommand}" IsVisible="{Binding CanAddMemory}" Padding="12"
                             BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" SemanticProperties.Description="Agregar recuerdo" />
                <ImageButton Grid.Column="2" Source="journal_export.svg" Command="{Binding ExportCommand}" IsVisible="{Binding CanExport}" Padding="12"
                             BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" SemanticProperties.Description="Crear álbum PDF" />
            </Grid>
            <Label Text="{Binding TripTitle}" FontSize="17" TextColor="{StaticResource Ink}" />
            <Label Text="{Binding Summary}" FontSize="13" TextColor="{StaticResource InkSoft}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource InkSoft}" />
        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:JournalDayGroup">
                        <Label Text="{Binding Title}" FontSize="12" TextColor="#8A6F49" Margin="0,20,0,6" SemanticProperties.HeadingLevel="Level2" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="16" Padding="0,36">
                        <Label Text="¿Qué querés recordar?" FontFamily="serif" FontSize="25" TextColor="{StaticResource Ink}" />
                        <Label Text="{Binding EmptyMessage}" TextColor="{StaticResource InkSoft}" FontSize="15" />
                        <Button Text="Mi primer recuerdo" Command="{Binding AddMemoryCommand}" IsVisible="{Binding CanAddMemory}" CornerRadius="20" />
                        <Button Text="Mis viajes" Command="{Binding OpenAccountCommand}" IsVisible="{Binding NeedsTrip}" CornerRadius="20" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:JournalRow">
                        <VerticalStackLayout Padding="0,14,0,20" Spacing="10">
                            <Grid ColumnDefinitions="*,48" ColumnSpacing="10">
                                <Label Text="{Binding Title}" TextColor="{StaticResource Ink}" FontFamily="serif" FontSize="25" SemanticProperties.HeadingLevel="Level2" />
                                <ImageButton Grid.Column="1" Source="action_edit.svg" WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent" Padding="12"
                                             SemanticProperties.Description="Abrir y editar recuerdo" Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding Notes}" TextColor="{StaticResource InkSoft}" FontSize="15" LineHeight="1.3" MaxLines="4" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PhotoCount}" FontSize="12" TextColor="{StaticResource InkSoft}" />
                            <FlexLayout Wrap="Wrap" Direction="Row" IsVisible="{Binding HasPhotos}" BindableLayout.ItemsSource="{Binding Photos}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:JournalThumbnail">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="68" HeightRequest="68" Margin="0,0,8,8">
                                            <ImageButton Source="{Binding Source}" Aspect="AspectFill" Padding="0" BackgroundColor="{StaticResource Line}"
                                                SemanticProperties.Description="{Binding Description}"
                                                Command="{Binding BindingContext.OpenPhotoCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                                <ImageButton Source="journal_photo.svg" WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"
                                    SemanticProperties.Description="Agregar fotos a este recuerdo" Command="{Binding BindingContext.AddPhotoCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}" />
                                <ImageButton Source="action_info.svg" WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent" IsVisible="{Binding HasActivity}"
                                    SemanticProperties.Description="Ver actividad" Command="{Binding BindingContext.OpenActivityCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="12" TextColor="#926E36" />
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" Margin="0,10,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
