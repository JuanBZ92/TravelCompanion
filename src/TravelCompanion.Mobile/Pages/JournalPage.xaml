<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels"
 x:Class="TravelCompanion.Mobile.Pages.JournalPage" x:DataType="vm:JournalViewModel" x:Name="JournalRoot"
 Title="{Binding Heading}" Shell.NavBarIsVisible="False" SafeAreaEdges="All" BackgroundColor="#F8F3ED">
 <Grid Padding="20,8,20,0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
  <VerticalStackLayout Spacing="4">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <Label Text="{Binding Heading}" FontFamily="serif" FontSize="31" TextColor="#302920" SemanticProperties.HeadingLevel="Level1" VerticalOptions="Center"/>
    <Button Grid.Column="1" Text="···" Command="{Binding MenuCommand}" SemanticProperties.Description="{Binding MenuAction}" MinimumHeightRequest="48" MinimumWidthRequest="48" BackgroundColor="Transparent" TextColor="#765831" FontSize="24"/>
   </Grid>
   <HorizontalStackLayout Spacing="8">
    <Label Text="{Binding TripTitle}" FontSize="15" TextColor="#765831" FontAttributes="Bold"/>
    <Label Text="·" FontSize="15" TextColor="#A89B8A"/>
    <Label Text="{Binding Summary}" FontSize="14" TextColor="#71675D" LineBreakMode="TailTruncation"/>
   </HorizontalStackLayout>
   <Grid IsVisible="{Binding HasTrip}" Margin="0,12,0,4" ColumnDefinitions="52,*" ColumnSpacing="12">
    <ImageButton Source="journal_add.svg" Command="{Binding AddMemoryCommand}" SemanticProperties.Description="{Binding WriteAction}" WidthRequest="52" HeightRequest="52" Padding="14" BackgroundColor="#F0E8DE" CornerRadius="14"/>
    <Label Grid.Column="1" Text="{Binding WriteAction}" FontFamily="serif" FontSize="20" TextColor="#302920" VerticalOptions="Center">
     <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding AddMemoryCommand}"/></Label.GestureRecognizers>
    </Label>
   </Grid>
   <Grid IsVisible="{Binding HasDrafts}" ColumnDefinitions="48,*" ColumnSpacing="12">
    <ImageButton Source="action_edit.svg" Command="{Binding ContinueDraftCommand}" SemanticProperties.Description="{Binding DraftAction}" WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"/>
    <Label Grid.Column="1" Text="{Binding DraftAction}" FontSize="14" TextColor="#765831" VerticalOptions="Center">
     <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ContinueDraftCommand}"/></Label.GestureRecognizers>
    </Label>
   </Grid>
  </VerticalStackLayout>
  <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#765831"/>
  <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
   <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
    <CollectionView.EmptyView>
     <Border Margin="0,24" Padding="26,32" BackgroundColor="#FFFCF8" Stroke="#E5DDD3" StrokeShape="RoundRectangle 14">
      <VerticalStackLayout Spacing="20">
       <Image Source="tab_journal.svg" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" AutomationProperties.IsInAccessibleTree="False"/>
       <Label Text="{Binding EmptyTitle}" FontFamily="serif" FontSize="28" TextColor="#302920" SemanticProperties.HeadingLevel="Level2"/>
       <BoxView HeightRequest="1" Color="#D6C5AE" HorizontalOptions="Start" WidthRequest="44"/>
       <Label Text="{Binding EmptyMessage}" FontSize="17" LineHeight="1.3" TextColor="#71675D"/>
       <Button Text="{Binding ChooseTripAction}" Command="{Binding OpenAccountCommand}" IsVisible="{Binding NeedsTrip}" MinimumHeightRequest="48" BackgroundColor="#302920" TextColor="White"/>
      </VerticalStackLayout>
     </Border>
    </CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="vm:JournalRow">
      <Border Margin="0,0,0,10" Padding="14" BackgroundColor="#FFFCF8" Stroke="#E5DDD3" StrokeShape="RoundRectangle 12">
       <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
       <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12" MinimumHeightRequest="92">
        <VerticalStackLayout Spacing="0" VerticalOptions="Start">
         <Label Text="{Binding Day}" FontFamily="serif" FontSize="27" TextColor="#765831" HorizontalTextAlignment="Center"/>
         <Label Text="{Binding Month}" FontSize="11" TextColor="#71675D" HorizontalTextAlignment="Center"/>
         <Label Text="{Binding Year}" FontSize="10" TextColor="#978A79" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <BoxView Grid.Column="0" WidthRequest="1" HorizontalOptions="End" Color="#E5DDD3"/>
        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
         <Label Text="{Binding Title}" FontFamily="serif" FontSize="20" TextColor="#302920" MaxLines="2" LineBreakMode="TailTruncation" SemanticProperties.HeadingLevel="Level2"/>
         <Label Text="{Binding Place}" IsVisible="{Binding HasPlace}" FontSize="12" TextColor="#765831" MaxLines="1" LineBreakMode="TailTruncation"/>
         <Label Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="13" TextColor="#71675D" MaxLines="2" LineBreakMode="TailTruncation"/>
         <Label Text="{Binding PhotoCount}" IsVisible="{Binding HasPhotos}" FontSize="11" TextColor="#765831"/>
         <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="11" TextColor="#9A693F"/>
        </VerticalStackLayout>
        <Image Grid.Column="2" Source="{Binding Cover.Source}" IsVisible="{Binding HasPhotos}" Aspect="AspectFill" WidthRequest="78" HeightRequest="78" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False"/>
        <Button Grid.Column="2" Text="›" IsVisible="{Binding HasNoPhotos}" SemanticProperties.Description="{Binding OpenDescription}" Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}" MinimumWidthRequest="48" MinimumHeightRequest="48" BackgroundColor="Transparent" TextColor="#765831" FontSize="30"/>
       </Grid>
      </Border>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </RefreshView>
 </Grid>
</ContentPage>
