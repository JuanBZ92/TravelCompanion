<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels"
 x:Class="TravelCompanion.Mobile.Pages.JournalPage" x:DataType="vm:JournalViewModel" x:Name="JournalRoot"
 Title="{Binding Heading}" Shell.NavBarIsVisible="False" SafeAreaEdges="All" BackgroundColor="#F8F3ED">
 <Grid Padding="22,12,22,0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
  <VerticalStackLayout Spacing="5">
   <Grid ColumnDefinitions="*,Auto">
    <Label Text="{Binding Heading}" FontFamily="serif" FontSize="32" TextColor="#302920" SemanticProperties.HeadingLevel="Level1"/>
    <Button Grid.Column="1" Text="···" Command="{Binding MenuCommand}" SemanticProperties.Description="{Binding MenuAction}" MinimumHeightRequest="48" MinimumWidthRequest="48" BackgroundColor="Transparent" TextColor="#302920" FontSize="24"/>
   </Grid>
   <Label Text="{Binding TripTitle}" FontSize="16" TextColor="#71675D"/>
   <Label Text="{Binding Summary}" FontSize="13" TextColor="#71675D"/>
   <Button Text="{Binding WriteAction}" Command="{Binding AddMemoryCommand}" IsVisible="{Binding HasTrip}" Margin="0,10,0,0" MinimumHeightRequest="52" BackgroundColor="#302920" TextColor="#FFFCF8" CornerRadius="8"/>
   <Button Text="{Binding DraftAction}" Command="{Binding ContinueDraftCommand}" IsVisible="{Binding HasDrafts}" MinimumHeightRequest="48" BackgroundColor="Transparent" TextColor="#765831"/>
  </VerticalStackLayout>
  <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#71675D"/>
  <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
   <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
    <CollectionView.GroupHeaderTemplate>
     <DataTemplate x:DataType="vm:JournalDayGroup">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,24,0,12">
       <Label Text="{Binding Day}" FontFamily="serif" FontSize="38" TextColor="#765831" VerticalOptions="Center"/>
       <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
        <Label Text="{Binding Month}" FontSize="14" TextColor="#302920" SemanticProperties.HeadingLevel="Level2"/>
        <Label Text="{Binding Cities}" FontSize="12" TextColor="#71675D"/>
       </VerticalStackLayout>
      </Grid>
     </DataTemplate>
    </CollectionView.GroupHeaderTemplate>
    <CollectionView.EmptyView>
     <Border Margin="0,24" Padding="26,32" BackgroundColor="#FFFCF8" Stroke="#E5DDD3" StrokeShape="RoundRectangle 4">
      <VerticalStackLayout Spacing="20">
       <Image Source="tab_journal.svg" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" AutomationProperties.IsInAccessibleTree="False"/>
       <Label Text="{Binding EmptyTitle}" FontFamily="serif" FontSize="28" TextColor="#302920" SemanticProperties.HeadingLevel="Level2"/>
       <BoxView HeightRequest="1" Color="#D6C5AE" HorizontalOptions="Start" WidthRequest="44"/>
       <Label Text="{Binding EmptyMessage}" FontSize="17" LineHeight="1.3" TextColor="#71675D"/>
       <Button Text="{Binding ChooseTripAction}" Command="{Binding OpenAccountCommand}" IsVisible="{Binding NeedsTrip}" MinimumHeightRequest="48" BackgroundColor="#302920" TextColor="White"/>
      </VerticalStackLayout>
     </Border>
    </CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="vm:JournalRow">
      <Border Margin="0,0,0,16" Padding="18" BackgroundColor="#FFFCF8" Stroke="#E5DDD3" StrokeShape="RoundRectangle 4">
       <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
       <VerticalStackLayout Spacing="12">
        <Label Text="{Binding Place}" IsVisible="{Binding HasPlace}" FontSize="12" TextColor="#765831"/>
        <Label Text="{Binding Title}" FontFamily="serif" FontSize="26" TextColor="#302920" SemanticProperties.HeadingLevel="Level2"/>
        <Image Source="{Binding Cover.Source}" IsVisible="{Binding HasPhotos}" Aspect="AspectFill" HeightRequest="210" AutomationProperties.IsInAccessibleTree="False"/>
        <Label Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="16" TextColor="#51483E" LineHeight="1.35" MaxLines="5" LineBreakMode="TailTruncation"/>
        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ExtraPhotos}">
         <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:JournalThumbnail">
           <ImageButton Source="{Binding Source}" WidthRequest="72" HeightRequest="72" Aspect="AspectFill" Padding="0" SemanticProperties.Description="{Binding Description}" Command="{Binding BindingContext.OpenPhotoCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}"/>
          </DataTemplate>
         </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
        <Label Text="{Binding PhotoCount}" IsVisible="{Binding HasPhotos}" FontSize="12" TextColor="#71675D"/>
        <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="12" TextColor="#765831"/>
        <Button Text="{Binding ReadAction}" SemanticProperties.Description="{Binding OpenDescription}" MinimumHeightRequest="48" BackgroundColor="Transparent" TextColor="#765831" Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference JournalRoot}}" CommandParameter="{Binding .}"/>
       </VerticalStackLayout>
      </Border>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </RefreshView>
 </Grid>
</ContentPage>
