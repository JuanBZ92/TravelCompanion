<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             x:Class="TravelCompanion.Mobile.Pages.PaywallPage"
             x:DataType="viewModels:PaywallViewModel"
             BackgroundColor="#F8F3ED" SafeAreaEdges="All"
             Title="{Binding [PaywallPageTitle], Source={x:Static services:LocalizationResourceManager.Instance}}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,24" Spacing="24">
                <Border Padding="24" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#292B25" Offset="0" />
                            <GradientStop Color="#534737" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="YUKU · JAPAN PASS" TextColor="#DDC39A" FontSize="11" CharacterSpacing="3" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="日本" FontFamily="serif" FontSize="30" TextColor="#BDA988" AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                        <Label Text="{Binding [PaywallHeroTitle], Source={x:Static services:LocalizationResourceManager.Instance}}" FontFamily="serif" FontSize="32" TextColor="#FFF8ED" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding [PaywallHeroBody], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="15" TextColor="#E6DDCF" LineHeight="1.3" />
                        <Label Text="{Binding [PaywallPaymentNote], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="#DDC39A" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding [PaywallIncluded], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="11" CharacterSpacing="2" TextColor="#82735D" SemanticProperties.HeadingLevel="Level2" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Benefits}" Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Padding="16" BackgroundColor="{StaticResource Paper}" Stroke="{StaticResource AccentSoft}">
                                <Label Text="{Binding .}" FontSize="16" TextColor="{StaticResource Primary}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border Padding="18" Stroke="#E3D9CC" BackgroundColor="#FFFDF8" StrokeShape="RoundRectangle 16" IsVisible="{Binding HasOffer}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding [PaywallYourTrip], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="10" CharacterSpacing="2" TextColor="#82735D" />
                        <Label Text="{Binding OfferLeadText}" FontSize="16" FontAttributes="Bold" TextColor="#393229" />
                        <Label Text="{Binding PreviewText}" FontSize="15" TextColor="#393229" />
                        <Label Text="{Binding AccessDetailsText}" IsVisible="{Binding HasAccessDetails}" FontSize="12" TextColor="#696156" />
                        <Label Text="{Binding RetentionText}" IsVisible="{Binding HasRetention}" FontSize="12" TextColor="#696156" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#A77E45" />
                    <Label Text="{Binding StateText}" IsVisible="{Binding HasState}" FontSize="13" TextColor="#696156" HorizontalTextAlignment="Center" />
                    <Border Padding="14" Stroke="#D8C6AF" BackgroundColor="#F1E9DD" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="#6F4D2C" />
                    </Border>
                    <Button Text="{Binding [PaywallRetryOffer], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding LoadOfferCommand}" IsVisible="{Binding ShowRetry}" Style="{StaticResource GhostButton}" CornerRadius="12" />
                </VerticalStackLayout>
                <Button Text="{Binding [PaywallSetup], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding ConfigureTripCommand}" IsVisible="{Binding NeedsTripSetup}" IsEnabled="{Binding IsNotBusy}" CornerRadius="12" />
                <Button Text="{Binding [PaywallRestore], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource GhostButton}" CornerRadius="12" />
                <Button Text="{Binding [PaywallSupportCode], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding RedeemCodeCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="Transparent" TextColor="#756B5F" FontSize="13" MinimumHeightRequest="44" />
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="1" Padding="20,14" BackgroundColor="#FFFDF8" Stroke="#E5DCCF" StrokeThickness="1">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding DisplayPrice}" IsVisible="{Binding HasPrice}" FontSize="28" FontAttributes="Bold" TextColor="#29251F" HorizontalTextAlignment="Center" />
                <Label Text="{Binding [PaywallPricePending], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="#756B5F" HorizontalTextAlignment="Center">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding HasPrice}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></Label.Triggers>
                </Label>
                <Button Text="{Binding [PaywallBuy], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding BuyCommand}" IsEnabled="{Binding CanBuy}" BackgroundColor="#A67B42" TextColor="White" FontSize="17" FontAttributes="Bold" CornerRadius="16" MinimumHeightRequest="54">
                    <Button.Triggers><Trigger TargetType="Button" Property="IsEnabled" Value="False"><Setter Property="BackgroundColor" Value="#E3D9CC" /><Setter Property="TextColor" Value="#756B5F" /></Trigger></Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
