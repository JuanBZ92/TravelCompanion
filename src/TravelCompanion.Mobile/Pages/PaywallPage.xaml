<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             x:Class="TravelCompanion.Mobile.Pages.PaywallPage"
             x:DataType="viewModels:PaywallViewModel"
             BackgroundColor="#F8F3ED" SafeAreaEdges="All"
             Title="{Binding [PaywallPageTitle], Source={x:Static services:LocalizationResourceManager.Instance}}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,12,20,24" Spacing="18">
                <Border Padding="20" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#292B25" Offset="0" />
                            <GradientStop Color="#534737" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="YUKU · JAPAN PASS" TextColor="#DDC39A" FontSize="11" CharacterSpacing="3" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="日本" FontFamily="serif" FontSize="30" TextColor="#BDA988" AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                        <Label Text="{Binding [PaywallHeroTitle], Source={x:Static services:LocalizationResourceManager.Instance}}" FontFamily="serif" FontSize="28" TextColor="#FFF8ED" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding [PaywallHeroBody], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="14" TextColor="#E6DDCF" LineHeight="1.15" />
                        <Label Text="{Binding [PaywallPaymentNote], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="#DDC39A" />
                    </VerticalStackLayout>
                </Border>
                <Border IsVisible="{Binding HasOffer}" Padding="18" Stroke="#E5DCCF"
                        BackgroundColor="#FFFDF8" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{Binding [PaywallIncluded], Source={x:Static services:LocalizationResourceManager.Instance}}"
                               FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="#82735D"
                               SemanticProperties.HeadingLevel="Level2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Benefits}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                        <Border WidthRequest="24" HeightRequest="24" VerticalOptions="Start"
                                                BackgroundColor="#EEE6D9" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                            <Label Text="✓" FontSize="14" TextColor="#80623C"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding .}" FontSize="14" TextColor="#393229"
                                               LineHeight="1.15" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="18" Stroke="#E3D9CC" BackgroundColor="#FFFDF8" StrokeShape="RoundRectangle 16" IsVisible="{Binding HasOffer}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding [PaywallYourTrip], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="10" CharacterSpacing="2" TextColor="#82735D" />
                        <Label Text="{Binding PreviewText}" FontSize="14" TextColor="#393229" />
                        <Label Text="{Binding AccessDetailsText}" IsVisible="{Binding HasAccessDetails}" FontSize="12" TextColor="#696156" />
                        <Label Text="{Binding RetentionText}" IsVisible="{Binding HasRetention}" FontSize="12" TextColor="#696156" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#A77E45" />
                    <Label Text="{Binding StateText}" IsVisible="{Binding HasState}" FontSize="13" TextColor="#696156" HorizontalTextAlignment="Center" />
                    <Border Padding="14" Stroke="#D8C6AF" BackgroundColor="#F1E9DD" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="#6F4D2C" />
                    </Border>
                </VerticalStackLayout>
                <Button Text="{Binding [PaywallSetup], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding ConfigureTripCommand}" IsVisible="{Binding NeedsTripSetup}" IsEnabled="{Binding IsNotBusy}" CornerRadius="12" />
                <Button Text="{Binding [PaywallRestore], Source={x:Static services:LocalizationResourceManager.Instance}}"
                        Command="{Binding RestoreCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent" TextColor="#756B5F" FontSize="12" Padding="4,8" MinimumHeightRequest="44" />
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="1" IsVisible="{Binding HasOffer}" Padding="20,10" BackgroundColor="#FFFDF8" Stroke="#E5DCCF" StrokeThickness="1">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding DisplayPrice}" IsVisible="{Binding HasPrice}" FontSize="24" FontAttributes="Bold" TextColor="#29251F" HorizontalTextAlignment="Center" />
                <Label Text="{Binding [PaywallPricePending], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="#756B5F" HorizontalTextAlignment="Center">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding HasPrice}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></Label.Triggers>
                </Label>
                <Button Text="{Binding [PaywallBuy], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding BuyCommand}" IsEnabled="{Binding CanBuy}" BackgroundColor="#A67B42" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="14" MinimumHeightRequest="48">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
