<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="{StaticResource Mist}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             x:Class="TravelCompanion.Mobile.Pages.PaywallPage"
             x:DataType="viewModels:PaywallViewModel"
             Title="{Binding [PaywallPageTitle], Source={x:Static services:LocalizationResourceManager.Instance}}">
    <ScrollView><VerticalStackLayout Padding="24" Spacing="18">
        <Label Text="{Binding [PaywallEyebrow], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Eyebrow}" />
        <Label Text="{Binding [PaywallHeadline], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Headline}" />
        <Label Text="{Binding PreviewText}" Style="{StaticResource SubHeadline}" />
        <Border Style="{StaticResource Card}"><VerticalStackLayout BindableLayout.ItemsSource="{Binding Benefits}" Spacing="10">
            <BindableLayout.ItemTemplate><DataTemplate><Label Text="{Binding ., StringFormat='✓ {0}'}" Style="{StaticResource Body}" /></DataTemplate></BindableLayout.ItemTemplate>
        </VerticalStackLayout></Border>
        <Label Text="{Binding RetentionText}" Style="{StaticResource Metadata}" />
        <Label Text="{Binding AccessDetailsText}" Style="{StaticResource Metadata}" />
        <Label Text="{Binding DisplayPrice}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
        <Button Text="{Binding [PaywallBuy], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding BuyCommand}" IsEnabled="{Binding CanBuy}" />
        <Button Text="{Binding [PaywallRestore], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding RestoreCommand}" Style="{StaticResource GhostButton}" />
        <Button Text="{Binding [PaywallSupportCode], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding RedeemCodeCommand}" Style="{StaticResource GhostButton}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Text="{Binding StateText}" Style="{StaticResource Metadata}" HorizontalTextAlignment="Center" />
        <Border Style="{StaticResource ErrorPanel}" IsVisible="{Binding HasError}"><Label Text="{Binding ErrorMessage}" /></Border>
    </VerticalStackLayout></ScrollView>
</ContentPage>
