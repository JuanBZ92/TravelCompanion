<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             x:Class="TravelCompanion.Mobile.Pages.ItineraryItemEditorPage"
             x:DataType="viewModels:ItineraryItemEditorViewModel"
             Title="Agregar al itinerario"
             BackgroundColor="#F8F3ED">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20">
                <Label Text="AGREGAR AL ITINERARIO" CharacterSpacing="3" FontSize="11" TextColor="#8E867D" />
                <Label Text="{Binding HeaderTitle}" FontFamily="serif" FontSize="32" TextColor="#1A1714" />
                <Label Text="{Binding Subtitle}" FontSize="14" TextColor="#6E675F" />
                <Entry Placeholder="Nombre del plan" Text="{Binding TitleText}" />
                <VerticalStackLayout Spacing="8">
                    <Entry x:Name="PlaceEntry"
                           Placeholder="Lugar (opcional)"
                           Text="{Binding LocationName}"
                           TextChanged="OnPlaceTextChanged"
                           SemanticProperties.Hint="Escribe un lugar para ver sugerencias" />
                    <Label Text="Buscamos primero en el catálogo y ampliamos los resultados automáticamente cuando es necesario."
                           IsVisible="{Binding CanSearchPlaces}"
                           FontSize="12"
                           TextColor="#6E675F" />
                    <VerticalStackLayout Spacing="0"
                                         IsVisible="{Binding CanSearchPlaces}"
                                         BindableLayout.ItemsSource="{Binding PlaceSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:PlaceSuggestionDto">
                                <Border Padding="12,10"
                                        BackgroundColor="#FFFDF9"
                                        Stroke="#D8CFC4"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlaceSuggestionTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#1A1714"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding Address}"
                                               FontSize="12"
                                               TextColor="#6E675F"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Label Text="{Binding Provider}"
                                               FontSize="10"
                                               TextColor="#8E867D" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding PlaceSearchMessage}"
                           IsVisible="{Binding HasPlaceSearchMessage}"
                           FontSize="12"
                           TextColor="#6E675F" />
                </VerticalStackLayout>
                <Entry Placeholder="Dirección (opcional)" Text="{Binding Address}" />
                <VerticalStackLayout Spacing="6"><Label Text="DÍA" Style="{StaticResource Eyebrow}"/><DatePicker Date="{Binding Date}" MinimumDate="{Binding MinimumDate}" MaximumDate="{Binding MaximumDate}" /></VerticalStackLayout>
                <VerticalStackLayout Spacing="6"><Label Text="MOMENTO" Style="{StaticResource Eyebrow}"/><Picker ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" /></VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" Padding="0,6"><Label Text="Definir hora exacta" VerticalOptions="Center"/><Switch Grid.Column="1" IsToggled="{Binding UseExactTime}" /></Grid>
                <TimePicker Time="{Binding Time}" IsVisible="{Binding UseExactTime}" />
                <Label Text="{Binding [ItemExactTimeHint], Source={x:Static services:LocalizationResourceManager.Instance}}" IsVisible="{Binding UseExactTime}" FontSize="12" TextColor="#6E675F" />
                <VerticalStackLayout Spacing="6"><Label Text="{Binding [ItemDurationLabel], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Eyebrow}"/><Entry Text="{Binding DurationMinutes}" Keyboard="Numeric" /></VerticalStackLayout>
                <VerticalStackLayout Spacing="6"><Label Text="{Binding [ItemFlexibilityLabel], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Eyebrow}"/><Picker ItemsSource="{Binding FlexibilityOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedFlexibility}" /></VerticalStackLayout>
                <Label Text="{Binding [ItemFlexibilityHint], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="#6E675F" />
                <Editor Placeholder="Notas personales (opcional)" Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="100" />
                <Border IsVisible="{Binding HasError}" Style="{StaticResource ErrorPanel}"><Label Text="{Binding ErrorMessage}" /></Border>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" Padding="20,12" ColumnDefinitions="*,*" ColumnSpacing="12" BackgroundColor="#FFFDF9">
            <Button Text="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" />
            <Button Grid.Column="1" Text="Agregar" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
        </Grid>
    </Grid>
</ContentPage>
