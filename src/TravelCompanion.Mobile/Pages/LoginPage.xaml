<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Ingresar"
             Shell.NavBarIsVisible="False">
    <Grid Padding="28" RowDefinitions="*,Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource Night}}">
        <VerticalStackLayout Grid.Row="1" Spacing="24">
            <VerticalStackLayout Spacing="10">
                <Label Text="YUKU"
                       Style="{StaticResource Eyebrow}"
                       CharacterSpacing="6" />
                <Label Text="Ingresa tu PIN"
                       FontSize="34"
                       FontFamily="OpenSansRegular"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Label Text="Usa el codigo de 4 numeros de tu viaje para cargar agenda, vuelos, documentos y recomendaciones."
                       Style="{StaticResource SubHeadline}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18">
                    <Entry Text="{Binding Pin}"
                           Keyboard="Numeric"
                           MaxLength="4"
                           IsPassword="True"
                           ReturnType="Go"
                           HorizontalTextAlignment="Center"
                           FontSize="32"
                           CharacterSpacing="12"
                           Placeholder="0000"
                           ClearButtonVisibility="WhileEditing" />

                    <Border Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                            Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                            StrokeThickness="1"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
                    </Border>

                    <Button Text="Abrir viaje"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Desbloquear con biometria"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding UnlockWithBiometricsCommand}"
                            IsVisible="{Binding CanUseBiometricUnlock}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
