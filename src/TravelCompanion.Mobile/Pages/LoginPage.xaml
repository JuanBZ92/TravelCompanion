<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Ingresar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">
    <Grid Padding="28" RowDefinitions="*,Auto,*"
          BackgroundColor="#F8F3ED">
        <VerticalStackLayout Grid.Row="1" Spacing="24">
            <VerticalStackLayout Spacing="10">
                <Label Text="YUKU JAPAN"
                       CharacterSpacing="6"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D" />
                <Label Text="Ingresa tu PIN"
                       FontSize="34"
                       FontFamily="serif"
                       TextColor="#1A1714" />
                <Label Text="Usa el codigo de 4 numeros de tu viaje para cargar agenda, vuelos, documentos y recomendaciones."
                       FontSize="16"
                       LineHeight="1.45"
                       TextColor="#6E675F" />
                <Label Text="Explora el mapa curado gratis con el PIN 0000."
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#8A6F3D" />
            </VerticalStackLayout>

            <Border BackgroundColor="#F6F1EA"
                    Stroke="#D8CFC4"
                    StrokeThickness="1"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18">
                    <Entry Text="{Binding Pin}"
                           Keyboard="Numeric"
                           MaxLength="4"
                           IsPassword="True"
                           ReturnType="Go"
                           HorizontalTextAlignment="Center"
                           FontSize="32"
                           CharacterSpacing="12"
                           Placeholder="0000"
                           ClearButtonVisibility="WhileEditing" />

                    <Border Padding="12"
                            BackgroundColor="#F6F1EA"
                            Stroke="{StaticResource Rose}"
                            StrokeThickness="1"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
                    </Border>

                    <Button Text="Abrir viaje"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            CornerRadius="0" />
                    <Button Text="Desbloquear con biometria"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding UnlockWithBiometricsCommand}"
                            IsVisible="{Binding CanUseBiometricUnlock}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
