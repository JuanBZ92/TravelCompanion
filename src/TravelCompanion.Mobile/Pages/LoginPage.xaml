<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="{Binding PageTitle}" Shell.NavBarIsVisible="False"
             SafeAreaEdges="All" BackgroundColor="{StaticResource Mist}">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="28,36,28,28" Spacing="28" MaximumWidthRequest="480" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <Label Text="YUKU · JAPAN" CharacterSpacing="4" FontSize="10" TextColor="#867B6D" VerticalOptions="Center" />
                    <Label Text="日本" FontFamily="serif" FontSize="22" TextColor="#B3A38C" AutomationProperties.IsInAccessibleTree="False" />
                </Grid>
                <BoxView WidthRequest="32" HeightRequest="2" BackgroundColor="#B3976D" HorizontalOptions="Start" />
                <Label Text="{Binding LoginTitle}" FontSize="36" FontFamily="serif"
                       SemanticProperties.HeadingLevel="Level1" TextColor="#25231E" LineHeight="1.05" />
                <Label Text="{Binding LoginDescription}" FontSize="15" LineHeight="1.2" TextColor="#82796F" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Button Text="{Binding CreateTripText}" Command="{Binding CreateTripCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#34382F" TextColor="#FFFDF8" CornerRadius="16" FontSize="16"
                        FontAttributes="Bold" MinimumHeightRequest="54" Padding="20,14" />
                <Label Text="{Binding LoginFreePreview}" FontSize="11" TextColor="#8C7A5C" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="14">
                <BoxView HeightRequest="1" BackgroundColor="#E2DBD0" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding LoginExistingTrip}" FontSize="12" TextColor="#8B8277" />
                <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#E2DBD0" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="14">
                <Border Padding="16,8" BackgroundColor="#FFFDF8" Stroke="#DDD4C7" StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding Pin}" Keyboard="Numeric" MaxLength="6" IsPassword="True"
                               ReturnType="Go" ReturnCommand="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}"
                               FontSize="22" CharacterSpacing="5" Placeholder="PIN" BackgroundColor="Transparent"
                               TextColor="#34382F" PlaceholderColor="#B5AA99" MinimumHeightRequest="44"
                               SemanticProperties.Description="{Binding LoginPinHint}" />
                        <Label Grid.Column="1" Text="{Binding LoginPinHint}" FontSize="11" TextColor="#9A8F80" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Button Text="{Binding LoginOpenTrip}" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#EAE3D8" TextColor="#51483B" CornerRadius="14" MinimumHeightRequest="50"
                        FontSize="15" Padding="18,12" />
                <Border Padding="14" BackgroundColor="#F5EAE5" StrokeThickness="0" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#975749" FontSize="13" />
                </Border>
                <Button Text="{Binding LoginBiometric}" Command="{Binding UnlockWithBiometricsCommand}"
                        IsVisible="{Binding CanUseBiometricUnlock}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent" TextColor="#73654F" CornerRadius="12" MinimumHeightRequest="44" FontSize="13" />
                <Button Text="{Binding LoginRecoverEmail}" Command="{Binding RecoverWithEmailCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent" TextColor="#73654F" CornerRadius="12" MinimumHeightRequest="44" FontSize="13" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#8C7A5C" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
