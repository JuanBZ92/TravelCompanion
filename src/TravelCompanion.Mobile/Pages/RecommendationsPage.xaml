<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationsPage"
             x:Name="PageRoot"
             x:DataType="viewModels:RecommendationsViewModel"
             Title="Curated for You"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
        <!-- Header -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Curated for You"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            <Label Text="Handpicked experiences"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            <Label Text="{Binding LastUpdatedMessage}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                   IsVisible="{Binding HasLastUpdated}" />
        </VerticalStackLayout>

        <!-- Filters and paging -->
        <Grid Grid.Row="1" ColumnDefinitions="*,120" ColumnSpacing="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="Categoria"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                <Picker ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="Por pagina"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                <Picker ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Status/Error Messages -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Reintentar"
                            Command="{Binding LoadRecommendationsCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="12,8"
                            MinimumHeightRequest="34" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Recommendations List -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HeightRequest="40">
                <Button Text="‹ "
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Style="{StaticResource PagerButton}" />
                <Label Grid.Column="1"
                       Text="{Binding PageSummary}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text=" ›"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource PagerButton}" />
            </Grid>

            <ScrollView Grid.Row="1"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24"
                                         IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding ShowEmptyState}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="No recommendations available"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Cambia el filtro o intenta nuevamente"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding VisibleRecommendations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="itemViewModels:RecommendationListItemViewModel">
                                <Border HeightRequest="162"
                                        Padding="14"
                                        Margin="0,0,0,10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecommendationTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,40">
                                        <Label Text="{Binding Category, Mode=OneTime}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextTransform="Uppercase"
                                               TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Column="1"
                                               Grid.RowSpan="2"
                                               Text="{Binding FavoriteGlyph}"
                                               FontSize="21"
                                               TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource Gold}}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Start"
                                               WidthRequest="40"
                                               HeightRequest="40">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavoriteTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Row="1"
                                               Text="{Binding Title, Mode=OneTime}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               Margin="0,5,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description, Mode=OneTime}"
                                               FontSize="13"
                                               Margin="0,5,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <FlexLayout Grid.Row="3"
                                                    Grid.ColumnSpan="2"
                                                    Direction="Row"
                                                    Wrap="Wrap"
                                                    AlignItems="Start"
                                                    Margin="0,7,0,0"
                                                    IsVisible="{Binding HasVisibleTags}"
                                                    BindableLayout.ItemsSource="{Binding VisibleTags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="system:String">
                                                    <Border Style="{StaticResource Chip}"
                                                            Padding="8,5"
                                                            Margin="0,0,6,4">
                                                        <Label Text="{Binding ., StringFormat='#{0}'}"
                                                               FontSize="11"
                                                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                                               MaxLines="1"
                                                               LineBreakMode="TailTruncation" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                        <Label Grid.Row="4"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Neighborhood, Mode=OneTime}"
                                               FontSize="12"
                                               Margin="0,5,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="28" Opacity="0" />
                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="1"
                    Padding="14,10"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding IsPaging}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsPaging}"
                                       WidthRequest="16"
                                       HeightRequest="16" />
                    <Label Text="Cargando pagina"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding ShowInitialLoading}">
                <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                                   WidthRequest="28"
                                   HeightRequest="28" />
                <Label Text="Cargando recomendaciones"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
