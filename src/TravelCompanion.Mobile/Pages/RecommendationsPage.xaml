<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationsPage"
             x:Name="PageRoot"
             x:DataType="viewModels:RecommendationsViewModel"
             Title="Ideas"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Border HeightRequest="158"
                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid>
                <Image Source="japan_hero.svg" Aspect="AspectFill" />
                <VerticalStackLayout Padding="16" Spacing="4" VerticalOptions="End">
                    <Label Text="Japon" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="Ideas curadas para comer, caminar y explorar." FontSize="13" TextColor="{StaticResource InkSoft}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SoftPanel}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Categoria" Style="{StaticResource Metadata}" />
                    <Picker Title="Categoria"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="Curado"
                       Style="{StaticResource Eyebrow}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource SoftPanel}" IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="3"
                     Command="{Binding LoadRecommendationsCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Recommendations}"
                            ItemSizingStrategy="MeasureFirstItem"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay recomendaciones para este filtro." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="itemViewModels:RecommendationListItemViewModel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" HeightRequest="176">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenRecommendationCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,40" RowDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" RowSpacing="5">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                        Text="{Binding FavoriteGlyph}"
                                        SemanticProperties.Description="{Binding FavoriteLabel}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource NightSurfaceAlt}}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        FontSize="20"
                                        HeightRequest="40"
                                        WidthRequest="40">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Row="1" Text="{Binding Neighborhood}" Style="{StaticResource Metadata}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="10">
                                    <Label Text="{Binding Category}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                                    <Label Text="{Binding AccessLevel}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}" />
                                    <Label Text="{Binding AccessStatus}" Style="{StaticResource Metadata}" />
                                    <Label Text="{Binding SuggestedDurationMinutes, StringFormat='{0} min'}" Style="{StaticResource Metadata}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
