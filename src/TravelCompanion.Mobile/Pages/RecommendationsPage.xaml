<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationsPage"
             x:Name="PageRoot"
             x:DataType="viewModels:RecommendationsViewModel"
             Title="Discover"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="20,12,20,0"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="14">

        <Border HeightRequest="176"
                Padding="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource NightSurface}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid>
                <Image Source="japan_hero.png"
                       Aspect="AspectFill"
                       Opacity="0.92" />
                <BoxView BackgroundColor="#66000000" />
                <Grid Padding="18"
                      RowDefinitions="*,Auto,Auto,Auto"
                      RowSpacing="4">
                    <Label Grid.Row="1"
                           Text="Japon curado"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Paper}"
                           LineBreakMode="TailTruncation" />
                    <Label Grid.Row="2"
                           Text="Ideas seleccionadas para viajar con calma, criterio y buen gusto."
                           FontSize="13"
                           TextColor="{StaticResource Paper}"
                           Opacity="0.9"
                           MaxLines="2" />
                    <Label Grid.Row="3"
                           Text="{Binding LastUpdatedMessage}"
                           FontSize="11"
                           TextColor="{StaticResource Paper}"
                           Opacity="0.75"
                           IsVisible="{Binding HasLastUpdated}" />
                </Grid>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10">
            <CollectionView ItemsSource="{Binding CategoryFilters}"
                            SelectionMode="None"
                            HeightRequest="38"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CategoryFilterViewModel">
                        <Border Padding="14,7"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1"
                                HeightRequest="34">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryFilterTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{Binding TextColor}"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Guia editorial"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                    <Label Text="{Binding PageSummary}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                </VerticalStackLayout>

                <Picker Grid.Column="1"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}"
                        FontSize="12"
                        WidthRequest="78"
                        HorizontalTextAlignment="End"
                        TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Reintentar"
                            Command="{Binding LoadRecommendationsCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="12,8"
                            MinimumHeightRequest="34" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  HeightRequest="38">
                <Button Text="Anterior"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Style="{StaticResource PagerButton}" />
                <BoxView Grid.Column="1"
                         HeightRequest="1"
                         VerticalOptions="Center"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}" />
                <Button Grid.Column="2"
                        Text="Siguiente"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource PagerButton}" />
            </Grid>

            <ScrollView Grid.Row="1"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24"
                                         IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding ShowEmptyState}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="No hay recomendaciones disponibles"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Cambia el filtro o intenta nuevamente"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding VisibleRecommendations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="itemViewModels:RecommendationListItemViewModel">
                                <Border HeightRequest="148"
                                        Padding="0"
                                        Margin="0,0,0,12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecommendationTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid Padding="14"
                                          RowDefinitions="Auto,Auto,*,Auto"
                                          ColumnDefinitions="*,44">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Category, Mode=OneTime}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextTransform="Uppercase"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding AccessStatus}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="1"
                                               Grid.RowSpan="2"
                                               Text="{Binding FavoriteGlyph}"
                                               FontSize="21"
                                               TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource Gold}}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Start"
                                               WidthRequest="44"
                                               HeightRequest="44">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavoriteTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Label Grid.Row="1"
                                               Text="{Binding Title, Mode=OneTime}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               Margin="0,6,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description, Mode=OneTime}"
                                               FontSize="13"
                                               Margin="0,6,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Grid Grid.Row="3"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Neighborhood, Mode=OneTime}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding SuggestedDurationMinutes, StringFormat='{0} min', Mode=OneTime}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="28" Opacity="0" />
                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="1"
                    Padding="14,10"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding IsPaging}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsPaging}"
                                       WidthRequest="16"
                                       HeightRequest="16" />
                    <Label Text="Cargando pagina"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding ShowInitialLoading}">
                <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                                   WidthRequest="28"
                                   HeightRequest="28" />
                <Label Text="Cargando recomendaciones"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
