<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationsPage"
             x:Name="PageRoot"
             x:DataType="viewModels:RecommendationsViewModel"
             Title="Curated for You"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,*" RowSpacing="24">
        <!-- Header -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Curated for You"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            <Label Text="Handpicked experiences"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>

        <!-- Status/Error Messages -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <!-- Recommendations List -->
        <RefreshView Grid.Row="2"
                     Command="{Binding LoadRecommendationsCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Recommendations}"
                            ItemSizingStrategy="MeasureAllItems"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="8"
                                       Padding="24">
                        <Label Text="No recommendations available"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Pull to refresh"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="itemViewModels:RecommendationListItemViewModel">
                        <Border Margin="0,0,0,12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenRecommendationCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="200,Auto">
                                <!-- Image Placeholder -->
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource NightSurfaceAlt}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12,12,0,0" />
                                    </Border.StrokeShape>
                                    <Label Text="📸"
                                           FontSize="48"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Opacity="0.3" />
                                </Border>

                                <!-- Content -->
                                <Grid Grid.Row="1"
                                      Padding="16"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Row="2" Spacing="8">
                                        <Label Text="{Binding Category}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        <Label Text="•"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        <Label Text="{Binding Neighborhood}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
