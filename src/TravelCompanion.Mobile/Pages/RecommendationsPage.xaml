<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationsPage"
             x:DataType="viewModels:RecommendationsViewModel"
             Title="Recomendaciones">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Japon" FontSize="28" FontAttributes="Bold" />
            <Label Text="Planes curados para comer, caminar y explorar." FontSize="15" TextColor="{AppThemeBinding Light=#58616A, Dark=#C7CDD3}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="#FFF4E5"
                Stroke="#F2C078"
                StrokeThickness="1"
                IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="#5F3D00" />
        </Border>

        <RefreshView Grid.Row="2"
                     Command="{Binding LoadRecommendationsCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Recommendations}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenRecommendationCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedRecommendation}">
                <CollectionView.EmptyView>
                    <Label Text="Todavia no hay recomendaciones." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:RecommendationDto">
                        <Border Stroke="#D8DEE4" StrokeThickness="1" Padding="14" Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Neighborhood}" FontSize="13" TextColor="{AppThemeBinding Light=#68727D, Dark=#BDC4CC}" />
                                <Label Text="{Binding Description}" FontSize="14" />
                                <Label Text="{Binding SuggestedDurationMinutes, StringFormat='{0} min'}" FontSize="12" TextColor="{AppThemeBinding Light=#68727D, Dark=#BDC4CC}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
