<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:itemViewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.RecommendationsPage"
             x:Name="PageRoot"
             x:DataType="viewModels:RecommendationsViewModel"
             Title="Curated for You"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
        <!-- Header -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Curated for You"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            <Label Text="Handpicked experiences"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>

        <!-- Filters and paging -->
        <Grid Grid.Row="1" ColumnDefinitions="*,120" ColumnSpacing="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="Categoria"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                <Picker ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="Por pagina"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                <Picker ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Status/Error Messages -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <!-- Recommendations List -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="40,*,40" ColumnSpacing="8" HeightRequest="40">
                <Button Text="‹"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        FontSize="18"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        CornerRadius="18"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Label Grid.Column="1"
                       Text="{Binding PageSummary}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="›"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        FontSize="18"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        CornerRadius="18"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            </Grid>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadRecommendationsCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Recommendations}"
                            ItemSizingStrategy="MeasureAllItems"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenRecommendationCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedRecommendation}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="0"
                                       SnapPointsType="None" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24">
                        <Label Text="No recommendations available"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Pull to refresh"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="28" Opacity="0" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="itemViewModels:RecommendationListItemViewModel">
                        <SwipeView>
                            <Grid HeightRequest="136"
                                  RowDefinitions="*,1"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">
                                <Grid Padding="0,14,0,10"
                                      RowDefinitions="Auto,4,Auto,10,Auto"
                                      ColumnDefinitions="*,44"
                                      ColumnSpacing="12">
                                    <!-- Title -->
                                    <Label Grid.Row="0"
                                           Text="{Binding Title, Mode=OneTime}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <!-- Description -->
                                    <Label Grid.Row="2"
                                           Text="{Binding Description, Mode=OneTime}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <!-- Metadata -->
                                    <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,*">
                                        <Label Text="{Binding Category, Mode=OneTime}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        <Label Grid.Column="1"
                                               Text=" • "
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding Neighborhood, Mode=OneTime}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>

                                    <!-- Favorite Button -->
                                    <Button Grid.Column="1"
                                            Grid.RowSpan="5"
                                            Text="{Binding FavoriteGlyph}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="20"
                                            Padding="0"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Start"
                                            TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource Gold}}" />
                                </Grid>
                                <BoxView Grid.Row="1"
                                         HeightRequest="1"
                                         Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
