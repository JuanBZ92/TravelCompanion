<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="{StaticResource Mist}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             x:Class="TravelCompanion.Mobile.Pages.AccountPage" x:Name="AccountPageRoot"
             x:DataType="viewModels:AccountViewModel" Title="{Binding PageTitle}" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="AccountPanel" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFDF9" />
            <Setter Property="Stroke" Value="#E6DFD6" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="AccountSection" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="2" />
            <Setter Property="TextColor" Value="{StaticResource InkSoft}" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="AccountAction" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </ContentPage.Resources>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadAccountCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,32" Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="YUKU · JAPAN" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding [TabAccount], Source={x:Static services:LocalizationResourceManager.Instance}}"
                           FontFamily="serif" FontSize="36" TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding [AccountIntro], Source={x:Static services:LocalizationResourceManager.Instance}}"
                           Style="{StaticResource EditorialBody}" TextColor="{StaticResource InkSoft}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource AccountPanel}">
                    <Grid ColumnDefinitions="32,*,48" ColumnSpacing="12">
                        <Image Source="tab_account.svg" WidthRequest="26" HeightRequest="26" VerticalOptions="Start" Margin="0,6,0,0" AutomationProperties.IsInAccessibleTree="False" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding Email}" Style="{StaticResource EditorialBody}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding [AccountVerified], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                   IsVisible="{Binding EmailVerified}" FontSize="12" TextColor="#8A6F49" />
                            <Label Text="{Binding [AccountVerifyEmail], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                   FontSize="12" TextColor="{StaticResource InkSoft}" />
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="2" Source="action_edit.svg" Command="{Binding VerifyEmailCommand}" BackgroundColor="Transparent"
                                     WidthRequest="48" HeightRequest="48" Padding="13" VerticalOptions="Center"
                                     SemanticProperties.Description="{Binding [AccountVerifyEmail], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                    </Grid>
                </Border>

                <Label Text="{Binding [AccountTripsTitle], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource AccountSection}" />
                <Label Text="{Binding [AccountNoTrips], Source={x:Static services:LocalizationResourceManager.Instance}}"
                       IsVisible="{Binding HasNoTrips}" FontSize="14" TextColor="{StaticResource InkSoft}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Trips}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AccountTripItem">
                            <Border Style="{StaticResource AccountPanel}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding [AccountCurrentTrip], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                           IsVisible="{Binding IsCurrent}" FontSize="11" TextColor="#8A6F49" CharacterSpacing="1" />
                                    <Label Text="{Binding Name}" FontFamily="serif" FontSize="24" TextColor="{StaticResource Ink}" />
                                    <Label Text="{Binding DateRange}" FontSize="13" TextColor="{StaticResource InkSoft}" />
                                    <Label Text="{Binding AccessLabel}" FontSize="13" TextColor="#8A6F49" />
                                    <Label Text="{Binding ExpiryLabel}" IsVisible="{Binding HasExpiry}" FontSize="12" TextColor="{StaticResource InkSoft}" />
                                    <BoxView HeightRequest="1" Color="#E6DFD6" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Button Text="{Binding [AccountOpenTrip], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                                HorizontalOptions="Start" Style="{StaticResource AccountAction}"
                                                Command="{Binding Source={x:Reference AccountPageRoot}, Path=BindingContext.SelectTripCommand}" CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="{Binding [AccountArchive], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                                IsVisible="{Binding CanArchive}" Style="{StaticResource AccountAction}" TextColor="{StaticResource InkSoft}"
                                                Command="{Binding Source={x:Reference AccountPageRoot}, Path=BindingContext.ArchiveTripCommand}" CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource AccountPanel}" Padding="8">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="40,*" Padding="8,0">
                            <Image Source="tab_docs.svg" WidthRequest="22" HeightRequest="22" AutomationProperties.IsInAccessibleTree="False" />
                            <Button Grid.Column="1" Text="{Binding [TabDocs], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                    Clicked="OnDocumentsClicked" Style="{StaticResource AccountAction}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#E6DFD6" Margin="16,4" />
                        <Grid ColumnDefinitions="40,*" Padding="8,0">
                            <Image Source="tab_pass.svg" WidthRequest="22" HeightRequest="22" AutomationProperties.IsInAccessibleTree="False" />
                            <Button Grid.Column="1" Text="{Binding [AccountPass], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                    Clicked="OnPassClicked" Style="{StaticResource AccountAction}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding [AccountPreferences], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource AccountSection}" />
                <Border Style="{StaticResource EditorialCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [AccountUnlockTitle], Source={x:Static services:LocalizationResourceManager.Instance}}"
                               Style="{StaticResource EditorialEyebrow}" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding UnlockMethodLabel}" Style="{StaticResource EditorialBody}" FontAttributes="Bold" />
                        <Label Text="{Binding UnlockMethodDescription}" Style="{StaticResource EditorialCaption}" />
                        <Button Text="{Binding [AccountUnlockChoose], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                Command="{Binding ChooseUnlockMethodCommand}" IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource EditorialSecondaryButton}" MinimumHeightRequest="48" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource AccountPanel}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding [AccountAnalyticsTitle], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                   Style="{StaticResource EditorialBody}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding BehaviorAnalyticsEnabled}" OnColor="#B49468"
                                    SemanticProperties.Description="{Binding [AccountAnalyticsTitle], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        </Grid>
                        <Label Text="{Binding [AccountAnalyticsDescription], Source={x:Static services:LocalizationResourceManager.Instance}}"
                               FontSize="12" TextColor="{StaticResource InkSoft}" LineHeight="1.2" />
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" Style="{StaticResource EditorialCaption}" />
                <Button Text="{Binding [DiagnosticsShare], Source={x:Static services:LocalizationResourceManager.Instance}}"
                        Clicked="OnDiagnosticsClicked" Style="{StaticResource AccountAction}" />
                <Border Style="{StaticResource ErrorPanel}" IsVisible="{Binding HasError}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ErrorMessage}" />
                        <Button Text="{Binding [UxRetry], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding LoadAccountCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource AccountAction}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="{Binding [AccountSignOut], Source={x:Static services:LocalizationResourceManager.Instance}}" Clicked="OnLogoutClicked" Style="{StaticResource AccountAction}" />
                <Button Text="{Binding [AccountDelete], Source={x:Static services:LocalizationResourceManager.Instance}}"
                        Command="{Binding DeleteAccountCommand}" Style="{StaticResource AccountAction}" TextColor="#985C55" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
