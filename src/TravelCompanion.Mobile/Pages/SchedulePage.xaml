<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.SchedulePage"
             x:Name="PageRoot"
             x:DataType="viewModels:ScheduleViewModel"
             Title="Schedule"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="20,14,20,0"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="14">

        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding TripTitle}"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding TripDates}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                </VerticalStackLayout>

                <Label Grid.Column="1"
                       Text="{Binding LastUpdatedMessage}"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                       VerticalOptions="End"
                       IsVisible="{Binding HasLastUpdated}" />
            </Grid>

            <Border Padding="14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource NightSurface}}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      RowSpacing="4"
                      ColumnSpacing="12">
                    <Label Text="Proxima reserva"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextTransform="Uppercase"
                           TextColor="{StaticResource Paper}"
                           Opacity="0.76" />
                    <Label Grid.Column="1"
                           Text="{Binding FocusMeta}"
                           FontSize="12"
                           TextColor="{StaticResource Paper}"
                           Opacity="0.85" />
                    <Label Grid.Row="1"
                           Text="{Binding FocusTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Paper}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding FocusSubtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Paper}"
                           Opacity="0.85"
                           VerticalOptions="End"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="8">
            <Border Padding="3"
                    HeightRequest="40"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <CollectionView ItemsSource="{Binding TypeFilters}"
                                SelectionMode="None"
                                HeightRequest="34"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                           ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ScheduleTypeFilterViewModel">
                            <Border Padding="14,6"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeThickness="1"
                                    HeightRequest="32">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTypeFilterTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding TextColor}"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Ciudad"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextTransform="Uppercase"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Limpiar"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <CollectionView ItemsSource="{Binding CityFilters}"
                            SelectionMode="None"
                            HeightRequest="32"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CityFilterViewModel">
                        <Border Padding="10,5"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1"
                                HeightRequest="30">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCityFilterTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayName}"
                                   FontSize="12"
                                   TextColor="{Binding TextColor}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Reintentar"
                            Command="{Binding LoadScheduleCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="12,8"
                            MinimumHeightRequest="34" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding ActiveDays}"
                        IsGrouped="True"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     Padding="24"
                                     IsVisible="{Binding ShowEmptyState}">
                    <Label Text="No hay reservas proximas"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                           HorizontalOptions="Center" />
                    <Label Text="Cambia el filtro o intenta nuevamente"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="viewModels:ScheduleDayViewModel">
                    <Grid Padding="0,16,0,10"
                          HeightRequest="56"
                          ColumnDefinitions="*,Auto">
                        <Label Text="{Binding DayLabel}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                        <Label Grid.Column="1"
                               Text="{Binding CountLabel}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:ScheduleItemDto">
                    <Border HeightRequest="124"
                            Padding="14"
                            Margin="0,0,0,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="64,*"
                              RowSpacing="5"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}', Mode=OneTime}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TypeLabel, Mode=OneTime}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextTransform="Uppercase"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="1" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="8">
                                <Label Text="{Binding City, Mode=OneTime}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextTransform="Uppercase"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding ConfirmationCode, Mode=OneTime}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </HorizontalStackLayout>

                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Title, Mode=OneTime}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="{Binding MainDetail, Mode=OneTime}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Grid.Column="1"
                                       Text="{Binding EndDisplay, Mode=OneTime}"
                                       FontSize="12"
                                       IsVisible="{Binding HasEnd, Mode=OneTime}"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3"
                             Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowInitialLoading}">
            <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                               WidthRequest="28"
                               HeightRequest="28" />
            <Label Text="Cargando reservas"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
