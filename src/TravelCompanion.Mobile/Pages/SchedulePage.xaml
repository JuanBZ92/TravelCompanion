<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             xmlns:pages="clr-namespace:TravelCompanion.Mobile.Pages"
             x:Class="TravelCompanion.Mobile.Pages.SchedulePage"
             x:Name="PageRoot"
             x:DataType="viewModels:ScheduleViewModel"
             Title="Today"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">

    <Grid RowDefinitions="*">
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshScheduleCommand}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="28,26,28,36"
                                     Spacing="24">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                        <Grid ColumnDefinitions="*,44">
                            <Label Text="HOY · YUKU JAPAN"
                                   CharacterSpacing="6"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   TextColor="#8E867D" />
                            <ImageButton Grid.Column="1"
                                         Source="itinerary_menu.svg"
                                         BackgroundColor="Transparent"
                                         Padding="8"
                                         WidthRequest="44"
                                         HeightRequest="44"
                                         IsVisible="{Binding HasItineraryActions}"
                                         Clicked="OnItineraryMenuClicked"
                                         SemanticProperties.Description="Opciones del itinerario" />
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{Binding SelectedCity}"
                                   FontFamily="serif"
                                   FontSize="34"
                                   SemanticProperties.HeadingLevel="Level1"
                                   TextColor="#1A1714"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Grid.Column="1"
                                   Text="{Binding AmbientGlyph}"
                                   FontSize="52"
                                   TextColor="#1A17140D"
                                   TranslationY="-14" />
                        </Grid>

                        <Label Grid.Row="2"
                               Text="{Binding SelectedDateLabel}"
                               FontSize="17"
                               TextColor="#6E675F" />

                        <Grid Grid.Row="3"
                              ColumnDefinitions="2,*"
                              ColumnSpacing="14"
                              IsVisible="{Binding HasPreviewMessage}">
                            <BoxView WidthRequest="2"
                                     BackgroundColor="#C85F55" />
                            <Label Grid.Column="1"
                                   Text="{Binding PreviewMessage}"
                                   FontSize="15"
                                   LineHeight="1.35"
                                   TextColor="#6A625B" />
                        </Grid>
                    </Grid>

                    <Border Padding="16,14"
                            BackgroundColor="#FFF7E8"
                            Stroke="#C7A45A"
                            StrokeThickness="1"
                            IsVisible="{Binding ShowTrialBanner}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Label Text="{Binding TrialBannerText}"
                                   FontSize="13"
                                   LineHeight="1.25"
                                   TextColor="#5F4B25" />
                            <Button Grid.Row="1"
                                    Text="Guardar con el pase"
                                    Command="{Binding RedeemPassCommand}"
                                    BackgroundColor="#3D3329"
                                    TextColor="White"
                                    CornerRadius="0" />
                        </Grid>
                    </Border>

                    <Border Padding="16,14"
                            BackgroundColor="#F6F1EA"
                            Stroke="#D8CFC4"
                            StrokeThickness="1"
                            IsVisible="{Binding HasStayCard}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,44" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="8">
                            <Label Text="HOTEL"
                                   CharacterSpacing="4"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#9B9288" />
                            <Label Text="{Binding StayTitle}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1A1714"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                            <Label Text="{Binding StayAddress}" FontSize="13" TextColor="#6E675F" IsVisible="{Binding CanOpenStayMap}" />
                            <Label Text="{Binding StayAttribution}" FontSize="11" TextColor="#6E675F" IsVisible="{Binding CanOpenStayMap}" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1"
                                         Source="tab_map.svg"
                                         Command="{Binding OpenStayMapCommand}"
                                         IsVisible="{Binding CanOpenStayMap}"
                                         Style="{StaticResource MapPreviewIconButton}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         SemanticProperties.Description="Abrir hotel en Google Maps" />
                        </Grid>
                    </Border>

                    <CollectionView ItemsSource="{Binding DayFilters}"
                                    SelectionMode="None"
                                    HeightRequest="84"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ScheduleDayFilterViewModel">
                                <Border WidthRequest="68"
                                        HeightRequest="80"
                                        Padding="10,9"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDayFilterTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding DayLabel}"
                                               CharacterSpacing="2"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{Binding PrimaryTextColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding DateLabel}"
                                               FontSize="14"
                                               TextColor="{Binding SecondaryTextColor}" />
                                        <Label Text="{Binding City}"
                                               FontSize="12"
                                               TextColor="{Binding SecondaryTextColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Padding="18,16"
                            BackgroundColor="{Binding SelectedDayReview.BackgroundColor}"
                            Stroke="{Binding SelectedDayReview.AccentColor}"
                            StrokeThickness="1"
                            IsVisible="{Binding ShowDayReview}">
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="34,*"
                              ColumnSpacing="12"
                              RowSpacing="14">
                            <Border WidthRequest="30"
                                    HeightRequest="30"
                                    Padding="0"
                                    BackgroundColor="{Binding SelectedDayReview.AccentColor}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Label Text="{Binding SelectedDayReview.StatusGlyph}"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{Binding SelectedDayReview.Eyebrow}"
                                       CharacterSpacing="3"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{Binding SelectedDayReview.AccentColor}" />
                                <Label Text="{Binding SelectedDayReview.Title}"
                                       FontFamily="serif"
                                       FontSize="21"
                                       TextColor="#1A1714" />
                                <Label Text="{Binding SelectedDayReview.Summary}"
                                       FontSize="13"
                                       LineHeight="1.3"
                                       TextColor="#6A625B" />
                                <Button Text="{Binding SelectedDayReview.AssistantActionLabel}"
                                        Command="{Binding AskAssistantAboutDayCommand}"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{Binding SelectedDayReview.AccentColor}"
                                        TextColor="White"
                                        CornerRadius="0"
                                        FontSize="12"
                                        Padding="12,8"
                                        Margin="0,5,0,0"
                                        MinimumHeightRequest="42" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Spacing="10"
                                                 IsVisible="{Binding SelectedDayReview.HasIssues}"
                                                 BindableLayout.ItemsSource="{Binding SelectedDayReview.Issues}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DayReviewIssueViewModel">
                                        <Border Padding="12"
                                                BackgroundColor="#FFFCF8"
                                                Stroke="#1A17141A"
                                                StrokeThickness="1">
                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="4,*"
                                                  ColumnSpacing="10"
                                                  RowSpacing="5">
                                                <BoxView Grid.RowSpan="3"
                                                         WidthRequest="4"
                                                         BackgroundColor="{Binding SeverityColor}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#1A1714" />
                                                <Label Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding Message}"
                                                       FontSize="12"
                                                       LineHeight="1.25"
                                                       TextColor="#6A625B" />
                                                <Button Grid.Row="2"
                                                        Grid.Column="1"
                                                        Text="{Binding ActionLabel}"
                                                        Command="{Binding ViewModel.OpenReviewIssueCommand, Source={x:Reference PageRoot}, x:DataType={x:Type pages:SchedulePage}}"
                                                        CommandParameter="{Binding .}"
                                                        IsVisible="{Binding CanOpenPlan}"
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource GhostButton}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        MinimumHeightRequest="40" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NoticePanel}"
                            IsVisible="{Binding HasStatus}">
                        <Label Text="{Binding StatusMessage}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                    </Border>

                    <Border Style="{StaticResource ErrorPanel}"
                            IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Reintentar"
                                    Command="{Binding LoadScheduleCommand}"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="12"
                                    Padding="12,8"
                                    MinimumHeightRequest="44" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="0"
                                         IsVisible="{Binding ShowTodayLoading}"
                                         BindableLayout.ItemsSource="{Binding TodayLoadingSections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ScheduleTodayLoadingSectionViewModel">
                                <Grid ColumnDefinitions="26,*"
                                      Margin="0,0,0,26"
                                      Opacity="0.72">
                                    <Grid>
                                        <BoxView WidthRequest="1"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Fill"
                                                 BackgroundColor="#1A17141A" />
                                        <shapes:Ellipse WidthRequest="10"
                                                        HeightRequest="10"
                                                        Stroke="#C9C1B8"
                                                        StrokeThickness="2"
                                                        Fill="#F8F3ED"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Start"
                                                        Margin="0,6,0,0" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="14"
                                                         Padding="12,0,0,8">
                                        <Grid ColumnDefinitions="68,*"
                                              ColumnSpacing="8"
                                              HeightRequest="36">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="serif"
                                                   FontSize="16"
                                                   TextColor="#8A8178"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding PeriodLabel}"
                                                   CharacterSpacing="4"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#AAA198"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="13"
                                                 HorizontalOptions="Fill"
                                                 BackgroundColor="#E8E1D9" />
                                        <BoxView HeightRequest="13"
                                                 WidthRequest="190"
                                                 HorizontalOptions="Start"
                                                 BackgroundColor="#EEE8E1" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="0"
                                         IsVisible="{Binding ShowTodayContent}"
                                         BindableLayout.ItemsSource="{Binding TodaySections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ScheduleTodaySectionViewModel">
                                <Grid ColumnDefinitions="26,*"
                                      Margin="0,0,0,26">
                                    <Grid>
                                        <BoxView WidthRequest="1"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Fill"
                                                 BackgroundColor="#1A171426" />
                                        <shapes:Ellipse WidthRequest="10"
                                                        HeightRequest="10"
                                                        Stroke="#B9B1A8"
                                                        StrokeThickness="2"
                                                        Fill="#F8F3ED"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Start"
                                                        Margin="0,6,0,0" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="13"
                                                         Padding="12,0,0,8">
                                        <Grid ColumnDefinitions="68,*,44"
                                              ColumnSpacing="8"
                                              HeightRequest="44">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="serif"
                                                   FontSize="16"
                                                   TextColor="#5A5148"
                                                   VerticalOptions="Center"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="NoWrap" />
                                            <Label Grid.Column="1" Text="{Binding PeriodLabel}"
                                                   CharacterSpacing="4"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#9B9288"
                                                   VerticalOptions="Center"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="NoWrap" />
                                            <Button Grid.Column="2" Text="+" ToolTipProperties.Text="Agregar plan personal"
                                                    Command="{Binding AddPersonalItemCommand, Source={RelativeSource AncestorType={x:Type viewModels:ScheduleViewModel}}, x:DataType=viewModels:ScheduleViewModel}"
                                                    CommandParameter="{Binding .}" IsVisible="{Binding CanAddItem}"
                                                    Style="{StaticResource GhostButton}" WidthRequest="44" HeightRequest="44" Padding="0" />
                                        </Grid>

                                        <Label Text="{Binding Description}"
                                               FontSize="16"
                                               LineHeight="1.35"
                                               TextColor="#4D4741"
                                               IsVisible="{Binding HasDescription}" />

                                        <VerticalStackLayout Spacing="8"
                                                             IsVisible="{Binding HasLocations}">
                                            <Label Text="LOCATIONS"
                                                   CharacterSpacing="3"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#9B9288" />
                                            <VerticalStackLayout Spacing="9"
                                                                 BindableLayout.ItemsSource="{Binding Locations}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:TodayLocationViewModel">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="12"
                                                              Padding="0,2">
                                                            <VerticalStackLayout Spacing="3">
                                                                <Label Text="{Binding AssignmentLabel}"
                                                                       FontSize="10"
                                                                       FontAttributes="Bold"
                                                                       CharacterSpacing="2"
                                                                       TextColor="#8A6F43"
                                                                       IsVisible="{Binding HasAssignmentLabel}" />
                                                                <Label Text="{Binding Title}"
                                                                       FontFamily="serif"
                                                                       FontSize="21"
                                                                       TextColor="#1A1714"
                                                                       LineBreakMode="WordWrap"
                                                                       MaxLines="2" />
                                                                <Label Text="{Binding Detail}"
                                                                       FontSize="13"
                                                                       TextColor="#8A8078"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="1" />
                                                                <Label Text="{Binding DistanceLabel}"
                                                                       FontSize="12"
                                                                       TextColor="#6E675F"
                                                                       IsVisible="{Binding HasDistance}" />
                                                                <Label Text="{Binding VisitStatusLabel}"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       CharacterSpacing="2"
                                                                       TextColor="#8A6F43"
                                                                       IsVisible="{Binding HasVisitStatus}" />
                                                                <HorizontalStackLayout Spacing="8"
                                                                                       Margin="0,4,0,0">
                                                                    <Button Text="Ya fui"
                                                                            Clicked="OnTodayLocationVisitedClicked"
                                                                            Style="{StaticResource GhostButton}"
                                                                            FontSize="11"
                                                                            Padding="10,6"
                                                                            MinimumHeightRequest="44"
                                                                            IsVisible="{Binding CanMarkVisited}" />
                                                                    <Button Text="No mostrar hoy"
                                                                            Clicked="OnTodayLocationDismissClicked"
                                                                            Style="{StaticResource GhostButton}"
                                                                            FontSize="11"
                                                                            Padding="10,6"
                                                                            MinimumHeightRequest="44"
                                                                            IsVisible="{Binding CanDismiss}" />
                                                                </HorizontalStackLayout>
                                                            </VerticalStackLayout>
                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="20"
                                                                                 VerticalOptions="Center">
                                                                <Image Source="tab_map.svg"
                                                                       WidthRequest="24"
                                                                       HeightRequest="24"
                                                                       Margin="10"
                                                                       Opacity="0.78"
                                                                       InputTransparent="True"
                                                                       SemanticProperties.Description="Abrir en el mapa" />
                                                                <ImageButton Source="action_delete.svg"
                                                                             Clicked="OnRemovePersonalRecommendationClicked"
                                                                             BackgroundColor="Transparent"
                                                                             WidthRequest="44"
                                                                             HeightRequest="44"
                                                                             Padding="10"
                                                                             IsVisible="{Binding CanRemove}"
                                                                             SemanticProperties.Description="Quitar del itinerario"
                                                                             ToolTipProperties.Text="Quitar del itinerario" />
                                                            </VerticalStackLayout>
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnTodayLocationTapped" />
                                                            </Grid.GestureRecognizers>
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="8"
                                                             IsVisible="{Binding HasReservations}">
                                            <Label Text="RESERVAS"
                                                   CharacterSpacing="3"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#9B9288" />
                                            <VerticalStackLayout Spacing="9"
                                                                 BindableLayout.ItemsSource="{Binding Reservations}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:TodayReservationViewModel">
                                                        <Border Padding="12,10"
                                                                BackgroundColor="#F6F1EA"
                                                                Stroke="#D8CFC4"
                                                                StrokeThickness="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="0" />
                                                            </Border.StrokeShape>
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Text="{Binding TimeLabel}"
                                                                       FontSize="12"
                                                                       TextColor="#8A8078" />
                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="4">
                                                                    <Label Text="{Binding Title}"
                                                                           FontFamily="serif"
                                                                           FontSize="21"
                                                                           TextColor="#1A1714"
                                                                           LineBreakMode="WordWrap"
                                                                           MaxLines="3"
                                                                           VerticalOptions="Center" />
                                                                    <ImageButton Grid.Column="1"
                                                                                 Source="action_edit.svg"
                                                                                 Clicked="OnEditPersonalItemClicked"
                                                                                 IsVisible="{Binding CanEdit}"
                                                                                 BackgroundColor="Transparent"
                                                                                 WidthRequest="44"
                                                                                 HeightRequest="44"
                                                                                 Padding="10"
                                                                                 VerticalOptions="Start"
                                                                                 SemanticProperties.Description="Editar reserva"
                                                                                 ToolTipProperties.Text="Editar reserva" />
                                                                    <ImageButton Grid.Column="2"
                                                                                 Source="action_delete.svg"
                                                                                 Clicked="OnDeletePersonalItemClicked"
                                                                                 IsVisible="{Binding CanEdit}"
                                                                                 BackgroundColor="Transparent"
                                                                                 WidthRequest="44"
                                                                                 HeightRequest="44"
                                                                                 Padding="10"
                                                                                 VerticalOptions="Start"
                                                                                 SemanticProperties.Description="Eliminar reserva"
                                                                                 ToolTipProperties.Text="Eliminar reserva" />
                                                                </Grid>
                                                                <Label Text="{Binding Place}"
                                                                       FontSize="13"
                                                                       TextColor="#6E675F"
                                                                       IsVisible="{Binding HasPlace}"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="2" />
                                                                <Label Text="{Binding Confirmation}"
                                                                       FontSize="12"
                                                                       TextColor="#8A8078"
                                                                       IsVisible="{Binding HasConfirmation}"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="1" />
                                                                <Label Text="{Binding DistanceFromHotelLabel}"
                                                                       FontSize="11"
                                                                       TextColor="#8A8078"
                                                                       IsVisible="{Binding HasDistanceFromHotel}"
                                                                       Margin="0,3,0,0" />
                                                                <FlexLayout Direction="Row" Wrap="NoWrap" AlignItems="Start" IsVisible="{Binding HasRoutes}" BindableLayout.ItemsSource="{Binding Routes}" Margin="0,10,0,0">
                                                                    <BindableLayout.ItemTemplate>
                                                                        <DataTemplate x:DataType="viewModels:ItineraryRouteViewModel">
                                                                            <VerticalStackLayout FlexLayout.Basis="33.33%" Padding="3,0" Spacing="4">
                                                                                <VerticalStackLayout.GestureRecognizers>
                                                                                    <TapGestureRecognizer Command="{Binding ViewModel.CalculateRouteCommand, Source={x:Reference PageRoot}, x:DataType={x:Type pages:SchedulePage}}"
                                                                                                          CommandParameter="{Binding .}" />
                                                                                </VerticalStackLayout.GestureRecognizers>
                                                                                <Image Source="{Binding Icon}" WidthRequest="22" HeightRequest="22" HorizontalOptions="Start" SemanticProperties.Description="{Binding Label}" />
                                                                                <Label Text="{Binding Label}" FontSize="11" TextColor="#6E675F" />
                                                                                <Label Text="{Binding Duration}" FontSize="12" TextColor="#1A1714" />
                                                                                <Label Text="{Binding Departure}" FontSize="11" TextColor="#1A1714" />
                                                                            </VerticalStackLayout>
                                                                        </DataTemplate>
                                                                    </BindableLayout.ItemTemplate>
                                                                </FlexLayout>
                                                                <Border IsVisible="{Binding HasRoutes}"
                                                                        Padding="10,8"
                                                                        Margin="0,8,0,0"
                                                                        BackgroundColor="Transparent"
                                                                        Stroke="#D8CFC4"
                                                                        StrokeThickness="1">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding ViewModel.CalculateRouteCommand, Source={x:Reference PageRoot}, x:DataType={x:Type pages:SchedulePage}}"
                                                                                              CommandParameter="{Binding CurrentLocationRoute}" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding CurrentLocationRoute.Duration, StringFormat='Desde mi ubicación · {0}'}"
                                                                           FontSize="11"
                                                                           TextColor="#6E675F" />
                                                                </Border>
                                                                <Label Text="Toca un modo para calcular · origen: hotel · llegada 10 min antes"
                                                                       IsVisible="{Binding HasRoutes}"
                                                                       FontSize="10"
                                                                       TextColor="#6E675F"
                                                                       LineBreakMode="WordWrap"
                                                                       Margin="0,4,0,0" />
                                                            </VerticalStackLayout>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnTodayReservationTapped" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout HorizontalOptions="Center"
                                         Spacing="8"
                                         Padding="8,26"
                                         IsVisible="{Binding ShowEmptyState}">
                        <Label Text="No hay planes para este dia"
                               FontFamily="serif"
                               FontSize="22"
                               TextColor="#1A1714"
                               HorizontalOptions="Center" />
                        <Label Text="Elegí otro día del viaje o tirá hacia abajo para actualizar."
                               FontSize="13"
                               TextColor="#8A8078"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <VerticalStackLayout Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowInitialLoading}">
            <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                               WidthRequest="28"
                               HeightRequest="28" />
            <Label Text="Cargando reservas"
                   FontSize="13"
                   TextColor="#8A8078" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
