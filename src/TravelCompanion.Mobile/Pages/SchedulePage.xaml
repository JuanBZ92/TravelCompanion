<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.SchedulePage"
             x:Name="PageRoot"
             x:DataType="viewModels:ScheduleViewModel"
             Title="Schedule"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">
        <!-- Header -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Your Itinerary"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
            <Label Text="{Binding TripDates}"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>

        <!-- City Filters -->
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Cities"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Clear filters"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Dynamic City Filter Chips -->
            <FlexLayout Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Start"
                        RowSpacing="8"
                        ColumnSpacing="8"
                        BindableLayout.ItemsSource="{Binding CityFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CityFilterViewModel">
                        <Border Padding="12,8"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleCityFilterCommand}"
                                                      CommandParameter="{Binding CityName}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding CityName}"
                                   FontSize="13"
                                   TextColor="{Binding TextColor}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <!-- Status Messages -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <!-- Schedule List -->
        <RefreshView Grid.Row="3"
                     Command="{Binding LoadScheduleCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Days}"
                            IsGrouped="True"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenScheduleItemCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="8"
                                       Padding="24">
                        <Label Text="No reservations found"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Pull to refresh"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewModels:ScheduleDayViewModel">
                        <Grid Padding="0,16,0,12" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DayLabel}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                            <Label Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ScheduleItemDto">
                        <Grid ColumnDefinitions="64,*" Padding="0,0,0,16">
                            <!-- Timeline -->
                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                <Border Padding="8,4"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                                        Stroke="Transparent"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource PrimaryDarkText}}"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                                <BoxView WidthRequest="2"
                                         HeightRequest="80"
                                         Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                         Margin="0,8,0,0" />
                            </VerticalStackLayout>

                            <!-- Content Card -->
                            <Border Grid.Column="1"
                                    Padding="16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <HorizontalStackLayout Spacing="10">
                                        <Border Padding="8,4"
                                                HorizontalOptions="Start"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource NightSurfaceAlt}}"
                                                Stroke="Transparent"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding City}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextTransform="Uppercase"
                                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                        <Label Text="{Binding LocationName}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="Confirmation:"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                        <Label Text="{Binding ConfirmationCode}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
