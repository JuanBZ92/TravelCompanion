<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.SchedulePage"
             x:Name="PageRoot"
             x:DataType="viewModels:ScheduleViewModel"
             Title="Today"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">

    <Grid RowDefinitions="*">
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshScheduleCommand}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="28,26,28,36"
                                     Spacing="24">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                        <Label Text="HOY · YUKU JAPAN"
                               CharacterSpacing="6"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#8E867D" />

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{Binding SelectedCity}"
                                   FontFamily="serif"
                                   FontSize="34"
                                   TextColor="#1A1714"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Grid.Column="1"
                                   Text="{Binding AmbientGlyph}"
                                   FontSize="52"
                                   TextColor="#1A17140D"
                                   TranslationY="-14" />
                        </Grid>

                        <Label Grid.Row="2"
                               Text="{Binding SelectedDateLabel}"
                               FontSize="17"
                               TextColor="#6E675F" />

                        <Grid Grid.Row="3"
                              ColumnDefinitions="2,*"
                              ColumnSpacing="14"
                              IsVisible="{Binding HasPreviewMessage}">
                            <BoxView WidthRequest="2"
                                     BackgroundColor="#C85F55" />
                            <Label Grid.Column="1"
                                   Text="{Binding PreviewMessage}"
                                   FontSize="15"
                                   LineHeight="1.35"
                                   TextColor="#6A625B" />
                        </Grid>
                    </Grid>

                    <Border Padding="16,14"
                            BackgroundColor="#F6F1EA"
                            Stroke="#D8CFC4"
                            StrokeThickness="1"
                            IsVisible="{Binding HasStayCard}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="HOTEL"
                                   CharacterSpacing="4"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#9B9288" />
                            <Label Text="{Binding StayTitle}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1A1714"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding DayFilters}"
                                    SelectionMode="None"
                                    HeightRequest="84"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ScheduleDayFilterViewModel">
                                <Border WidthRequest="68"
                                        HeightRequest="80"
                                        Padding="10,9"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDayFilterTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding DayLabel}"
                                               CharacterSpacing="2"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{Binding PrimaryTextColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding DateLabel}"
                                               FontSize="14"
                                               TextColor="{Binding SecondaryTextColor}" />
                                        <Label Text="{Binding City}"
                                               FontSize="12"
                                               TextColor="{Binding SecondaryTextColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Style="{StaticResource NoticePanel}"
                            IsVisible="{Binding HasStatus}">
                        <Label Text="{Binding StatusMessage}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                    </Border>

                    <Border Style="{StaticResource ErrorPanel}"
                            IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Reintentar"
                                    Command="{Binding LoadScheduleCommand}"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="12"
                                    Padding="12,8"
                                    MinimumHeightRequest="34" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding TodaySections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ScheduleTodaySectionViewModel">
                                <Grid ColumnDefinitions="26,*"
                                      Margin="0,0,0,26">
                                    <Grid>
                                        <BoxView WidthRequest="1"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Fill"
                                                 BackgroundColor="#1A171426" />
                                        <shapes:Ellipse WidthRequest="10"
                                                        HeightRequest="10"
                                                        Stroke="#B9B1A8"
                                                        StrokeThickness="2"
                                                        Fill="#F8F3ED"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Start"
                                                        Margin="0,6,0,0" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="13"
                                                         Padding="12,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="serif"
                                                   FontSize="16"
                                                   TextColor="#5A5148" />
                                            <Label Grid.Column="1" Text="{Binding PeriodLabel}"
                                                   CharacterSpacing="4"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#9B9288"
                                                   VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="+" ToolTipProperties.Text="Agregar plan personal"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddPersonalItemCommand}"
                                                    CommandParameter="{Binding .}" IsVisible="{Binding CanAddItem}"
                                                    Style="{StaticResource GhostButton}" WidthRequest="42" HeightRequest="36" Padding="0" />
                                        </Grid>

                                        <Label Text="{Binding Description}"
                                               FontSize="16"
                                               LineHeight="1.35"
                                               TextColor="#4D4741" />

                                        <VerticalStackLayout Spacing="8"
                                                             IsVisible="{Binding HasLocations}">
                                            <Label Text="LOCATIONS"
                                                   CharacterSpacing="3"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#9B9288" />
                                            <VerticalStackLayout Spacing="9"
                                                                 BindableLayout.ItemsSource="{Binding Locations}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:TodayLocationViewModel">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="12"
                                                              Padding="0,2">
                                                            <VerticalStackLayout Spacing="3">
                                                                <Label Text="{Binding AssignmentLabel}"
                                                                       FontSize="10"
                                                                       FontAttributes="Bold"
                                                                       CharacterSpacing="2"
                                                                       TextColor="#8A6F43"
                                                                       IsVisible="{Binding HasAssignmentLabel}" />
                                                                <Label Text="{Binding Title}"
                                                                       FontFamily="serif"
                                                                       FontSize="21"
                                                                       TextColor="#1A1714"
                                                                       LineBreakMode="WordWrap"
                                                                       MaxLines="2" />
                                                                <Label Text="{Binding Detail}"
                                                                       FontSize="13"
                                                                       TextColor="#8A8078"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="1" />
                                                                <Label Text="{Binding DistanceLabel}"
                                                                       FontSize="12"
                                                                       TextColor="#6E675F"
                                                                       IsVisible="{Binding HasDistance}" />
                                                                <Label Text="{Binding VisitStatusLabel}"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       CharacterSpacing="2"
                                                                       TextColor="#8A6F43"
                                                                       IsVisible="{Binding HasVisitStatus}" />
                                                                <HorizontalStackLayout Spacing="8"
                                                                                       Margin="0,4,0,0">
                                                                    <Button Text="Ya fui"
                                                                            Clicked="OnTodayLocationVisitedClicked"
                                                                            Style="{StaticResource GhostButton}"
                                                                            FontSize="11"
                                                                            Padding="10,6"
                                                                            MinimumHeightRequest="30"
                                                                            IsVisible="{Binding CanMarkVisited}" />
                                                                    <Button Text="No mostrar hoy"
                                                                            Clicked="OnTodayLocationDismissClicked"
                                                                            Style="{StaticResource GhostButton}"
                                                                            FontSize="11"
                                                                            Padding="10,6"
                                                                            MinimumHeightRequest="30"
                                                                            IsVisible="{Binding CanDismiss}" />
                                                                </HorizontalStackLayout>
                                                            </VerticalStackLayout>
                                                            <Image Grid.Column="1"
                                                                   Source="tab_map.svg"
                                                                   WidthRequest="24"
                                                                   HeightRequest="24"
                                                                   Opacity="0.78"
                                                                   VerticalOptions="Center"
                                                                   InputTransparent="True"
                                                                   SemanticProperties.Description="Abrir en el mapa" />
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnTodayLocationTapped" />
                                                            </Grid.GestureRecognizers>
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="8"
                                                             IsVisible="{Binding HasReservations}">
                                            <Label Text="RESERVAS"
                                                   CharacterSpacing="3"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#9B9288" />
                                            <VerticalStackLayout Spacing="9"
                                                                 BindableLayout.ItemsSource="{Binding Reservations}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:TodayReservationViewModel">
                                                        <Border Padding="12,10"
                                                                BackgroundColor="#F6F1EA"
                                                                Stroke="#D8CFC4"
                                                                StrokeThickness="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="0" />
                                                            </Border.StrokeShape>
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Text="{Binding TimeLabel}"
                                                                       FontSize="12"
                                                                       TextColor="#8A8078" />
                                                                <Label Text="{Binding Title}"
                                                                       FontFamily="serif"
                                                                       FontSize="21"
                                                                       TextColor="#1A1714"
                                                                       LineBreakMode="WordWrap"
                                                                       MaxLines="2" />
                                                                <Label Text="{Binding Place}"
                                                                       FontSize="13"
                                                                       TextColor="#6E675F"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="2" />
                                                                <Label Text="{Binding Confirmation}"
                                                                       FontSize="12"
                                                                       TextColor="#8A8078"
                                                                       IsVisible="{Binding HasConfirmation}"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="1" />
                                                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding CanEdit}">
                                                                    <Button Text="Editar" Clicked="OnEditPersonalItemClicked" Style="{StaticResource GhostButton}" FontSize="11" Padding="10,6" />
                                                                    <Button Text="Eliminar" Clicked="OnDeletePersonalItemClicked" Style="{StaticResource GhostButton}" FontSize="11" Padding="10,6" />
                                                                </HorizontalStackLayout>
                                                            </VerticalStackLayout>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnTodayReservationTapped" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout HorizontalOptions="Center"
                                         Spacing="8"
                                         Padding="8,26"
                                         IsVisible="{Binding ShowEmptyState}">
                        <Label Text="No hay planes para este dia"
                               FontFamily="serif"
                               FontSize="22"
                               TextColor="#1A1714"
                               HorizontalOptions="Center" />
                        <Label Text="Elegí otro día del viaje o tirá hacia abajo para actualizar."
                               FontSize="13"
                               TextColor="#8A8078"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <VerticalStackLayout Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowInitialLoading}">
            <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                               WidthRequest="28"
                               HeightRequest="28" />
            <Label Text="Cargando reservas"
                   FontSize="13"
                   TextColor="#8A8078" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
