<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.SchedulePage"
             x:Name="PageRoot"
             x:DataType="viewModels:ScheduleViewModel"
             Title="Schedule"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">
        <!-- Header -->
        <Grid ColumnDefinitions="*,40" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Your Itinerary"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Label Text="{Binding TripDates}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="↻"
                    Command="{Binding LoadScheduleCommand}"
                    FontSize="16"
                    Padding="0"
                    HeightRequest="36"
                    WidthRequest="36"
                    CornerRadius="18"
                    BackgroundColor="Transparent"
                    BorderColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                    VerticalOptions="Start" />
        </Grid>

        <!-- Type and City Filters -->
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <CollectionView ItemsSource="{Binding TypeFilters}"
                            SelectionMode="None"
                            HeightRequest="40">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ScheduleTypeFilterViewModel">
                        <Border Padding="14,9"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleTypeFilterCommand}"
                                                      CommandParameter="{Binding Type}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{Binding TextColor}"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Cities"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Clear filters"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Dynamic City Filter Chips -->
            <CollectionView ItemsSource="{Binding CityFilters}"
                            SelectionMode="None"
                            HeightRequest="40">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CityFilterViewModel">
                        <Border Padding="12,8"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleCityFilterCommand}"
                                                      CommandParameter="{Binding CityName}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding CityName}"
                                   FontSize="13"
                                   TextColor="{Binding TextColor}"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Status Messages -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasStatus}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource RoseSoft}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <!-- Schedule List -->
        <ScrollView Grid.Row="3"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <VerticalStackLayout Spacing="0"
                                     IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Days.Count}"
                                     Value="0">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24">
                        <Label Text="No reservations found"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Use refresh button to retry"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ScheduleDayViewModel">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="0,16,0,12" HeightRequest="54" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding DayLabel}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding CountLabel}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                           VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding .}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:ScheduleItemDto">
                                            <Grid HeightRequest="132"
                                                  Padding="0,14"
                                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,1"
                                                  ColumnDefinitions="58,*"
                                                  BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenScheduleItemCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}', Mode=OneTime}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalOptions="Start" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                    <Label Text="{Binding TypeLabel, Mode=OneTime}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextTransform="Uppercase"
                                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                                                    <Label Text="{Binding City, Mode=OneTime}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextTransform="Uppercase"
                                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />
                                                </HorizontalStackLayout>
                                                <Label Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding Title, Mode=OneTime}"
                                                       FontSize="17"
                                                       FontAttributes="Bold"
                                                       Margin="0,6,0,0"
                                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Grid.Row="2"
                                                       Grid.Column="1"
                                                       Text="{Binding MainDetail, Mode=OneTime}"
                                                       FontSize="13"
                                                       Margin="0,4,0,0"
                                                       TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Grid.Row="3"
                                                       Grid.Column="1"
                                                       Text="{Binding SecondaryDetail, Mode=OneTime}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Grid.Row="4"
                                                       Grid.Column="1"
                                                       Text="{Binding EndDisplay, Mode=OneTime}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       IsVisible="{Binding HasEnd, Mode=OneTime}"
                                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />

                                                <BoxView Grid.Row="5"
                                                         Grid.ColumnSpan="2"
                                                         HeightRequest="1"
                                                         Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <BoxView HeightRequest="28" Opacity="0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
