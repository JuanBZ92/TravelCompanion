<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.SchedulePage"
             x:Name="PageRoot"
             x:DataType="viewModels:ScheduleViewModel"
             Title="Schedule"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaperAlt}, Dark={StaticResource Night}}">

    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <!-- Header -->
        <Grid ColumnDefinitions="*" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Itinerario"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                <Label Text="{Binding TripDates}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                <Label Text="{Binding LastUpdatedMessage}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                       IsVisible="{Binding HasLastUpdated}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Type and City Filters -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Padding="3"
                    HeightRequest="40"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource NightSurfaceAlt}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <CollectionView ItemsSource="{Binding TypeFilters}"
                                SelectionMode="None"
                                HeightRequest="34">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                           ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ScheduleTypeFilterViewModel">
                            <Border Padding="14,6"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    HeightRequest="32">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTypeFilterTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding TextColor}"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Ciudad"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextTransform="Uppercase"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Limpiar"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Dynamic City Filter Chips -->
            <CollectionView ItemsSource="{Binding CityFilters}"
                            SelectionMode="None"
                            HeightRequest="32">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CityFilterViewModel">
                        <Border Padding="10,5"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1"
                                VerticalOptions="Center"
                                HeightRequest="30">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCityFilterTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayName}"
                                   FontSize="12"
                                   TextColor="{Binding TextColor}"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Status Messages -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Reintentar"
                            Command="{Binding LoadScheduleCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="12,8"
                            MinimumHeightRequest="34" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Schedule List -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshScheduleCommand}">
            <CollectionView ItemsSource="{Binding ActiveDays}"
                            IsGrouped="True"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="24"
                                         IsVisible="{Binding ShowEmptyState}">
                        <Label Text="No upcoming reservations found"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                        <Label Text="Cambia el filtro o intenta nuevamente"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewModels:ScheduleDayViewModel">
                        <Grid Padding="0,16,0,12"
                              HeightRequest="54"
                              ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DayLabel}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ScheduleItemDto">
                        <Border HeightRequest="132"
                                Padding="14"
                                Margin="0,0,0,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnScheduleItemTapped" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="58,*">
                                <Label Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}', Mode=OneTime}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Start" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="{Binding TypeLabel, Mode=OneTime}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextTransform="Uppercase"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                                    <Label Text="{Binding City, Mode=OneTime}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextTransform="Uppercase"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Title, Mode=OneTime}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       Margin="0,6,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding MainDetail, Mode=OneTime}"
                                       FontSize="13"
                                       Margin="0,4,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding SecondaryDetail, Mode=OneTime}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding EndDisplay, Mode=OneTime}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       IsVisible="{Binding HasEnd, Mode=OneTime}"
                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="3"
                             Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowInitialLoading}">
            <ActivityIndicator IsRunning="{Binding ShowInitialLoading}"
                               WidthRequest="28"
                               HeightRequest="28" />
            <Label Text="Cargando reservas"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
