<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels" xmlns:dto="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared" xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
 x:Class="TravelCompanion.Mobile.Pages.ThematicRoutesPage" x:DataType="viewModels:ThematicRoutesViewModel" Title="{Binding [RoutesPageTitle], Source={x:Static services:LocalizationResourceManager.Instance}}">
<Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="16">
<Grid ColumnDefinitions="*,Auto,Auto,Auto"><VerticalStackLayout><Label Text="{Binding [RoutesEyebrow], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding [RoutesHeadline], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Title}"/></VerticalStackLayout>
<Button Grid.Column="1" Text="{Binding [RoutesLastProposal], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding OpenSavedProposalCommand}" Style="{StaticResource GhostButton}"/><Button Grid.Column="2" Text="{Binding [RoutesReorganize], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding ReorganizeDayCommand}" Style="{StaticResource GhostButton}"/><Button Grid.Column="3" Text="{Binding [RoutesNew], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding CreateRouteCommand}"/></Grid>
<Grid Grid.Row="1" ColumnDefinitions="2*,2*,Auto,Auto,Auto" ColumnSpacing="8">
<Entry Placeholder="{Binding [RoutesNamePrompt], Source={x:Static services:LocalizationResourceManager.Instance}}" Text="{Binding NewRouteName}" SemanticProperties.Description="Route name"/>
<Entry Grid.Column="1" Placeholder="{Binding [RoutesCityPrompt], Source={x:Static services:LocalizationResourceManager.Instance}}" Text="{Binding NewRouteCity}" SemanticProperties.Description="Route city"/>
<DatePicker Grid.Column="2" Date="{Binding RouteDate}" SemanticProperties.Description="Route date"/>
<TimePicker Grid.Column="3" Time="{Binding WindowStart}" SemanticProperties.Description="Route start time"/>
<VerticalStackLayout Grid.Column="4" Spacing="4"><TimePicker Time="{Binding WindowEnd}" SemanticProperties.Description="Route end time"/><Picker ItemsSource="{Binding PaceOptions}" SelectedItem="{Binding SelectedPace}" SemanticProperties.Description="Route pace"/></VerticalStackLayout>
</Grid>
<RefreshView Grid.Row="2" Command="{Binding LoadRoutesCommand}" IsRefreshing="{Binding IsRefreshing}"><CollectionView ItemsSource="{Binding Routes}" EmptyView="{Binding [RoutesEmpty], Source={x:Static services:LocalizationResourceManager.Instance}}">
<CollectionView.ItemTemplate><DataTemplate x:DataType="dto:ThematicRouteDto"><Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto">
<Label Text="{Binding Name}" Style="{StaticResource SectionTitle}"/><Label Grid.Column="1" Text="{Binding Theme}" Style="{StaticResource Metadata}"/>
<Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding City}" Style="{StaticResource Body}"/>
<VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="4" BindableLayout.ItemsSource="{Binding Stops}" Margin="0,6"><BindableLayout.ItemTemplate><DataTemplate x:DataType="dto:RouteStopDto"><Label Text="{Binding Title, StringFormat='• {0}'}" Style="{StaticResource Metadata}"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
<Button Grid.Row="3" Text="{Binding [RoutesAddToDay], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ThematicRoutesViewModel}}, Path=ApplyRouteCommand}" CommandParameter="{Binding .}"/>
<Button Grid.Row="3" Grid.Column="1" Text="{Binding [RoutesSaveCopy], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ThematicRoutesViewModel}}, Path=SaveTemplateCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}"/>
<Button Grid.Row="3" Grid.Column="2" Text="{Binding [CommonEdit], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ThematicRoutesViewModel}}, Path=EditRouteCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}"/>
<Button Grid.Row="3" Grid.Column="3" Text="{Binding [CommonRemove], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ThematicRoutesViewModel}}, Path=DeleteRouteCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}"/>
</Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></RefreshView>
</Grid></ContentPage>
