<?xml version="1.0" encoding="utf-8" ?>
<pages:TripScopedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pages="clr-namespace:TravelCompanion.Mobile.Pages"
 xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels" x:Class="TravelCompanion.Mobile.Pages.ImproveDayPage"
 x:Name="PlannerRoot" x:DataType="vm:DayPlannerViewModel" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
 BackgroundColor="{StaticResource Mist}" SafeAreaEdges="All">
 <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,8,24,16" RowSpacing="12">
  <Grid ColumnDefinitions="48,*,48">
   <ImageButton Source="planner_back.svg" Clicked="OnBackClicked" Style="{StaticResource EditorialIconButton}" SemanticProperties.Description="{Binding BackLabel}"/>
   <Label Grid.Column="1" Text="{Binding Destination}" FontSize="13" TextColor="{StaticResource Muted}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
  </Grid>
  <Label x:Name="PlannerError" Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#9A493F" FontSize="14" LineBreakMode="WordWrap"/>
  <ScrollView Grid.Row="2">
   <VerticalStackLayout Spacing="20" Padding="0,0,0,16">
    <VerticalStackLayout Spacing="8">
     <Label Text="{Binding Title}" Style="{StaticResource EditorialHeading}" SemanticProperties.HeadingLevel="Level1"/>
     <Label Text="{Binding Intro}" Style="{StaticResource EditorialBody}"/>
    </VerticalStackLayout>
    <Border Style="{StaticResource EditorialCard}">
     <VerticalStackLayout Spacing="12">
      <Label Text="{Binding DateLabel}" FontSize="13" TextColor="{StaticResource Muted}"/>
      <DatePicker Date="{Binding SelectedDate}" MinimumDate="{Binding MinimumDate}" MaximumDate="{Binding MaximumDate}" Format="dddd d MMMM" IsEnabled="{Binding IsNotBusy}" MinimumHeightRequest="48"/>
      <Label Text="{Binding DurationLabel}" FontSize="13" TextColor="{StaticResource Muted}"/>
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" BindableLayout.ItemsSource="{Binding Durations}">
       <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="vm:PlannerDurationOption">
          <Button Grid.Column="{Binding ColumnIndex}" Text="{Binding Label}"
           Command="{Binding BindingContext.SelectDurationCommand, Source={x:Reference PlannerRoot}}" CommandParameter="{Binding .}"
           IsEnabled="{Binding WithinTrip}" BackgroundColor="{Binding Background}" TextColor="{Binding Foreground}"
           BorderColor="{StaticResource EditorialLine}" BorderWidth="1" CornerRadius="10"
           MinimumHeightRequest="48" Padding="4,8" FontSize="13" LineBreakMode="WordWrap"
           SemanticProperties.Description="{Binding AccessibilityLabel}">
           <Button.Triggers>
            <DataTrigger TargetType="Button" Binding="{Binding BindingContext.IsBusy, Source={x:Reference PlannerRoot}}" Value="True">
             <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
            <DataTrigger TargetType="Button" Binding="{Binding WithinTrip}" Value="False">
             <Setter Property="Opacity" Value="0.4"/>
            </DataTrigger>
           </Button.Triggers>
          </Button>
        </DataTemplate>
       </BindableLayout.ItemTemplate>
      </Grid>
      <Label Text="{Binding DurationPassHint}" IsVisible="{Binding HasDurationPassHint}" FontSize="11"
       TextColor="{StaticResource Muted}" LineBreakMode="WordWrap"/>
      <Label Text="{Binding RangeSummary}" FontSize="14" TextColor="{StaticResource Ink}"/>
      <Label Text="{Binding RangeCities}" IsVisible="{Binding HasRangeCities}" FontSize="14" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap"/>
      <Label Text="{Binding ExistingPlansSummary}" IsVisible="{Binding HasExistingPlansSummary}" FontSize="13" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap"/>
     </VerticalStackLayout>
    </Border>
    <Border Style="{StaticResource EditorialCard}">
     <VerticalStackLayout Spacing="12">
      <Grid ColumnDefinitions="*,48">
       <VerticalStackLayout Spacing="5">
        <Label Text="{Binding PreferencesLabel}" FontFamily="serif" FontSize="21" TextColor="{StaticResource Ink}"/>
        <Label Text="{Binding PreferencesSummary}" FontSize="13" TextColor="{StaticResource Muted}"/>
       </VerticalStackLayout>
       <ImageButton Grid.Column="1" Source="action_edit.svg" Command="{Binding TogglePreferencesCommand}" Style="{StaticResource EditorialIconButton}" SemanticProperties.Description="{Binding AdjustLabel}"/>
      </Grid>
      <VerticalStackLayout IsVisible="{Binding ShowPreferences}" IsEnabled="{Binding IsNotBusy}" Spacing="12">
       <Label Text="{Binding PaceLabel}" FontSize="13" TextColor="{StaticResource Muted}"/>
       <Picker Title="{Binding PaceLabel}" ItemsSource="{Binding Paces}" SelectedIndex="{Binding PaceIndex}" MinimumHeightRequest="48"/>
       <Label Text="{Binding BudgetLabel}" FontSize="13" TextColor="{StaticResource Muted}"/>
       <Picker Title="{Binding BudgetLabel}" ItemsSource="{Binding Budgets}" SelectedIndex="{Binding BudgetIndex}" MinimumHeightRequest="48"/>
       <Label Text="{Binding InterestsLabel}" FontSize="13" TextColor="{StaticResource Muted}"/>
       <VerticalStackLayout BindableLayout.ItemsSource="{Binding Interests}" Spacing="0">
        <BindableLayout.ItemTemplate>
         <DataTemplate x:DataType="vm:PlannerInterestOption">
          <Grid ColumnDefinitions="48,*" MinimumHeightRequest="48">
           <CheckBox IsChecked="{Binding IsSelected}" SemanticProperties.Description="{Binding Label}" MinimumHeightRequest="48" MinimumWidthRequest="48"/>
           <Label Grid.Column="1" Text="{Binding Label}" VerticalTextAlignment="Center" FontSize="14" TextColor="{StaticResource Ink}"/>
          </Grid>
         </DataTemplate>
        </BindableLayout.ItemTemplate>
       </VerticalStackLayout>
      </VerticalStackLayout>
     </VerticalStackLayout>
    </Border>
    <Button Text="{Binding ContinueLabel}" Command="{Binding ContinueProposalCommand}" IsVisible="{Binding HasProposal}" Style="{StaticResource EditorialSecondaryButton}"/>
    <Button Text="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" Style="{StaticResource EditorialSecondaryButton}"/>
    <Button Text="{Binding RetryLabel}" Command="{Binding RefreshOptionsCommand}" IsVisible="{Binding ShowRetry}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource EditorialSecondaryButton}"/>
    <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Muted}" FontSize="14"/>
   </VerticalStackLayout>
  </ScrollView>
  <VerticalStackLayout Grid.Row="3" Spacing="8">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsBusy}">
    <ActivityIndicator IsRunning="{Binding IsBusy}" WidthRequest="24"/>
    <Label Grid.Column="1" Text="{Binding BusyMessage}" FontSize="13" TextColor="{StaticResource Muted}" VerticalTextAlignment="Center"/>
   </Grid>
   <Button Text="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Style="{StaticResource EditorialSecondaryButton}"/>
   <Button Text="{Binding GenerateLabel}" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Style="{StaticResource EditorialPrimaryButton}"/>
   <Label Text="{Binding Quota}" FontSize="11" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
  </VerticalStackLayout>
 </Grid>
</pages:TripScopedPage>
