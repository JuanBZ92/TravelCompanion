<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.TravelChatPage"
             x:Name="PageRoot"
             x:DataType="viewModels:TravelChatViewModel"
             Title="{Binding AssistantTitle}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Mist}">

    <ContentPage.Resources>
        <Style x:Key="AssistantIconAction" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <Trigger TargetType="ImageButton" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid>
    <Grid Padding="24,16,24,0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10"
          InputTransparent="{Binding HasSelectedDetailCard}"
          IsVisible="{Binding ShowAssistantConversation}">
        <Grid ColumnDefinitions="48,*,48" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="10">
            <ImageButton Source="planner_back.svg" Command="{Binding ReturnAssistantHomeCommand}"
                         Style="{StaticResource AssistantIconAction}"
                         SemanticProperties.Description="{Binding AssistantBackHome}" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding AssistantEyebrow}"
                       CharacterSpacing="1" FontSize="9" TextColor="{StaticResource Muted}" />
                <Label Text="{Binding AssistantTitle}" FontFamily="serif" FontSize="28"
                       SemanticProperties.HeadingLevel="Level1" TextColor="{StaticResource Ink}" />
            </VerticalStackLayout>
            <ImageButton Grid.Column="2" Source="itinerary_menu.svg"
                         Command="{Binding ToggleSecondaryMenuCommand}"
                         Style="{StaticResource AssistantIconAction}"
                         SemanticProperties.Description="{Binding MenuText}" />
            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="4">
                <Border Padding="12,6" BackgroundColor="{StaticResource Paper}" Stroke="{StaticResource Line}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="10">
                        <Image Source="tab_trip.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="{Binding AssistantForDay}" FontSize="9" CharacterSpacing="1"
                                   TextColor="{StaticResource Muted}" />
                            <DatePicker Date="{Binding PlanningDate}" Format="ddd d MMMM"
                                        DateSelected="OnAssistantDateSelected" HandlerChanged="OnConversationInputHandlerChanged"
                                        MinimumDate="{Binding AssistantMinimumDate}" MaximumDate="{Binding AssistantMaximumDate}"
                                        IsEnabled="{Binding IsNotBusy}" FontSize="14" TextColor="{StaticResource Ink}"
                                        MinimumHeightRequest="48" HorizontalOptions="Fill"
                                        SemanticProperties.Description="{Binding AssistantChooseDate}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="⌄" FontSize="22" TextColor="{StaticResource Muted}"
                               VerticalOptions="Center" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                    </Grid>
                </Border>
                <Label Text="{Binding LastUpdatedMessage}"
                       IsVisible="{Binding HasLastUpdated}"
                       Margin="4,0" FontSize="10"
                       TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Padding="14,12"
                    BackgroundColor="{StaticResource AccentSoft}"
                    Stroke="#D8CFC4"
                    StrokeThickness="1"
                    IsVisible="{Binding HasMissingContext}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding MissingContextMessage}"
                           FontSize="13"
                           LineHeight="1.35"
                           TextColor="{StaticResource Ink}" />
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding MissingContextSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="system:String">
                                <Button Text="{Binding .}" Clicked="OnSuggestedReplyClicked"
                                        Margin="0,0,8,6" Padding="12,10"
                                        BackgroundColor="{StaticResource AccentSoft}" BorderColor="{StaticResource Line}"
                                        BorderWidth="1" CornerRadius="12" FontSize="13" TextColor="{StaticResource Ink}"
                                        MinimumHeightRequest="48" MinimumWidthRequest="48" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{StaticResource Accent}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{StaticResource Rose}" />
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <CollectionView x:Name="ConversationMessagesView"
                            ItemsSource="{Binding Messages}"
                            IsVisible="{Binding ShowConversationList}"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            Loaded="OnConversationMessagesReady"
                            SizeChanged="OnConversationMessagesReady"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="2,*"
                          ColumnSpacing="16"
                        IsVisible="{Binding HasGuidedQuestion}" Margin="0,0,0,14">
                        <BoxView WidthRequest="2"
                                 VerticalOptions="Fill"
                                 BackgroundColor="{StaticResource Gold}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="16">
                            <Label Text="{Binding GuidedQuestionText}"
                                   FontSize="24"
                                   FontFamily="serif"
                                   LineHeight="1.2"
                                   SemanticProperties.HeadingLevel="Level2"
                                   TextColor="{StaticResource Ink}" />
                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        AlignItems="Start"
                                        BindableLayout.ItemsSource="{Binding GuidedOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                                        <Button Text="{Binding DisplayLabel}"
                                                Clicked="OnGuidedOptionClicked"
                                                FlexLayout.Basis="48%"
                                                TextColor="{StaticResource Ink}"
                                                BackgroundColor="{StaticResource AccentSoft}"
                                                BorderColor="#D8CFC4"
                                                BorderWidth="1"
                                                CornerRadius="0"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                LineBreakMode="WordWrap"
                                                Padding="12,10"
                                                MinimumHeightRequest="48"
                                                Margin="0,0,8,8" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
                                <Button Text="{Binding BackText, StringFormat='←  {0}'}"
                                        Command="{Binding GoBackGuidedCommand}"
                                        IsVisible="{Binding CanGoBack}"
                                        SemanticProperties.Description="{Binding BackText}"
                                        TextColor="{StaticResource Accent}"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        FontSize="12"
                                        Padding="8,6"
                                        MinimumHeightRequest="48" />
                                <Button Text="{Binding RestartText, StringFormat='↺  {0}'}"
                                        Command="{Binding RestartGuidedCommand}"
                                        IsVisible="{Binding CanRestartGuided}"
                                        SemanticProperties.Description="{Binding RestartText}"
                                        TextColor="{StaticResource Accent}"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        FontSize="12"
                                        Padding="8,6"
                                        MinimumHeightRequest="48" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TravelChatMessageViewModel">
                            <VerticalStackLayout Spacing="8">
                                <Border Padding="14,11"
                                        IsVisible="{Binding ShouldShowText}"
                                        MaximumWidthRequest="620"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{StaticResource Paper}"
                                        Stroke="{StaticResource Line}"
                                        StrokeThickness="1">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsFromUser}"
                                                     Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Text}"
                                           FontSize="14"
                                           LineHeight="1.35"
                                           TextColor="{StaticResource Ink}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsFromUser}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Paper}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border Padding="12,10"
                                        IsVisible="{Binding IsProgressMessage}"
                                        MaximumWidthRequest="620"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="{StaticResource AccentSoft}"
                                        Stroke="{StaticResource Gold}"
                                        StrokeThickness="1"
                                        SemanticProperties.Description="{Binding Text}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                                           IsVisible="{Binding IsLoading}"
                                                           Color="{StaticResource Accent}"
                                                           WidthRequest="20"
                                                           HeightRequest="20" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               TextColor="{StaticResource Accent}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding HasCards}"
                                                     BindableLayout.ItemsSource="{Binding Cards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TravelChatCardViewModel">
                                            <Border Loaded="OnCardLoaded" Unloaded="OnCardUnloaded" Style="{StaticResource Card}"
                                                    Padding="14"
                                                    BackgroundColor="{StaticResource Paper}"
                                                    Stroke="{StaticResource Line}">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <Label Text="{Binding Title}"
                                                               FontSize="21"
                                                               FontFamily="serif"
                                                               TextColor="#1A1714"
                                                               MaxLines="2"
                                                               VerticalOptions="Center" />
                                                        <ImageButton Grid.Column="1" Source="action_info.svg" Clicked="OnOpenCardClicked"
                                                                     SemanticProperties.Description="{Binding DetailButtonText}" ToolTipProperties.Text="{Binding DetailButtonText}"
                                                                     Style="{StaticResource AssistantIconAction}" VerticalOptions="Start" />
                                                    </Grid>
                                                    <Label Grid.Row="1"
                                                           Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource EditorialAccentText}"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Grid.Row="2"
                                                           Text="{Binding Description}"
                                                           FontSize="13"
                                                           TextColor="{StaticResource InkSoft}"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Grid.Row="3"
                                                           Text="{Binding SummaryLine}"
                                                           FontSize="12"
                                                           LineHeight="1.3"
                                                           TextColor="{StaticResource EditorialAccentText}" />
                                                    <FlexLayout Grid.Row="4"
                                                                Direction="Row"
                                                                Wrap="Wrap"
                                                                AlignItems="Start"
                                                                 IsVisible="False"
                                                                BindableLayout.ItemsSource="{Binding TagActions}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:TravelChatTagActionViewModel">
                                                                <Border Style="{StaticResource Chip}"
                                                                        Padding="8,5"
                                                                        BackgroundColor="{StaticResource AccentSoft}"
                                                                        Stroke="#D8CFC4"
                                                                        Margin="0,0,6,4">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnTagActionTapped" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding Label}"
                                                                           FontSize="11"
                                                                           TextColor="{StaticResource InkSoft}"
                                                                           MaxLines="1"
                                                                           LineBreakMode="TailTruncation" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                    <VerticalStackLayout Grid.Row="5"
                                                                         Spacing="4"
                                                                          IsVisible="False"
                                                                         BindableLayout.ItemsSource="{Binding WhyItFits}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="system:String">
                                                                <Label Text="{Binding ., StringFormat='- {0}'}"
                                                                       FontSize="12"
                                                                       TextColor="{StaticResource Muted}" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Row="6"
                                                                         Spacing="4"
                                                                          IsVisible="False"
                                                                         BindableLayout.ItemsSource="{Binding WarningLabels}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="system:String">
                                                                <Label Text="{Binding .}"
                                                                       FontSize="12"
                                                                       TextColor="{StaticResource Rose}" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Grid.Row="7" Spacing="6" HorizontalOptions="End" IsVisible="{Binding HasRecommendationId}">
                                                        <ActivityIndicator IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}" WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                                                        <ActivityIndicator IsRunning="{Binding IsSearchingAlternative}" IsVisible="{Binding IsSearchingAlternative}" WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                                                        <ImageButton Source="action_alternative.svg" Clicked="OnReplaceRecommendationClicked"
                                                                     IsEnabled="{Binding CanFindAlternative}" Style="{StaticResource AssistantIconAction}"
                                                                     SemanticProperties.Description="{Binding AnotherOptionLabel}" ToolTipProperties.Text="{Binding AnotherOptionLabel}" />
                                                        <ImageButton Source="{Binding SaveIcon}" Clicked="OnSaveItineraryItemClicked"
                                     IsVisible="{Binding BindingContext.CanPlanItinerary, Source={x:Reference PageRoot}}"
                                                                     IsEnabled="{Binding CanSave}" Style="{StaticResource AssistantIconAction}" BackgroundColor="{StaticResource Accent}"
                                                                     SemanticProperties.Description="{Binding SaveButtonText}" ToolTipProperties.Text="{Binding SaveButtonText}" />
                                                    </HorizontalStackLayout>
                                                    <Label Grid.Row="8"
                                                           Text="{Binding FeedbackStatusMessage}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Muted}"
                                                           IsVisible="{Binding HasFeedbackStatus}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ScrollView IsVisible="{Binding ShowEmptyState}" VerticalScrollBarVisibility="Never">
                <Border Padding="20,20" Margin="0,8,0,12" BackgroundColor="{StaticResource Paper}"
                        Stroke="{StaticResource Line}" VerticalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding AssistantConversationPrompt}" FontFamily="serif"
                               FontSize="24" TextColor="{StaticResource Ink}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding AssistantConversationHelp}" FontSize="14"
                               LineHeight="1.35" TextColor="{StaticResource Muted}" />
                        <VerticalStackLayout Spacing="8" Margin="0,4,0,0">
                            <Button Text="{Binding AssistantConversationStarterSchedule}"
                                    LineBreakMode="WordWrap"
                                    CommandParameter="{Binding AssistantConversationStarterSchedule}"
                                    Clicked="OnConversationStarterClicked" Style="{StaticResource GhostButton}"
                                    SemanticProperties.Hint="{Binding AssistantConversationStarterHint}"
                                    BackgroundColor="{StaticResource AccentSoft}" BorderWidth="1" BorderColor="{StaticResource Line}"
                                    CornerRadius="12" TextColor="{StaticResource Ink}" FontSize="13"
                                    Padding="12,10" MinimumHeightRequest="48" HorizontalOptions="Fill" />
                            <Button Text="{Binding AssistantConversationStarterNearby}"
                                    LineBreakMode="WordWrap"
                                    CommandParameter="{Binding AssistantConversationStarterNearby}"
                                    Clicked="OnConversationStarterClicked" Style="{StaticResource GhostButton}"
                                    SemanticProperties.Hint="{Binding AssistantConversationStarterHint}"
                                    BackgroundColor="{StaticResource AccentSoft}" BorderWidth="1" BorderColor="{StaticResource Line}"
                                    CornerRadius="12" TextColor="{StaticResource Ink}" FontSize="13"
                                    Padding="12,10" MinimumHeightRequest="48" HorizontalOptions="Fill" />
                            <Button Text="{Binding AssistantConversationStarterHelp}"
                                    LineBreakMode="WordWrap"
                                    CommandParameter="{Binding AssistantConversationStarterHelp}"
                                    Clicked="OnConversationStarterClicked" Style="{StaticResource GhostButton}"
                                    SemanticProperties.Hint="{Binding AssistantConversationStarterHint}"
                                    BackgroundColor="{StaticResource AccentSoft}" BorderWidth="1" BorderColor="{StaticResource Line}"
                                    CornerRadius="12" TextColor="{StaticResource Ink}" FontSize="13"
                                    Padding="12,10" MinimumHeightRequest="48" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>

        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="8" Padding="0,4,0,10">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8" Padding="4,4"
                  IsVisible="{Binding ShowGlobalLoading}">
                <ActivityIndicator IsRunning="{Binding ShowGlobalLoading}" Color="{StaticResource Accent}"
                                   WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding AssistantConversationThinking}" FontSize="12"
                       TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        IsVisible="{Binding IsSecondaryMenuVisible}"
                        BindableLayout.ItemsSource="{Binding SecondaryMenuOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                        <Button Text="{Binding Label}"
                                Clicked="OnGuidedOptionClicked"
                                Style="{StaticResource GhostButton}"
                                TextColor="{StaticResource Ink}"
                                FontSize="12"
                                Padding="12,8"
                                MinimumHeightRequest="48"
                                Margin="0,0,8,6" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Button Text="{Binding WriteRequestText, StringFormat='✎  {0}'}"
                    Clicked="OnWriteConversationClicked" Style="{StaticResource GhostButton}"
                    BorderWidth="1" BorderColor="{StaticResource Line}" CornerRadius="12"
                    MinimumHeightRequest="48" FontSize="13" TextColor="{StaticResource Accent}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFreeTextVisible}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Border Padding="10,6" BackgroundColor="{StaticResource Paper}"
                    Stroke="{StaticResource Line}" StrokeThickness="1" IsVisible="{Binding IsFreeTextVisible}">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
                    <Entry x:Name="ConversationMessageInput" Text="{Binding MessageText}"
                           Placeholder="{Binding AssistantConversationMessagePlaceholder}"
                           ReturnType="Send" ReturnCommand="{Binding SendMessageCommand}"
                           HandlerChanged="OnConversationInputHandlerChanged"
                           BackgroundColor="Transparent" TextColor="{StaticResource Ink}"
                           PlaceholderColor="{StaticResource Muted}" MinimumHeightRequest="48" FontSize="14" />
                    <ImageButton Grid.Column="1" Source="today_arrow.svg"
                                 Command="{Binding SendMessageCommand}" Style="{StaticResource AssistantIconAction}"
                                 BackgroundColor="{StaticResource Accent}" CornerRadius="14" VerticalOptions="Center"
                                 SemanticProperties.Description="{Binding SendButtonText}" ToolTipProperties.Text="{Binding SendButtonText}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>

    <Grid Padding="28,28,28,24"
          InputTransparent="{Binding HasSelectedDetailCard}"
          IsVisible="{Binding ShowAssistantHome}">
        <ScrollView>
            <VerticalStackLayout Spacing="24">
                <VerticalStackLayout Spacing="8">
                    <Label Text="YUKU · JAPAN" CharacterSpacing="4" FontSize="11" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding AssistantTitle}" FontFamily="serif" FontSize="36"
                           SemanticProperties.HeadingLevel="Level1" TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding AssistantHomeIntro}"
                           FontSize="14" TextColor="{StaticResource InkSoft}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="16">
                    <Border Padding="16,10" BackgroundColor="{StaticResource Paper}" Stroke="{StaticResource Line}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding AssistantForDay}" CharacterSpacing="2" FontSize="10"
                                       TextColor="{StaticResource EditorialAccentText}" />
                                <Label Text="{Binding AssistantContext}" FontSize="14" TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="⌄" FontSize="23"
                                   TextColor="{StaticResource Muted}" VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center" WidthRequest="28" />
                            <DatePicker Grid.ColumnSpan="2" Date="{Binding PlanningDate}"
                                        DateSelected="OnAssistantDateSelected"
                                        MinimumDate="{Binding AssistantMinimumDate}"
                                        MaximumDate="{Binding AssistantMaximumDate}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Opacity="0" HorizontalOptions="Fill" VerticalOptions="Fill"
                                        SemanticProperties.Description="{Binding AssistantChooseDate}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="10" Margin="0,12,0,0">
                        <Button Text="{Binding AssistantCompleteDay}" Command="{Binding OpenCompleteDayCommand}" IsVisible="{Binding CanPlanItinerary}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Paper}"
                                CornerRadius="14" FontSize="17" FontFamily="OpenSansSemibold"
                                MinimumHeightRequest="62" />
                        <Label Text="{Binding AssistantCompleteDayHelp}" IsVisible="{Binding CanPlanItinerary}"
                               FontSize="12" TextColor="{StaticResource Muted}" />
                        <Border Style="{StaticResource EditorialCard}" Padding="14,10" IsEnabled="{Binding IsNotBusy}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenFreeTimeCommand}" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,48" ColumnSpacing="9" MinimumHeightRequest="48">
                                <Image Source="express_time.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding AssistantSearchExpressTitle}" FontSize="16"
                                       TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                <ImageButton Grid.Column="2" Source="today_arrow_dark.svg" Command="{Binding OpenFreeTimeCommand}"
                                             Style="{StaticResource AssistantIconAction}"
                                             SemanticProperties.Description="{Binding AssistantFreeTime}" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding AssistantFreeTimeHelp}" FontSize="12"
                               TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                        <Button Text="{Binding AssistantFindPlace}" Command="{Binding OpenQuickSearchCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource Paper}" TextColor="{StaticResource Ink}"
                                BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="14"
                                FontSize="16" MinimumHeightRequest="58" Margin="0,12,0,0" />
                        <Button Text="{Binding AssistantAsk}" Command="{Binding OpenAssistantConversationCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource Paper}" TextColor="{StaticResource Ink}"
                                BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="14"
                                FontSize="16" MinimumHeightRequest="58" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                           FontSize="13" TextColor="{StaticResource InkSoft}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           FontSize="13" TextColor="{StaticResource Rose}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding AssistantQuotaNote}" IsVisible="{Binding ShowAssistantQuotaNote}"
                           FontSize="12" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

    <Grid Padding="28,26,28,20" RowDefinitions="Auto,*,Auto" RowSpacing="12"
          InputTransparent="{Binding HasSelectedDetailCard}"
          IsVisible="{Binding ShowAssistantSearch}">
        <Grid ColumnDefinitions="48,*" ColumnSpacing="8">
            <Button Text="‹" Command="{Binding ReturnAssistantHomeCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Ink}" FontSize="28"
                    SemanticProperties.Description="{Binding AssistantBackHome}"
                    MinimumWidthRequest="48" MinimumHeightRequest="48" />
            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <Label Text="{Binding AssistantSearchTitle}" FontFamily="serif" FontSize="27"
                       SemanticProperties.HeadingLevel="Level1" TextColor="{StaticResource Ink}" />
                <Label Text="{Binding AssistantContext}" FontSize="12" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="0,10,0,8">
                <Label Text="{Binding AssistantSearchHelp}"
                       FontSize="13" TextColor="{StaticResource InkSoft}" />
                <Label Text="{Binding FreeTimeInterestQuestion}" IsVisible="{Binding ShowFreeTimeInterests}"
                       FontFamily="serif" FontSize="25" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                <Label Text="{Binding AssistantInterests}" FontSize="16" FontAttributes="Bold"
                       IsVisible="{Binding IsStandardQuickSearch}"
                       SemanticProperties.HeadingLevel="Level2" TextColor="{StaticResource Ink}" />
                <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding QuickCategories}" IsVisible="{Binding ShowQuickInterests}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                            <Button Text="{Binding DisplayLabel}" Clicked="OnQuickCriterionClicked"
                                    BackgroundColor="{StaticResource Paper}" TextColor="{StaticResource Ink}"
                                    BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="12"
                                    FontSize="12" Padding="12,8" MinimumHeightRequest="48" Margin="0,0,8,8">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="BorderColor" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Border Style="{StaticResource EditorialCard}" Padding="0"
                        BackgroundColor="{StaticResource AccentSoft}" Stroke="{StaticResource EditorialLine}"
                        IsVisible="{Binding ShowFreeTimeInterests}" IsEnabled="{Binding IsNotBusy}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding FreeTimeSurpriseSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Gold}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid ColumnDefinitions="32,*,24" ColumnSpacing="10" Padding="14,12"
                              InputTransparent="True" MinimumHeightRequest="64">
                            <Image Source="express_surprise.svg" WidthRequest="24" HeightRequest="24"
                                   VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding FreeTimeSurprise}" FontFamily="serif" FontSize="18"
                                       TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding FreeTimeSurpriseHelp}" FontSize="13"
                                       TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="today_arrow_dark.svg" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding FreeTimeSurpriseSelected}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Image Grid.Column="2" Source="planner_select.svg" WidthRequest="20" HeightRequest="20"
                                   IsVisible="{Binding FreeTimeSurpriseSelected}" VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                        </Grid>
                        <Button Command="{Binding SurpriseFreeTimeCommand}" Text="" BackgroundColor="Transparent"
                                BorderWidth="0" CornerRadius="16" Padding="0" MinimumHeightRequest="48"
                                SemanticProperties.Description="{Binding FreeTimeSurprise}"
                                SemanticProperties.Hint="{Binding FreeTimeSurpriseHelp}" />
                    </Grid>
                </Border>
                <VerticalStackLayout IsVisible="{Binding ShowFreeTimeArea}" Spacing="14" IsEnabled="{Binding IsNotBusy}">
                    <Label Text="{Binding FreeTimeAreaQuestion}" FontFamily="serif" FontSize="25"
                           TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                    <Border Style="{StaticResource EditorialCard}" Padding="14,10">
                        <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding FreeTimeCurrentAreaSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Gold}" /><Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                        </DataTrigger></Border.Triggers>
                        <Grid ColumnDefinitions="*,48" ColumnSpacing="8" MinimumHeightRequest="48">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseFreeTimeCurrentAreaCommand}" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding FreeTimeCurrentArea}" FontSize="16" TextColor="{StaticResource Ink}" />
                                <Label Text="{Binding FreeTimeCurrentAreaHelp}" FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1" Source="tab_map.svg" Command="{Binding ChooseFreeTimeCurrentAreaCommand}"
                                         Style="{StaticResource AssistantIconAction}" SemanticProperties.Description="{Binding FreeTimeCurrentArea}" />
                        </Grid>
                    </Border>
                    <Border IsVisible="{Binding HasFreeTimeNextPlan}" Style="{StaticResource EditorialCard}" Padding="14,10">
                        <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding FreeTimeNextAreaSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Gold}" /><Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                        </DataTrigger></Border.Triggers>
                        <Grid ColumnDefinitions="*,48" ColumnSpacing="8" MinimumHeightRequest="48">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseFreeTimeNextAreaCommand}" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding FreeTimeNextArea}" FontSize="16" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding FreeTimeNextAreaHelp}" FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1" Source="tab_trip.svg" Command="{Binding ChooseFreeTimeNextAreaCommand}"
                                         Style="{StaticResource AssistantIconAction}" SemanticProperties.Description="{Binding FreeTimeNextArea}" />
                        </Grid>
                    </Border>
                    <Button Text="{Binding FreeTimeCityFallback}" Command="{Binding ChooseFreeTimeCityAreaCommand}"
                            IsVisible="{Binding CanUseFreeTimeCityFallback}" BackgroundColor="Transparent"
                            TextColor="{StaticResource Accent}" MinimumHeightRequest="48" LineBreakMode="WordWrap" />
                    <Label Text="{Binding FreeTimeAreaSummary}" FontSize="13" TextColor="{StaticResource EditorialAccentText}" LineBreakMode="WordWrap" />
                    <Border Style="{StaticResource EditorialCard}" Padding="14">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding FreeTimeDurationLabel}" FontSize="13" TextColor="{StaticResource EditorialMuted}" />
                            <Picker ItemsSource="{Binding FreeTimeDurations}" SelectedIndex="{Binding FreeTimeDurationIndex}"
                                    Title="{Binding FreeTimeDurationLabel}" MinimumHeightRequest="48" />
                            <Label Text="{Binding FreeTimeWindowSummary}" FontSize="14" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding FreeTimeSoonNote}" IsVisible="{Binding HasFreeTimeSoonNote}"
                                   FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding FreeTimeNextFixedNote}" IsVisible="{Binding HasFreeTimeNextFixedNote}"
                                   FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <Label Text="{Binding AssistantOptionalBudget}" FontSize="15" FontAttributes="Bold"
                       IsVisible="{Binding IsStandardQuickSearch}"
                       SemanticProperties.HeadingLevel="Level2" TextColor="{StaticResource Ink}" />
                <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding QuickBudgets}" IsVisible="{Binding IsStandardQuickSearch}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                            <Button Text="{Binding DisplayLabel}" Clicked="OnQuickCriterionClicked"
                                    BackgroundColor="{StaticResource Paper}" TextColor="{StaticResource Ink}"
                                    BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="12"
                                    FontSize="12" Padding="12,8" MinimumHeightRequest="48" Margin="0,0,8,8">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="BorderColor" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="{Binding AssistantOptionalWalk}" FontSize="15" FontAttributes="Bold"
                       IsVisible="{Binding IsStandardQuickSearch}"
                       SemanticProperties.HeadingLevel="Level2" TextColor="{StaticResource Ink}" />
                <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding QuickWalking}" IsVisible="{Binding IsStandardQuickSearch}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                            <Button Text="{Binding DisplayLabel}" Clicked="OnQuickCriterionClicked"
                                    BackgroundColor="{StaticResource Paper}" TextColor="{StaticResource Ink}"
                                    BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="12"
                                    FontSize="12" Padding="12,8" MinimumHeightRequest="48" Margin="0,0,8,8">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="BorderColor" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="7">
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding ShowFreeTimeCancel}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                <Button Text="{Binding FreeTimeCancel}" Command="{Binding CancelFreeTimeCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Accent}" MinimumHeightRequest="48" />
            </HorizontalStackLayout>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                   FontSize="12" TextColor="{StaticResource Accent}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   FontSize="12" TextColor="{StaticResource Rose}" />
            <Label Text="{Binding AssistantSearchQuotaNote}" IsVisible="{Binding ShowAssistantQuotaNote}"
                   FontSize="12" TextColor="{StaticResource Muted}" />
            <Button Text="{Binding FreeTimeRestart}" Command="{Binding OpenFreeTimeCommand}"
                    IsVisible="{Binding FreeTimeNeedsRestart}" BackgroundColor="Transparent"
                    TextColor="{StaticResource Accent}" MinimumHeightRequest="48" />
            <Button Text="{Binding AssistantSearchAction}" Command="{Binding SubmitQuickSearchCommand}"
                    IsEnabled="{Binding CanSubmitQuickSearch}"
                    BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Paper}"
                    CornerRadius="14" MinimumHeightRequest="54" FontFamily="OpenSansSemibold" />
        </VerticalStackLayout>
    </Grid>

    <Grid Padding="28,26,28,18" RowDefinitions="Auto,*,Auto" RowSpacing="13"
          InputTransparent="{Binding HasSelectedDetailCard}"
          IsVisible="{Binding ShowAssistantProposal}">
        <Grid ColumnDefinitions="48,*" ColumnSpacing="8">
            <Button Text="‹" Command="{Binding ReturnAssistantHomeCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Ink}" FontSize="28"
                    SemanticProperties.Description="{Binding AssistantBackHome}"
                    MinimumWidthRequest="48" MinimumHeightRequest="48" />
            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <Label Text="{Binding AssistantProposalTitle}" FontFamily="serif" FontSize="29"
                       SemanticProperties.HeadingLevel="Level1" TextColor="{StaticResource Ink}" />
                <Label Text="{Binding AssistantContext}" FontSize="12" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding ProposalRows}" SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
        <CollectionView.Header>
        <VerticalStackLayout Spacing="6" Padding="0,0,0,14">
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding ShowFreeTimeCancel}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                <Button Text="{Binding FreeTimeCancel}" Command="{Binding CancelFreeTimeCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Accent}" MinimumHeightRequest="48" />
            </HorizontalStackLayout>
            <Button Text="{Binding FreeTimeRestart}" Command="{Binding OpenFreeTimeCommand}"
                    IsVisible="{Binding FreeTimeNeedsRestart}" BackgroundColor="Transparent"
                    TextColor="{StaticResource Accent}" MinimumHeightRequest="48" />
            <Label Text="{Binding FreeTimeWindowSummary}" IsVisible="{Binding IsFreeTimeSearch}"
                   FontSize="13" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
            <Label Text="{Binding FreeTimeAreaSummary}" IsVisible="{Binding IsFreeTimeSearch}"
                   FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
            <Label Text="{Binding FreeTimeSoonNote}" IsVisible="{Binding HasFreeTimeSoonNote}"
                   FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
            <Label Text="{Binding FreeTimeEstimate}" IsVisible="{Binding IsFreeTimeSearch}"
                   FontSize="12" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
            <Label Text="{Binding ProposalMessage}" FontSize="13"
                   MaxLines="3" LineBreakMode="TailTruncation" TextColor="{StaticResource InkSoft}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   FontSize="12" TextColor="{StaticResource Rose}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                   FontSize="12" TextColor="{StaticResource Accent}" />
        </VerticalStackLayout>
        </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="{Binding AssistantNoIdeas}"
                       FontSize="14" TextColor="{StaticResource Muted}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:AssistantProposalRow">
                    <Border Padding="13,11" Margin="0,0,0,9" BackgroundColor="{StaticResource Paper}"
                            Stroke="{StaticResource Line}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,48" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8" MinimumHeightRequest="56">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding When}" FontSize="11" TextColor="{StaticResource EditorialAccentText}" />
                                <Label Text="{Binding Title}" FontSize="15" MaxLines="2"
                                       TextColor="{StaticResource Ink}" />
                                <Label Text="{Binding Suggestion.Subtitle}" FontSize="12"
                                       TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Reason}" IsVisible="{Binding HasReason}"
                                       FontSize="12" MaxLines="2" TextColor="{StaticResource InkSoft}" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1" Source="action_info.svg" Clicked="OnProposalRowClicked"
                                         Style="{StaticResource AssistantIconAction}" VerticalOptions="Start"
                                         SemanticProperties.Description="{Binding Title}"
                                         ToolTipProperties.Text="{Binding Title}" />
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Status}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding IsSuggestion}">
                                    <ActivityIndicator IsRunning="{Binding Suggestion.IsSearchingAlternative}" IsVisible="{Binding Suggestion.IsSearchingAlternative}"
                                                       WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                                    <ActivityIndicator IsRunning="{Binding Suggestion.IsSaving}" IsVisible="{Binding Suggestion.IsSaving}"
                                                       WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                                    <ImageButton Source="action_alternative.svg" Clicked="OnReplaceProposalClicked"
                                                 IsEnabled="{Binding Suggestion.CanFindAlternative}" Style="{StaticResource AssistantIconAction}"
                                                 SemanticProperties.Description="{Binding Suggestion.AnotherOptionLabel}" ToolTipProperties.Text="{Binding Suggestion.AnotherOptionLabel}" />
                                    <ImageButton Source="{Binding Suggestion.SaveIcon}" Clicked="OnSaveProposalClicked"
                                     IsVisible="{Binding BindingContext.CanPlanItinerary, Source={x:Reference PageRoot}}"
                                                 IsEnabled="{Binding Suggestion.CanSave}" Style="{StaticResource AssistantIconAction}"
                                                 BackgroundColor="{StaticResource Accent}"
                                                 SemanticProperties.Description="{Binding Suggestion.SaveButtonText}" ToolTipProperties.Text="{Binding Suggestion.SaveButtonText}" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Suggestion.FeedbackStatusMessage}"
                                   IsVisible="{Binding Suggestion.HasFeedbackStatus}" FontSize="12" TextColor="{StaticResource InkSoft}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="2" Text="{Binding AssistantAskAboutDay}"
                IsVisible="{Binding IsStandardQuickSearch}"
                Command="{Binding OpenAssistantConversationCommand}"
                BackgroundColor="Transparent" TextColor="{StaticResource Accent}"
                MinimumHeightRequest="48" FontSize="13" />
        <Button Grid.Row="2" Text="{Binding FreeTimeEditSearch}"
                IsVisible="{Binding IsFreeTimeSearch}" Command="{Binding EditFreeTimeSearchCommand}"
                BackgroundColor="Transparent" TextColor="{StaticResource Accent}"
                MinimumHeightRequest="48" FontSize="13" />
    </Grid>

    <Grid IsVisible="{Binding HasSelectedDetailCard}" BackgroundColor="#80000000">
        <Border BindingContext="{Binding SelectedDetailCard}" x:DataType="viewModels:TravelChatCardViewModel"
                VerticalOptions="End" Padding="24,10,24,20" BackgroundColor="{StaticResource Paper}"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0" /></Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <BoxView HeightRequest="4" WidthRequest="36" CornerRadius="2"
                         HorizontalOptions="Center" BackgroundColor="{StaticResource Line}" />
                <ScrollView Grid.Row="1" MaximumHeightRequest="430" VerticalOptions="Start"
                            VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
                        <Label Text="{Binding Title}" FontFamily="serif" FontSize="26"
                               VerticalTextAlignment="Center" LineHeight="1.05"
                               SemanticProperties.HeadingLevel="Level2" TextColor="{StaticResource Ink}" />
                        <ImageButton Grid.Column="1" Source="action_close.svg" Clicked="OnCloseDetailClicked"
                                SemanticProperties.Description="{Binding CloseLabel}"
                                ToolTipProperties.Text="{Binding CloseLabel}" Style="{StaticResource AssistantIconAction}" />
                    </Grid>
                    <Label Text="{Binding SummaryLine}" FontSize="12" TextColor="{StaticResource EditorialAccentText}"
                           Margin="0,12,0,0" />
                    <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource EditorialMuted}"
                           LineBreakMode="WordWrap" Margin="0,6,0,0" />
                    <Label Text="{Binding TimeLabel}" FontSize="12" TextColor="{StaticResource EditorialAccentText}"
                           IsVisible="{Binding BindingContext.IsFreeTimeSearch, Source={x:Reference PageRoot}}"
                           Margin="0,6,0,0" />
                    <Label Text="{Binding Description}" FontSize="14" LineHeight="1.4"
                           TextColor="{StaticResource InkSoft}" Margin="0,18,0,0" />
                    <VerticalStackLayout Spacing="6" Margin="0,16,0,0"
                                         BindableLayout.ItemsSource="{Binding WhyItFits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="system:String">
                                <Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource Muted}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,12,0,0"
                                         BindableLayout.ItemsSource="{Binding WarningLabels}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="system:String">
                                <Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource Rose}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding FeedbackStatusMessage}" IsVisible="{Binding HasFeedbackStatus}"
                           FontSize="12" TextColor="{StaticResource InkSoft}" Margin="0,12,0,0" />
                </VerticalStackLayout>
                </ScrollView>
                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding CanChoosePeriod}">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding BindingContext.CanPlanItinerary, Source={x:Reference PageRoot}}" Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Label Text="{Binding PeriodLabel}" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource InkSoft}" />
                        <Picker Grid.Column="1" Title="{Binding PeriodLabel}" ItemsSource="{Binding PeriodOptions}"
                                SelectedIndex="{Binding SelectedPeriodIndex, Mode=TwoWay}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}"
                             Margin="0,0,0,8" />
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}"
                                           WidthRequest="24" HeightRequest="24" Color="{StaticResource Accent}" />
                        <ImageButton Source="action_alternative.svg" Clicked="OnReplaceDetailClicked"
                                     IsEnabled="{Binding CanFindAlternative}" Style="{StaticResource AssistantIconAction}"
                                     SemanticProperties.Description="{Binding AnotherOptionLabel}" ToolTipProperties.Text="{Binding AnotherOptionLabel}" />
                        <ImageButton Source="today_adjust.svg" Clicked="OnAdjustDetailClicked"
                                     IsVisible="{Binding ShowPreferenceAdjustment}" Style="{StaticResource AssistantIconAction}"
                                     SemanticProperties.Description="{Binding AdjustLabel}" ToolTipProperties.Text="{Binding AdjustLabel}" />
                        <ImageButton Source="{Binding SaveIcon}" Clicked="OnSaveDetailClicked"
                                     IsVisible="{Binding BindingContext.CanPlanItinerary, Source={x:Reference PageRoot}}"
                                     IsEnabled="{Binding CanSave}" Style="{StaticResource AssistantIconAction}" BackgroundColor="{StaticResource Accent}"
                                     SemanticProperties.Description="{Binding SaveButtonText}" ToolTipProperties.Text="{Binding SaveButtonText}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
