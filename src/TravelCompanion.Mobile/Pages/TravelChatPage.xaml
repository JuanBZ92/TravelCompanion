<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.TravelChatPage"
             x:Name="PageRoot"
             x:DataType="viewModels:TravelChatViewModel"
             Title="Assistant"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">

    <Grid Padding="28,26,28,0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding AssistantEyebrow}"
                       CharacterSpacing="6"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D" />
                <Label Text="{Binding AssistantTitle}"
                       FontFamily="serif"
                       FontSize="34"
                       TextColor="#1A1714" />
            </VerticalStackLayout>

            <DatePicker Grid.Column="1"
                        Date="{Binding PlanningDate}"
                        FontSize="13"
                        HorizontalOptions="End"
                        WidthRequest="138" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Padding="14,12"
                    BackgroundColor="#F6F1EA"
                    Stroke="#D8CFC4"
                    StrokeThickness="1"
                    IsVisible="{Binding HasMissingContext}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding MissingContextMessage}"
                           FontSize="13"
                           LineHeight="1.35"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding MissingContextSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="system:String">
                                <Border Style="{StaticResource Chip}"
                                        Margin="0,0,8,6"
                                        MaximumWidthRequest="220">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSuggestedReplyTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource Paper}}" />
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding Messages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TravelChatMessageViewModel">
                            <VerticalStackLayout Spacing="8">
                                <Border Padding="14,11"
                                        MaximumWidthRequest="620"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
                                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource NightLine}}"
                                        StrokeThickness="1">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsFromUser}"
                                                     Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Text}"
                                           FontSize="14"
                                           LineHeight="1.35"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsFromUser}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource PrimaryDarkText}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding HasCards}"
                                                     BindableLayout.ItemsSource="{Binding Cards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TravelChatCardViewModel">
                                            <Border Style="{StaticResource Card}"
                                                    Padding="14">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="21"
                                                           FontFamily="serif"
                                                           TextColor="#1A1714"
                                                           MaxLines="2" />
                                                    <Label Grid.Row="1"
                                                           Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gold}, Dark={StaticResource GoldSoft}}"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Grid.Row="2"
                                                           Text="{Binding Description}"
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                                    <FlexLayout Grid.Row="3"
                                                                Direction="Row"
                                                                Wrap="Wrap"
                                                                AlignItems="Start">
                                                        <Border Style="{StaticResource GoldPill}"
                                                                Margin="0,0,6,6"
                                                                IsVisible="{Binding HasTimeLabel}">
                                                            <Label Text="{Binding TimeLabel}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                                        </Border>
                                                        <Border Style="{StaticResource GoldPill}"
                                                                Margin="0,0,6,6"
                                                                IsVisible="{Binding HasCostLabel}">
                                                            <Label Text="{Binding CostLabel}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                                        </Border>
                                                        <Border Style="{StaticResource GoldPill}"
                                                                Margin="0,0,6,6"
                                                                IsVisible="{Binding HasDistanceLabel}">
                                                            <Label Text="{Binding DistanceLabel}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                                        </Border>
                                                        <Border Style="{StaticResource GoldPill}"
                                                                Margin="0,0,6,6"
                                                                IsVisible="{Binding HasWalkingLabel}">
                                                            <Label Text="{Binding WalkingLabel}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                                        </Border>
                                                    </FlexLayout>
                                                    <FlexLayout Grid.Row="4"
                                                                Direction="Row"
                                                                Wrap="Wrap"
                                                                AlignItems="Start"
                                                                IsVisible="{Binding HasTags}"
                                                                BindableLayout.ItemsSource="{Binding TagActions}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:TravelChatTagActionViewModel">
                                                                <Border Style="{StaticResource Chip}"
                                                                        Padding="8,5"
                                                                        Margin="0,0,6,4">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnTagActionTapped" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding Label}"
                                                                           FontSize="11"
                                                                           TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource NightMuted}}"
                                                                           MaxLines="1"
                                                                           LineBreakMode="TailTruncation" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                    <VerticalStackLayout Grid.Row="5"
                                                                         Spacing="4"
                                                                         IsVisible="{Binding HasReasons}"
                                                                         BindableLayout.ItemsSource="{Binding WhyItFits}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="system:String">
                                                                <Label Text="{Binding ., StringFormat='- {0}'}"
                                                                       FontSize="12"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Row="6"
                                                                         Spacing="4"
                                                                         IsVisible="{Binding HasWarnings}"
                                                                         BindableLayout.ItemsSource="{Binding WarningLabels}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="system:String">
                                                                <Label Text="{Binding .}"
                                                                       FontSize="12"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Rose}, Dark={StaticResource GoldSoft}}" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <FlexLayout Grid.Row="7"
                                                                Direction="Row"
                                                                Wrap="Wrap"
                                                                AlignItems="Start"
                                                                Margin="0,2,0,0">
                                                        <Button Text="{Binding DetailButtonText}"
                                                                Clicked="OnOpenRecommendationDetailClicked"
                                                                IsVisible="{Binding HasDetailAction}"
                                                                Style="{StaticResource GhostButton}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                        <Button Text="{Binding SaveButtonText}"
                                                                Clicked="OnSaveItineraryItemClicked"
                                                                IsEnabled="{Binding CanSave}"
                                                                IsVisible="{Binding HasRecommendationId}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                        <Button Text="{Binding NearbyButtonText}"
                                                                Clicked="OnRequestLessWalkingClicked"
                                                                Style="{StaticResource GhostButton}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                        <Button Text="{Binding ReplaceButtonText}"
                                                                Clicked="OnReplaceRecommendationClicked"
                                                                Style="{StaticResource GhostButton}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                        <Button Text="{Binding UsefulButtonText}"
                                                                Clicked="OnMarkUsefulClicked"
                                                                IsVisible="{Binding HasFeedbackActions}"
                                                                Style="{StaticResource GhostButton}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                        <Button Text="{Binding NotUsefulButtonText}"
                                                                Clicked="OnMarkNotUsefulClicked"
                                                                IsVisible="{Binding HasFeedbackActions}"
                                                                Style="{StaticResource GhostButton}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                        <Button Text="{Binding HideSimilarButtonText}"
                                                                Clicked="OnHideSimilarClicked"
                                                                IsVisible="{Binding HasFeedbackActions}"
                                                                Style="{StaticResource GhostButton}"
                                                                FontSize="12"
                                                                Padding="10,7"
                                                                MinimumHeightRequest="34"
                                                                Margin="0,0,6,6" />
                                                    </FlexLayout>
                                                    <Label Grid.Row="8"
                                                           Text="{Binding FeedbackStatusMessage}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}"
                                                           IsVisible="{Binding HasFeedbackStatus}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding ShowEmptyState}"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14"
                                     Padding="0,6,0,12"
                                     HorizontalOptions="Center"
                                     MaximumWidthRequest="640">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding EmptyStateTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                        <Label Text="{Binding EmptyStateSubtitle}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding GuideSections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TravelChatGuideSectionViewModel">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Header}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                                    <FlexLayout Direction="Row"
                                                Wrap="Wrap"
                                                AlignItems="Start"
                                                BindableLayout.ItemsSource="{Binding Actions}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:TravelChatGuideActionViewModel">
                                                <Border Style="{StaticResource Chip}"
                                                        Padding="10,6"
                                                        Margin="0,0,6,6"
                                                        MaximumWidthRequest="180">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnGuideActionTapped" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding Title}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="10" Padding="0,0,0,14">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8"
                                       BindableLayout.ItemsSource="{Binding SuggestedReplies}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="system:String">
                            <Border Style="{StaticResource Chip}"
                                    MaximumWidthRequest="220">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSuggestedReplyTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Padding="12,0"
                        BackgroundColor="#F6F1EA"
                        Stroke="#D8CFC4"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding MessageText}"
                           Placeholder="{Binding MessagePlaceholder}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           FontSize="14" />
                </Border>

                <Button Grid.Column="1"
                        Text="{Binding SendButtonText}"
                        Command="{Binding SendMessageCommand}"
                        FontSize="14"
                        Padding="16,10"
                        MinimumWidthRequest="74"
                        MinimumHeightRequest="44" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               WidthRequest="22"
                               HeightRequest="22" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
