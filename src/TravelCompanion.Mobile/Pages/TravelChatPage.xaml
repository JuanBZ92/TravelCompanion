<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.TravelChatPage"
             x:Name="PageRoot"
             x:DataType="viewModels:TravelChatViewModel"
             Title="Assistant"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">

    <Grid Padding="28,26,28,0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding AssistantEyebrow}"
                       CharacterSpacing="6"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D" />
                <Label Text="{Binding AssistantTitle}"
                       FontFamily="serif"
                       FontSize="34"
                       SemanticProperties.HeadingLevel="Level1"
                       TextColor="#1A1714" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 HorizontalOptions="End">
                <DatePicker Date="{Binding PlanningDate}"
                            FontSize="13"
                            TextColor="#1A1714"
                            HorizontalOptions="End"
                            WidthRequest="138" />
                <Label Text="{Binding LastUpdatedMessage}"
                       IsVisible="{Binding HasLastUpdated}"
                       HorizontalTextAlignment="End"
                       FontSize="10"
                       TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Padding="14,12"
                    BackgroundColor="#F6F1EA"
                    Stroke="#D8CFC4"
                    StrokeThickness="1"
                    IsVisible="{Binding HasMissingContext}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding MissingContextMessage}"
                           FontSize="13"
                           LineHeight="1.35"
                           TextColor="{StaticResource Ink}" />
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding MissingContextSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="system:String">
                                <Border Style="{StaticResource Chip}"
                                        Margin="0,0,8,6"
                                        BackgroundColor="#F6F1EA"
                                        Stroke="#D8CFC4"
                                        MaximumWidthRequest="220">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSuggestedReplyTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           FontSize="12"
                                           TextColor="{StaticResource Ink}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource NoticePanel}"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{StaticResource Accent}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{StaticResource Rose}" />
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="14">
            <Grid ColumnDefinitions="2,*"
                  ColumnSpacing="16"
                  IsVisible="{Binding HasGuidedQuestion}">
                <BoxView WidthRequest="2"
                         VerticalOptions="Fill"
                         BackgroundColor="{StaticResource Gold}" />
                <VerticalStackLayout Grid.Column="1" Spacing="16">
                    <Label Text="{Binding GuidedQuestionText}"
                           FontSize="24"
                           FontFamily="serif"
                           LineHeight="1.2"
                           SemanticProperties.HeadingLevel="Level2"
                           TextColor="{StaticResource Ink}" />
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding GuidedOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                                <Button Text="{Binding DisplayLabel}"
                                        Clicked="OnGuidedOptionClicked"
                                        FlexLayout.Basis="48%"
                                        TextColor="{StaticResource Ink}"
                                        BackgroundColor="{StaticResource AccentSoft}"
                                        BorderColor="#D8CFC4"
                                        BorderWidth="1"
                                        CornerRadius="0"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        Padding="12,10"
                                        MinimumHeightRequest="48"
                                        Margin="0,0,8,8" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Button Text="{Binding BackText, StringFormat='←  {0}'}"
                                Command="{Binding GoBackGuidedCommand}"
                                IsVisible="{Binding CanGoBack}"
                                SemanticProperties.Description="{Binding BackText}"
                                TextColor="{StaticResource Accent}"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                FontSize="12"
                                Padding="8,6"
                                MinimumHeightRequest="44" />
                        <Button Text="{Binding RestartText, StringFormat='↺  {0}'}"
                                Command="{Binding RestartGuidedCommand}"
                                IsVisible="{Binding CanRestartGuided}"
                                SemanticProperties.Description="{Binding RestartText}"
                                TextColor="{StaticResource Accent}"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                FontSize="12"
                                Padding="8,6"
                                MinimumHeightRequest="44" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Messages}"
                            IsVisible="{Binding HasMessages}"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TravelChatMessageViewModel">
                            <VerticalStackLayout Spacing="8">
                                <Border Padding="14,11"
                                        IsVisible="{Binding ShouldShowText}"
                                        MaximumWidthRequest="620"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{StaticResource Paper}"
                                        Stroke="{StaticResource Line}"
                                        StrokeThickness="1">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsFromUser}"
                                                     Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Text}"
                                           FontSize="14"
                                           LineHeight="1.35"
                                           TextColor="{StaticResource Ink}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsFromUser}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Paper}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding HasCards}"
                                                     BindableLayout.ItemsSource="{Binding Cards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TravelChatCardViewModel">
                                            <Border Style="{StaticResource Card}"
                                                    Padding="14"
                                                    BackgroundColor="#F6F1EA"
                                                    Stroke="#D8CFC4">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <Label Text="{Binding Title}"
                                                               FontSize="21"
                                                               FontFamily="serif"
                                                               TextColor="#1A1714"
                                                               MaxLines="2"
                                                               VerticalOptions="Center" />
                                                        <Button Grid.Column="1"
                                                                Text="ⓘ"
                                                                Command="{Binding ToggleDetailsCommand}"
                                                                SemanticProperties.Description="{Binding DetailButtonText}"
                                                                Style="{StaticResource GhostButton}"
                                                                TextColor="{StaticResource Ink}"
                                                                FontSize="18"
                                                                Padding="0"
                                                                MinimumWidthRequest="44"
                                                                MinimumHeightRequest="44"
                                                                VerticalOptions="Start" />
                                                    </Grid>
                                                    <Label Grid.Row="1"
                                                           Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Gold}"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Grid.Row="2"
                                                           Text="{Binding Description}"
                                                           FontSize="13"
                                                           TextColor="{StaticResource InkSoft}"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Grid.Row="3"
                                                           Text="{Binding SummaryLine}"
                                                           FontSize="12"
                                                           LineHeight="1.3"
                                                           TextColor="{StaticResource Gold}" />
                                                    <FlexLayout Grid.Row="4"
                                                                Direction="Row"
                                                                Wrap="Wrap"
                                                                AlignItems="Start"
                                                                IsVisible="{Binding IsDetailsVisible}"
                                                                BindableLayout.ItemsSource="{Binding TagActions}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:TravelChatTagActionViewModel">
                                                                <Border Style="{StaticResource Chip}"
                                                                        Padding="8,5"
                                                                        BackgroundColor="#F6F1EA"
                                                                        Stroke="#D8CFC4"
                                                                        Margin="0,0,6,4">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnTagActionTapped" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding Label}"
                                                                           FontSize="11"
                                                                           TextColor="{StaticResource InkSoft}"
                                                                           MaxLines="1"
                                                                           LineBreakMode="TailTruncation" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                    <VerticalStackLayout Grid.Row="5"
                                                                         Spacing="4"
                                                                         IsVisible="{Binding IsDetailsVisible}"
                                                                         BindableLayout.ItemsSource="{Binding WhyItFits}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="system:String">
                                                                <Label Text="{Binding ., StringFormat='- {0}'}"
                                                                       FontSize="12"
                                                                       TextColor="{StaticResource Muted}" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Row="6"
                                                                         Spacing="4"
                                                                         IsVisible="{Binding HasWarnings}"
                                                                         BindableLayout.ItemsSource="{Binding WarningLabels}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="system:String">
                                                                <Label Text="{Binding .}"
                                                                       FontSize="12"
                                                                       TextColor="{StaticResource Rose}" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <Grid Grid.Row="7"
                                                          ColumnDefinitions="*,*,*"
                                                          ColumnSpacing="8"
                                                          Margin="0,4,0,0">
                                                        <Button Text="{Binding SaveButtonText}"
                                                                Clicked="OnSaveItineraryItemClicked"
                                                                SemanticProperties.Description="{Binding SaveButtonText}"
                                                                IsEnabled="{Binding CanSave}"
                                                                IsVisible="{Binding CanEditItinerary, Source={RelativeSource AncestorType={x:Type viewModels:TravelChatViewModel}}, x:DataType=viewModels:TravelChatViewModel}"
                                                                TextColor="{StaticResource Ink}"
                                                                BackgroundColor="{StaticResource AccentSoft}"
                                                                BorderColor="{StaticResource Gold}"
                                                                BorderWidth="1"
                                                                CornerRadius="0"
                                                                FontFamily="OpenSansSemibold"
                                                                FontSize="13"
                                                                Padding="8,10"
                                                                MinimumHeightRequest="44" />
                                                        <Button Grid.Column="1"
                                                                Text="{Binding ReplaceButtonText}"
                                                                Clicked="OnReplaceRecommendationClicked"
                                                                SemanticProperties.Description="{Binding ReplaceButtonText}"
                                                                Style="{StaticResource GhostButton}"
                                                                TextColor="{StaticResource Ink}"
                                                                FontSize="13"
                                                                Padding="8,10"
                                                                MinimumHeightRequest="44" />
                                                        <Button Grid.Column="2"
                                                                Text="{Binding AdjustButtonText}"
                                                                Clicked="OnAdjustGuidedPlanClicked"
                                                                SemanticProperties.Description="{Binding AdjustButtonText}"
                                                                Style="{StaticResource GhostButton}"
                                                                TextColor="{StaticResource Ink}"
                                                                FontSize="13"
                                                                Padding="8,10"
                                                                MinimumHeightRequest="44" />
                                                    </Grid>
                                                    <Label Grid.Row="8"
                                                           Text="{Binding FeedbackStatusMessage}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Muted}"
                                                           IsVisible="{Binding HasFeedbackStatus}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="8" Padding="0,0,0,10">
            <BoxView HeightRequest="1"
                     HorizontalOptions="Fill"
                     BackgroundColor="{StaticResource Line}" />
            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                <Button Text="{Binding WriteRequestText, StringFormat='✎  {0}'}"
                        Command="{Binding ToggleFreeTextCommand}"
                        SemanticProperties.Description="{Binding WriteRequestText}"
                        TextColor="{StaticResource Accent}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        FontSize="13"
                        Padding="8,6"
                        MinimumHeightRequest="44"
                        Margin="0,0,8,6" />
                <Button Text="{Binding MenuText, StringFormat='•••  {0}'}"
                        Command="{Binding ToggleSecondaryMenuCommand}"
                        SemanticProperties.Description="{Binding MenuText}"
                        TextColor="{StaticResource Accent}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        FontSize="13"
                        Padding="8,6"
                        MinimumHeightRequest="44"
                        Margin="0,0,8,6" />
            </FlexLayout>

            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        IsVisible="{Binding IsSecondaryMenuVisible}"
                        BindableLayout.ItemsSource="{Binding SecondaryMenuOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TravelChatGuidedOptionViewModel">
                        <Button Text="{Binding Label}"
                                Clicked="OnGuidedOptionClicked"
                                Style="{StaticResource GhostButton}"
                                TextColor="{StaticResource Ink}"
                                FontSize="12"
                                Padding="12,8"
                                MinimumHeightRequest="44"
                                Margin="0,0,8,6" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding IsFreeTextVisible}">
                <Border Padding="12,0"
                        BackgroundColor="#F6F1EA"
                        Stroke="#D8CFC4"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding MessageText}"
                           Placeholder="{Binding MessagePlaceholder}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           TextColor="{StaticResource Ink}"
                           PlaceholderColor="{StaticResource Muted}"
                           FontSize="14" />
                </Border>

                <Button Grid.Column="1"
                        Text="{Binding SendButtonText}"
                        Command="{Binding SendMessageCommand}"
                        TextColor="{StaticResource Paper}"
                        BackgroundColor="{StaticResource Accent}"
                        FontSize="14"
                        Padding="16,10"
                        MinimumWidthRequest="74"
                        MinimumHeightRequest="44" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Accent}"
                               WidthRequest="22"
                               HeightRequest="22" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
