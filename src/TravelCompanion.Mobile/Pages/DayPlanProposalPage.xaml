<?xml version="1.0" encoding="utf-8" ?>
<pages:TripScopedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pages="clr-namespace:TravelCompanion.Mobile.Pages"
 xmlns:vm="clr-namespace:TravelCompanion.Mobile.ViewModels" xmlns:services="clr-namespace:TravelCompanion.Mobile.Services" x:Class="TravelCompanion.Mobile.Pages.DayPlanProposalPage"
 x:Name="ProposalRoot" x:DataType="vm:DayPlannerViewModel" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
 BackgroundColor="{StaticResource Mist}" SafeAreaEdges="All">
 <Grid Padding="24,8,24,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
  <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8">
    <ImageButton Source="planner_back.svg" Clicked="OnBackClicked" Style="{StaticResource EditorialIconButton}" SemanticProperties.Description="{Binding BackLabel}"/>
    <Label Grid.Column="1" Text="{Binding ResultTitle}" Style="{StaticResource EditorialHeading}" FontSize="25" VerticalTextAlignment="Center"/>
    <ImageButton Grid.Column="2" Source="itinerary_menu.svg" Clicked="OnMenuClicked" Style="{StaticResource EditorialIconButton}"
        SemanticProperties.Description="{Binding [UxMoreActions], Source={x:Static services:LocalizationResourceManager.Instance}}" IsEnabled="{Binding IsNotBusy}"/>
  </Grid>
  <Label x:Name="PlannerError" Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#9A493F" FontSize="14" LineBreakMode="WordWrap"/>
  <CollectionView Grid.Row="2" ItemsSource="{Binding Days}" IsGrouped="True" SelectionMode="None">
   <CollectionView.Header>
    <VerticalStackLayout Padding="0,4,0,8" Spacing="10">
     <Label Text="{Binding Destination}" FontSize="14" TextColor="{StaticResource EditorialAccentText}"/>
     <Label Text="{Binding ResultSummary}" FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap"/>
     <Label Text="{Binding ResultIntro}" Style="{StaticResource EditorialBody}"/>
     <Label Text="{Binding ResultExistingPlansSummary}" IsVisible="{Binding HasResultExistingPlansSummary}" FontSize="13" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap"/>
     <Label Text="{Binding UnavailableDays}" IsVisible="{Binding HasUnavailableDays}" FontSize="13" TextColor="{StaticResource Muted}"/>
     <Label Text="{Binding SelectionNotice}" FontSize="13" TextColor="{StaticResource Muted}">
      <Label.Triggers>
       <DataTrigger TargetType="Label" Binding="{Binding ShowComparison}" Value="True">
        <Setter Property="IsVisible" Value="False"/>
       </DataTrigger>
      </Label.Triggers>
     </Label>
     <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="#49634D" FontSize="14"/>
     <VerticalStackLayout IsVisible="{Binding ShowComparison}" Spacing="12">
      <Label Text="{Binding CompareLabel}" FontFamily="serif" FontSize="24" TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level2"/>
      <Border Style="{StaticResource EditorialCard}">
       <VerticalStackLayout Spacing="10">
        <Label Text="{Binding PreviousOptionLabel}" FontSize="16" TextColor="{StaticResource Ink}"/>
        <Label Text="{Binding PreviousPreview}" Style="{StaticResource EditorialBody}"/>
       </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource EditorialCard}">
       <VerticalStackLayout Spacing="10">
        <Label Text="{Binding CurrentOptionLabel}" FontSize="16" TextColor="{StaticResource Ink}"/>
        <Label Text="{Binding CurrentPreview}" Style="{StaticResource EditorialBody}"/>
       </VerticalStackLayout>
      </Border>
     </VerticalStackLayout>
    </VerticalStackLayout>
   </CollectionView.Header>
   <CollectionView.GroupHeaderTemplate>
    <DataTemplate x:DataType="vm:PlannerDayGroup">
     <VerticalStackLayout Padding="0,20,0,12" Spacing="5">
      <Grid ColumnDefinitions="*,48">
       <VerticalStackLayout Spacing="4">
        <Label Text="{Binding Title}" FontFamily="serif" FontSize="22" TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level2"/>
        <Label Text="{Binding Cities}" FontSize="13" TextColor="{StaticResource EditorialAccentText}"/>
       </VerticalStackLayout>
       <ImageButton Grid.Column="1" Source="planner_select.svg" Command="{Binding BindingContext.SelectDayCommand, Source={x:Reference ProposalRoot}}" CommandParameter="{Binding .}" Style="{StaticResource EditorialIconButton}" SemanticProperties.Description="{Binding SelectLabel}" IsEnabled="{Binding BindingContext.CanSelect, Source={x:Reference ProposalRoot}}"/>
      </Grid>
      <Label Text="{Binding EmptyMessage}" FontSize="12" TextColor="{StaticResource Muted}"/>
     </VerticalStackLayout>
    </DataTemplate>
   </CollectionView.GroupHeaderTemplate>
   <CollectionView.ItemTemplate>
    <DataTemplate x:DataType="vm:PlannerStopRow">
     <Border Style="{StaticResource EditorialCard}" Padding="12" Margin="0,0,0,10">
      <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8">
       <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelectRow}" MinimumHeightRequest="48" MinimumWidthRequest="48" SemanticProperties.Description="{Binding SelectDescription}" VerticalOptions="Start">
        <CheckBox.Triggers>
         <DataTrigger TargetType="CheckBox" Binding="{Binding BindingContext.CanSelect, Source={x:Reference ProposalRoot}}" Value="False">
          <Setter Property="IsEnabled" Value="False"/>
         </DataTrigger>
        </CheckBox.Triggers>
       </CheckBox>
       <VerticalStackLayout Grid.Column="1" Spacing="6">
        <Label Text="{Binding Moment}" FontSize="11" TextColor="{StaticResource EditorialAccentText}"/>
        <Label Text="{Binding Title}" FontFamily="serif" FontSize="21" TextColor="{StaticResource Ink}"/>
        <Label Text="{Binding Place}" IsVisible="{Binding HasPlace}" FontSize="13" TextColor="{StaticResource EditorialMuted}" LineBreakMode="WordWrap"/>
        <Label Text="{Binding Reason}" FontSize="13" TextColor="{StaticResource Muted}"/>
        <Label Text="{Binding Warnings}" IsVisible="{Binding HasWarnings}" FontSize="12" TextColor="#9A693F"/>
        <Label Text="{Binding SavedLabel}" IsVisible="{Binding IsSaved}" TextColor="#49634D" FontSize="12"/>
        <Label Text="{Binding ReplacingLabel}" IsVisible="{Binding IsReplacing}" TextColor="{StaticResource EditorialMuted}" FontSize="12"/>
        <Label Text="{Binding ReplacementNotice}" IsVisible="{Binding HasReplacementNotice}" TextColor="{StaticResource EditorialMuted}" FontSize="12" LineBreakMode="WordWrap"/>
       </VerticalStackLayout>
       <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Start">
        <ImageButton Source="action_info.svg" Command="{Binding BindingContext.OpenStopCommand, Source={x:Reference ProposalRoot}}"
         CommandParameter="{Binding .}" Style="{StaticResource EditorialIconButton}" SemanticProperties.Description="{Binding OpenDescription}"/>
        <Grid WidthRequest="48" HeightRequest="48">
         <Grid.Triggers>
          <DataTrigger TargetType="Grid" Binding="{Binding IsSaved}" Value="True">
           <Setter Property="IsVisible" Value="False"/>
          </DataTrigger>
         </Grid.Triggers>
         <ImageButton Source="action_alternative.svg"
          Command="{Binding BindingContext.ReplaceStopCommand, Source={x:Reference ProposalRoot}}" CommandParameter="{Binding .}"
          IsEnabled="{Binding CanReplaceRow}" Style="{StaticResource EditorialIconButton}"
          SemanticProperties.Description="{Binding ReplaceDescription}">
          <ImageButton.Triggers>
           <DataTrigger TargetType="ImageButton" Binding="{Binding IsReplacing}" Value="True">
            <Setter Property="IsVisible" Value="False"/>
           </DataTrigger>
           <DataTrigger TargetType="ImageButton" Binding="{Binding BindingContext.IsBusy, Source={x:Reference ProposalRoot}}" Value="True">
            <Setter Property="IsEnabled" Value="False"/>
           </DataTrigger>
          </ImageButton.Triggers>
         </ImageButton>
         <ActivityIndicator IsRunning="{Binding IsReplacing}" IsVisible="{Binding IsReplacing}"
          WidthRequest="24" HeightRequest="24" Color="{StaticResource Gold}"/>
        </Grid>
       </VerticalStackLayout>
      </Grid>
     </Border>
    </DataTemplate>
   </CollectionView.ItemTemplate>
  </CollectionView>
  <VerticalStackLayout Grid.Row="3" Spacing="8">
   <Label Text="{Binding ApplyBlockedReason}" IsVisible="{Binding HasApplyBlockedReason}" TextColor="{StaticResource EditorialMuted}" FontSize="13" LineBreakMode="WordWrap"/>
   <VerticalStackLayout IsVisible="{Binding ShowComparison}" Spacing="8">
    <Button Text="{Binding ChoosePreviousLabel}" Command="{Binding ChoosePreviousCommand}"
            IsEnabled="{Binding CanCompare}" Style="{StaticResource EditorialPrimaryButton}"
            MinimumHeightRequest="48" MinimumWidthRequest="48"/>
    <Button Text="{Binding KeepCurrentLabel}" Command="{Binding KeepCurrentCommand}"
            IsEnabled="{Binding CanCompare}" Style="{StaticResource EditorialSecondaryButton}"
            MinimumHeightRequest="48" MinimumWidthRequest="48"/>
   </VerticalStackLayout>
   <Button Text="{Binding RecoverProposalLabel}" Command="{Binding RecoverProposalCommand}" IsVisible="{Binding CanRecoverProposal}" Style="{StaticResource EditorialSecondaryButton}"/>
   <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsBusy}">
    <ActivityIndicator IsRunning="{Binding IsBusy}" WidthRequest="24"/>
    <Label Grid.Column="1" Text="{Binding BusyMessage}" FontSize="13" TextColor="{StaticResource Muted}" VerticalTextAlignment="Center" LineBreakMode="WordWrap"/>
    <Button Grid.Column="2" Text="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{StaticResource EditorialSecondaryButton}" FontSize="13" Padding="8,10"/>
   </Grid>
   <Button Text="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" IsVisible="{Binding ShowApply}" Style="{StaticResource EditorialPrimaryButton}"/>
   <Button Text="{Binding ViewTripLabel}" Command="{Binding ViewTripCommand}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding ShowOpenTrip}" Style="{StaticResource EditorialPrimaryButton}"/>
  </VerticalStackLayout>
 </Grid>
</pages:TripScopedPage>
