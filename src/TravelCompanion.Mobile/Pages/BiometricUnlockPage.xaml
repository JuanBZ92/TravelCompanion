<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.BiometricUnlockPage"
             x:DataType="viewModels:BiometricUnlockViewModel"
             Title="Desbloquear"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">
    <Grid Padding="28" RowDefinitions="*,Auto,*" BackgroundColor="#F8F3ED">
        <VerticalStackLayout Grid.Row="1" Spacing="20">
            <VerticalStackLayout Spacing="10">
                <Label Text="YUKU JAPAN"
                       CharacterSpacing="6"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D" />
                <Label Text="Bienvenido"
                       FontFamily="serif"
                       FontSize="34"
                       TextColor="#1A1714" />
                <Label Text="{Binding DisplayName, StringFormat='Desbloquea la sesion de {0}.'}"
                       FontSize="16"
                       TextColor="#6E675F" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding UnlockStatusMessage}" FontSize="14" />
                    <Button Text="Desbloquear con biometria"
                            Command="{Binding UnlockCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Usar password"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding UsePasswordCommand}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
