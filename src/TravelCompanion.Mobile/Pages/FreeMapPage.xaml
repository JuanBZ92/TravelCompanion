<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.FreeMapPage"
             x:DataType="viewModels:FreeMapViewModel"
             Title="{Binding [TabMap], Source={x:Static services:LocalizationResourceManager.Instance}}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="{StaticResource Mist}">
    <Grid x:Name="RootLayout" SizeChanged="OnPageLayoutSizeChanged">
        <Grid x:Name="MapContainer" BackgroundColor="#E8E2DA">
            <VerticalStackLayout x:Name="MapFallback"
                                 Padding="28"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="YUKU MAP"
                       CharacterSpacing="5"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Ink}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding [UxMapFallback], Source={x:Static services:LocalizationResourceManager.Instance}}"
                       FontFamily="serif"
                       FontSize="22"
                       TextColor="#1A1714"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Padding="20,18"
              RowDefinitions="Auto,Auto,*"
              InputTransparent="True"
              CascadeInputTransparent="False">
            <Border Grid.Row="0" BackgroundColor="#F2F8F3ED" Stroke="#D8CFC4" StrokeThickness="1" Padding="16,12" IsVisible="{Binding ShowMapSummary}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding [UxMapExplore], Source={x:Static services:LocalizationResourceManager.Instance}}" CharacterSpacing="4" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource EditorialMuted}" />
                        <Label Text="{Binding [UxMapCurated], Source={x:Static services:LocalizationResourceManager.Instance}}" FontFamily="serif" FontSize="25" TextColor="#1A1714" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="{Binding [UxChangePin], Source={x:Static services:LocalizationResourceManager.Instance}}"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="10,6"
                            MinimumHeightRequest="48" />
                    <CollectionView Grid.Row="1" Grid.ColumnSpan="2"
                                    ItemsSource="{Binding Cities}"
                                    SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    HeightRequest="48"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:FreeMapCityDto">
                                <Border Padding="16,9" BackgroundColor="{StaticResource Mist}" Stroke="#D8CFC4" StrokeThickness="1">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#3D3329" />
                                                    <Setter Property="Stroke" Value="#3D3329" />
                                                    <Setter TargetName="CityLabel" Property="Label.TextColor" Value="#FFFFFF" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label x:Name="CityLabel" Text="{Binding Name}" FontSize="13" TextColor="#1A1714" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8" BackgroundColor="#F2F8F3ED" Stroke="#D8CFC4" StrokeThickness="1" IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#6E675F" />
            </Border>

            <Border Grid.Row="2" Margin="0,0,0,8" VerticalOptions="End" Style="{StaticResource MapPreviewPanel}" IsVisible="{Binding HasPreview}">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="48" IsVisible="{Binding HasSelection}">
                        <Label Text="{Binding SelectedMarkerPosition}"
                               FontSize="11"
                               TextColor="{StaticResource Muted}"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding SelectedRecommendationType}"
                               CharacterSpacing="2"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Muted}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Button Grid.Column="2"
                                Text="×"
                                Command="{Binding CloseSelectionCommand}"
                                Style="{StaticResource MapPreviewNavigationButton}"
                                WidthRequest="48"
                                MinimumWidthRequest="48"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                FontSize="16"
                                SemanticProperties.Description="{Binding [UxClose], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                    </Grid>

                    <ScrollView x:Name="RecommendationPreviewScroll" Grid.Row="1" MaximumHeightRequest="220">
                      <VerticalStackLayout Spacing="6">
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsUnlockedSelection}">
                            <Label Text="{Binding SelectedRecommendation.Title}"
                                   FontFamily="serif"
                                   FontSize="22"
                                   TextColor="{StaticResource Ink}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedLocationText}"
                                   FontSize="11"
                                   TextColor="{StaticResource Muted}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedRecommendation.DisplayDescription}"
                                   FontSize="13"
                                   TextColor="{StaticResource InkSoft}"
                                   LineHeight="1.2"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedMetadataText}"
                                   FontSize="11"
                                   TextColor="{StaticResource Muted}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedTagsText}"
                                   FontSize="11"
                                   TextColor="#8A6F3D"
                                   LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsLockedSelection}">
                        <Label Text="{Binding [UxLockedPlace], Source={x:Static services:LocalizationResourceManager.Instance}}" FontFamily="serif" FontSize="21" TextColor="{StaticResource Ink}" />
                        <Label Text="{Binding [UxLockedPlaceHelp], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="13" TextColor="{StaticResource Muted}" LineHeight="1.2" />
                        <Button Text="{Binding [UxActivatePass], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding RedeemPassCommand}" Style="{StaticResource EditorialPrimaryButton}" MinimumHeightRequest="48" />
                        <Button Text="{Binding [UxCreateTrip], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding StartFreeBuilderCommand}" Style="{StaticResource GhostButton}" MinimumHeightRequest="48" />
                        <Button Text="{Binding [UxMoreActions], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding MoreAccessOptionsCommand}" Style="{StaticResource GhostButton}" MinimumHeightRequest="48" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowMapSummary}">
                        <Label Text="{Binding [UxFreeRadius], Source={x:Static services:LocalizationResourceManager.Instance}}" CharacterSpacing="3" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource EditorialMuted}" />
                        <Label Text="{Binding MapSummary}" FontFamily="serif" FontSize="20" TextColor="#1A1714" />
                        <Label Text="{Binding [UxTapPin], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="13" TextColor="#6E675F" />
                        <Button Text="{Binding [UxCreateTripTrial], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                Command="{Binding StartFreeBuilderCommand}"
                                Margin="0,8,0,0"
                                BackgroundColor="#3D3329"
                                TextColor="White"
                                CornerRadius="0" />
                        <Button Text="{Binding [UxHavePass], Source={x:Static services:LocalizationResourceManager.Instance}}"
                                Command="{Binding RedeemPassCommand}"
                                Style="{StaticResource GhostButton}"
                                CornerRadius="0" />
                    </VerticalStackLayout>
                      </VerticalStackLayout>
                    </ScrollView>
                    <Grid Grid.Row="2" ColumnDefinitions="48,*,48" ColumnSpacing="8" HeightRequest="48" IsVisible="{Binding HasSelection}">
                        <Button Text="‹"
                                Command="{Binding SelectPreviousMarkerCommand}"
                                IsEnabled="{Binding CanBrowseMarkers}"
                                Style="{StaticResource MapPreviewNavigationButton}"
                                SemanticProperties.Description="{Binding [UxPreviousPlace], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                            <ImageButton Source="itinerary_add.svg"
                                         Command="{Binding AddSelectedToItineraryCommand}"
                                         IsVisible="{Binding IsUnlockedSelection}"
                                         Style="{StaticResource MapPreviewIconButton}"
                                         SemanticProperties.Description="{Binding [UxAddToTrip], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                            <ImageButton Source="tab_map.svg"
                                         Command="{Binding OpenSelectedMapCommand}"
                                         IsVisible="{Binding IsUnlockedSelection}"
                                         Style="{StaticResource MapPreviewIconButton}"
                                         SemanticProperties.Description="{Binding [UxOpenMaps], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="2"
                                Text="›"
                                Command="{Binding SelectNextMarkerCommand}"
                                IsEnabled="{Binding CanBrowseMarkers}"
                                Style="{StaticResource MapPreviewNavigationButton}"
                                SemanticProperties.Description="{Binding [UxNextPlace], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,0,0,8" Padding="16" VerticalOptions="End" BackgroundColor="{StaticResource Mist}" Stroke="#B42318" StrokeThickness="1" IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B42318" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{Binding [UxRetry], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>
        </Grid>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#3D3329" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
