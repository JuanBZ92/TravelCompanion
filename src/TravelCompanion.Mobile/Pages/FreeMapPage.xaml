<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.FreeMapPage"
             x:DataType="viewModels:FreeMapViewModel"
             Title="Map"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F3ED">
    <Grid>
        <Grid x:Name="MapContainer" BackgroundColor="#E8E2DA">
            <VerticalStackLayout x:Name="MapFallback"
                                 Padding="28"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="YUKU MAP"
                       CharacterSpacing="5"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#8E867D"
                       HorizontalTextAlignment="Center" />
                <Label Text="Mapa disponible en Android y iPhone"
                       FontFamily="serif"
                       FontSize="22"
                       TextColor="#1A1714"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Padding="20,18"
              RowDefinitions="Auto,Auto,*"
              InputTransparent="True"
              CascadeInputTransparent="False">
            <Border Grid.Row="0" BackgroundColor="#F2F8F3ED" Stroke="#D8CFC4" StrokeThickness="1" Padding="16,12">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="EXPLORE · YUKU JAPAN" CharacterSpacing="4" FontSize="10" FontAttributes="Bold" TextColor="#8E867D" />
                        <Label Text="Mapa curado" FontFamily="serif" FontSize="25" TextColor="#1A1714" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Cambiar PIN"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="10,6"
                            MinimumHeightRequest="36" />
                    <CollectionView Grid.Row="1" Grid.ColumnSpan="2"
                                    ItemsSource="{Binding Cities}"
                                    SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    HeightRequest="42"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:FreeMapCityDto">
                                <Border Padding="16,9" BackgroundColor="#F8F3ED" Stroke="#D8CFC4" StrokeThickness="1">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#3D3329" />
                                                    <Setter Property="Stroke" Value="#3D3329" />
                                                    <Setter TargetName="CityLabel" Property="Label.TextColor" Value="#FFFFFF" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label x:Name="CityLabel" Text="{Binding Name}" FontSize="13" TextColor="#1A1714" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8" BackgroundColor="#F2F8F3ED" Stroke="#D8CFC4" StrokeThickness="1" IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#6E675F" />
            </Border>

            <Border Grid.Row="2" Margin="0,0,0,8" Padding="14,10" VerticalOptions="End" BackgroundColor="#F8F3ED" Stroke="#D8CFC4" StrokeThickness="1" IsVisible="{Binding HasPreview}">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <Grid ColumnDefinitions="34,Auto,34,*,36,36"
                          ColumnSpacing="4"
                          HeightRequest="36"
                          IsVisible="{Binding HasSelection}">
                        <Button Text="‹"
                                Command="{Binding SelectPreviousMarkerCommand}"
                                IsEnabled="{Binding CanBrowseMarkers}"
                                Style="{StaticResource PagerButton}"
                                WidthRequest="34"
                                MinimumWidthRequest="34"
                                HeightRequest="36"
                                MinimumHeightRequest="36"
                                Padding="0"
                                SemanticProperties.Description="Lugar anterior" />
                        <Label Grid.Column="1"
                               Text="{Binding SelectedMarkerPosition}"
                               FontSize="11"
                               TextColor="#8E867D"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="3,0" />
                        <Button Grid.Column="2"
                                Text="›"
                                Command="{Binding SelectNextMarkerCommand}"
                                IsEnabled="{Binding CanBrowseMarkers}"
                                Style="{StaticResource PagerButton}"
                                WidthRequest="34"
                                MinimumWidthRequest="34"
                                HeightRequest="36"
                                MinimumHeightRequest="36"
                                Padding="0"
                                SemanticProperties.Description="Lugar siguiente" />
                        <Label Grid.Column="3"
                               Text="{Binding SelectedRecommendation.RefinedType}"
                               CharacterSpacing="2"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="#9B9288"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               HorizontalTextAlignment="End"
                               VerticalTextAlignment="Center"
                               Margin="6,0" />
                        <ImageButton Grid.Column="4"
                                     Source="tab_map.svg"
                                     Command="{Binding OpenSelectedMapCommand}"
                                     IsVisible="{Binding IsUnlockedSelection}"
                                     BackgroundColor="Transparent"
                                     BorderWidth="0"
                                     Padding="8"
                                     WidthRequest="36"
                                     HeightRequest="36"
                                     SemanticProperties.Description="Abrir ubicación en Google Maps" />
                        <Button Grid.Column="5"
                                Text="×"
                                Command="{Binding CloseSelectionCommand}"
                                Style="{StaticResource PagerButton}"
                                WidthRequest="36"
                                MinimumWidthRequest="36"
                                HeightRequest="36"
                                MinimumHeightRequest="36"
                                Padding="0"
                                SemanticProperties.Description="Cerrar detalle" />
                    </Grid>

                    <ScrollView Grid.Row="1"
                                MaximumHeightRequest="280"
                                VerticalScrollBarVisibility="Default"
                                IsVisible="{Binding IsUnlockedSelection}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding SelectedRecommendation.Title}"
                                   FontFamily="serif"
                                   FontSize="22"
                                   TextColor="#1A1714"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SelectedRecommendation.DisplayDescription}"
                                   FontSize="13"
                                   TextColor="#4D4741"
                                   LineHeight="1.25"
                                   LineBreakMode="WordWrap" />
                            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                <Label Text="{Binding SelectedLocationText}"
                                       FontSize="11"
                                       TextColor="#6E675F"
                                       Margin="0,0,12,2" />
                                <Label Text="{Binding SelectedMetadataText}"
                                       FontSize="11"
                                       TextColor="#6E675F"
                                       Margin="0,0,0,2" />
                            </FlexLayout>
                            <Label Text="{Binding SelectedTagsText}"
                                   FontSize="11"
                                   TextColor="#8A6F3D"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="1" Spacing="6" IsVisible="{Binding IsLockedSelection}">
                        <Label Text="Hay una recomendación YUKU en esta zona" FontFamily="serif" FontSize="21" TextColor="#1A1714" />
                        <Label Text="Accede al plan Pago o a un viaje Premium para descubrir el lugar, sus tags y todos los detalles." FontSize="13" TextColor="#6E675F" LineHeight="1.25" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding HasContactUrl}">
                            <Button Text="Solicitar acceso" Command="{Binding ContactCommand}" IsVisible="{Binding HasContactUrl}" BackgroundColor="#3D3329" TextColor="White" CornerRadius="0" />
                            <Button Grid.Column="1" Text="Ya tengo PIN" Command="{Binding UseAnotherPinCommand}" Style="{StaticResource GhostButton}" CornerRadius="0" />
                        </Grid>
                        <Button Text="Ya tengo PIN" Command="{Binding UseAnotherPinCommand}" Style="{StaticResource GhostButton}" CornerRadius="0" IsVisible="{Binding ShowPinOnlyAction}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Spacing="4" IsVisible="{Binding ShowMapSummary}">
                        <Label Text="RADIO GRATUITO" CharacterSpacing="3" FontSize="10" FontAttributes="Bold" TextColor="#9B9288" />
                        <Label Text="{Binding MapSummary}" FontFamily="serif" FontSize="20" TextColor="#1A1714" />
                        <Label Text="Toca un pin para explorar." FontSize="13" TextColor="#6E675F" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,0,0,8" Padding="16" VerticalOptions="End" BackgroundColor="#F8F3ED" Stroke="#B42318" StrokeThickness="1" IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B42318" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Reintentar" Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>
        </Grid>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#3D3329" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
