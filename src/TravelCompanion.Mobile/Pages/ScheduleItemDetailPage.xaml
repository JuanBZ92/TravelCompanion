<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ScheduleItemDetailPage"
             x:DataType="viewModels:ScheduleItemDetailViewModel"
             Title=""
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#F8F3ED"
             BackgroundColor="#F8F3ED">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="0">
            <Border HeightRequest="300"
                    BackgroundColor="#F6F1EA"
                    Stroke="#D8CFC4"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid x:Name="MapContainer">
                    <VerticalStackLayout x:Name="MapFallback"
                                         Padding="28"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="{Binding ScheduleItem.LocationName}"
                               FontFamily="serif"
                               FontSize="24"
                               TextColor="#1A1714"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                        <Label Text="{Binding AddressText}"
                               FontSize="13"
                               TextColor="#8A8078"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="28,28,28,40"
                                 Spacing="24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ScheduleItem.TypeLabel}"
                           CharacterSpacing="5"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextTransform="Uppercase"
                           TextColor="#9B9288" />
                    <Label Text="{Binding ScheduleItem.Title}"
                           FontFamily="serif"
                           FontSize="34"
                           TextColor="#1A1714"
                           LineBreakMode="WordWrap"
                           MaxLines="3" />
                    <Label Text="{Binding ReservationReferenceLabel}"
                           FontSize="14"
                           TextColor="#8A8078"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Fecha y horario"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1A1714" />
                    <Label Text="{Binding ReservationTimeLabel}"
                           FontSize="16"
                           LineHeight="1.35"
                           TextColor="#4D4741" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Direccion"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1A1714" />
                    <Label Text="{Binding AddressText}"
                           FontSize="16"
                           LineHeight="1.35"
                           TextColor="#4D4741" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding HasNotes}">
                    <Label Text="Notas"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1A1714" />
                    <Label Text="{Binding NotesText}"
                           FontSize="16"
                           LineHeight="1.45"
                           TextColor="#4D4741" />
                </VerticalStackLayout>

                <Button Text="Abrir mapa"
                        Command="{Binding OpenMapsCommand}"
                        IsEnabled="{Binding HasAddress}"
                        BackgroundColor="#3D3329"
                        TextColor="#FFFFFF"
                        HeightRequest="54"
                        CornerRadius="0"
                        FontSize="16"
                        FontAttributes="Bold" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
