<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ScheduleItemDetailPage"
             x:DataType="viewModels:ScheduleItemDetailViewModel"
             Title=""
             Shell.NavBarIsVisible="False" SafeAreaEdges="All"
             Shell.BackgroundColor="{StaticResource Mist}"
             BackgroundColor="{StaticResource Mist}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="0">
            <Border HeightRequest="300"
                    BackgroundColor="{StaticResource AccentSoft}"
                    Stroke="#D8CFC4"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid x:Name="MapContainer">
                    <VerticalStackLayout x:Name="MapFallback"
                                         Padding="28"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="{Binding ScheduleItem.LocationName}"
                               FontFamily="serif"
                               FontSize="24"
                               TextColor="#1A1714"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                        <Label Text="{Binding AddressText}"
                               FontSize="13"
                               TextColor="#8A8078"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </VerticalStackLayout>

                    <Button Text="&lt;"
                            Clicked="OnBackClicked"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            Margin="20,22,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource Mist}"
                            TextColor="#1A1714"
                            BorderColor="#D8CFC4"
                            BorderWidth="1"
                            CornerRadius="0"
                            FontSize="20" />
                </Grid>
            </Border>

            <VerticalStackLayout Padding="28,28,28,40"
                                 Spacing="24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="RESERVA · YUKU JAPAN"
                           CharacterSpacing="6"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ScheduleItem.Title}"
                           FontFamily="serif"
                           FontSize="34"
                           TextColor="#1A1714"
                           LineBreakMode="WordWrap"
                           MaxLines="3" />
                    <Label Text="{Binding ReservationReferenceLabel}"
                           IsVisible="{Binding HasReservationReference}"
                           FontSize="14"
                           TextColor="#8A8078"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding ScheduleItem.TypeLabel}"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextTransform="Uppercase"
                           TextColor="#B8956A" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="FECHA Y HORARIO"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ReservationTimeLabel}"
                           FontSize="15"
                           LineHeight="1.35"
                           TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="DIRECCION"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding AddressText}"
                           FontSize="15"
                           LineHeight="1.35"
                           TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasCuratedNotes}">
                    <Label Text="NOTAS YUKU" CharacterSpacing="3" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding CuratedNotes}" FontSize="15" LineHeight="1.3" TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding HasNotes}">
                    <Label Text="NOTAS PERSONALES"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding NotesText}"
                           FontSize="15"
                           LineHeight="1.3"
                           TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <Button Text="Abrir mapa"
                        Command="{Binding OpenMapsCommand}"
                        IsEnabled="{Binding HasAddress}"
                        BackgroundColor="#3D3329"
                        TextColor="#FFFFFF"
                        MinimumHeightRequest="48"
                        CornerRadius="0"
                        FontSize="15"
                        FontAttributes="Bold" />
                <Border Padding="14,12" BackgroundColor="#FFFCF8" Stroke="#DDD4C9"
                        StrokeThickness="1" IsVisible="{Binding HasLinkedDocument}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="DOCUMENTO" CharacterSpacing="2" FontSize="10" TextColor="#9D794F" />
                            <Label Text="{Binding LinkedDocumentTitle}" FontSize="14" TextColor="#1A1714"
                                   MaxLines="1" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Ver documento" Command="{Binding OpenLinkedDocumentCommand}"
                                Style="{StaticResource GhostButton}" FontSize="12" MinimumHeightRequest="40" />
                    </Grid>
                </Border>
                <Button Text="Vincular documento" Command="{Binding LinkDocumentCommand}"
                        IsVisible="{Binding CanLinkDocument}" Style="{StaticResource GhostButton}"
                        FontSize="12" MinimumHeightRequest="42" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
