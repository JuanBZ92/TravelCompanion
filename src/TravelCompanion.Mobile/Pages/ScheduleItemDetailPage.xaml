<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ScheduleItemDetailPage"
             x:DataType="viewModels:ScheduleItemDetailViewModel"
             Title="{Binding ScheduleItem.Title}">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="6">
            <Label Text="{Binding ScheduleItem.TypeLabel}" Style="{StaticResource Eyebrow}" />
            <Label Text="{Binding ScheduleItem.Title}" Style="{StaticResource Headline}" />
            <Label Text="{Binding ScheduleItem.City}" Style="{StaticResource Metadata}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}" />
            <Label Text="{Binding ScheduleItem.MainDetail}" Style="{StaticResource SubHeadline}" Margin="0,0,0,12" />

            <Button Text="Abrir mapa"
                    Command="{Binding OpenMapsCommand}"
                    Margin="0,0,0,12" />

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Horario" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ScheduleItem.Date, StringFormat='Fecha: {0:dddd, MMM d}'}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.StartDisplay}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.EndDisplay}" IsVisible="{Binding ScheduleItem.HasEnd}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.ConfirmationCode, StringFormat='Codigo: {0}'}" FontSize="14" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Detalle" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ScheduleItem.MainDetail}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.SecondaryDetail}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.Airline, StringFormat='Aerolinea: {0}'}" IsVisible="{Binding ScheduleItem.HasAirline}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.FlightNumber, StringFormat='Vuelo: {0}'}" IsVisible="{Binding ScheduleItem.HasFlightNumber}" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding ScheduleItem.OriginAirport, StringFormat='Aeropuerto origen: {0}'}" IsVisible="{Binding ScheduleItem.HasOriginAirport}" FontSize="14" />
                    <Label Text="{Binding ScheduleItem.DestinationAirport, StringFormat='Aeropuerto destino: {0}'}" IsVisible="{Binding ScheduleItem.HasDestinationAirport}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Direccion" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ScheduleItem.Address}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Notas" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ScheduleItem.Notes}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
