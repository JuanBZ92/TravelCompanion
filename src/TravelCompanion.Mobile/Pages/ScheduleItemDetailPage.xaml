<?xml version="1.0" encoding="utf-8" ?>
<pages:TripScopedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:pages="clr-namespace:TravelCompanion.Mobile.Pages"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.ScheduleItemDetailPage"
             x:DataType="viewModels:ScheduleItemDetailViewModel"
             Title=""
             Shell.NavBarIsVisible="False" SafeAreaEdges="All"
             Shell.BackgroundColor="{StaticResource Mist}"
             BackgroundColor="{StaticResource Mist}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="0">
            <Border HeightRequest="176"
                    BackgroundColor="{StaticResource AccentSoft}"
                    Stroke="#D8CFC4"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid x:Name="MapContainer">
                    <VerticalStackLayout x:Name="MapFallback"
                                         Padding="28"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="{Binding ScheduleItem.LocationName}"
                               FontFamily="serif"
                               FontSize="24"
                               TextColor="#1A1714"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                        <Label Text="{Binding AddressText}"
                               FontSize="13"
                               TextColor="#8A8078"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </VerticalStackLayout>

                    <Button Text="&lt;"
                            Clicked="OnBackClicked"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            Margin="20,22,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource Mist}"
                            TextColor="#1A1714"
                            BorderColor="#D8CFC4"
                            BorderWidth="1"
                            CornerRadius="12"
                            SemanticProperties.Description="{Binding [UxBack], Source={x:Static services:LocalizationResourceManager.Instance}}"
                            FontSize="20" />
                </Grid>
            </Border>

            <VerticalStackLayout Padding="24,20,24,32"
                                 Spacing="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding [UxReservationEyebrow], Source={x:Static services:LocalizationResourceManager.Instance}}"
                           CharacterSpacing="6"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ScheduleItem.Title}"
                           FontFamily="serif"
                           FontSize="34"
                           TextColor="#1A1714"
                           LineBreakMode="WordWrap"
                           MaxLines="3" />
                    <Label Text="{Binding ReservationReferenceLabel}"
                           IsVisible="{Binding HasReservationReference}"
                           FontSize="14"
                           TextColor="#8A8078"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding ScheduleItem.TypeLabel}"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextTransform="Uppercase"
                           TextColor="{StaticResource EditorialAccentText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding [UxDateTime], Source={x:Static services:LocalizationResourceManager.Instance}}"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ReservationTimeLabel}"
                           FontSize="15"
                           LineHeight="1.35"
                           TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding [UxAddress], Source={x:Static services:LocalizationResourceManager.Instance}}"
                           CharacterSpacing="3"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding AddressText}"
                           FontSize="15"
                           LineHeight="1.35"
                           TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasEditorialReview}">
                    <Label Text="{Binding EditorialStatus}" FontSize="13" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasCuratedNotes}">
                    <Label Text="{Binding [UxCuratedNotes], Source={x:Static services:LocalizationResourceManager.Instance}}" CharacterSpacing="3" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding CuratedNotes}" FontSize="15" LineHeight="1.3" TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,48">
                        <Label Text="{Binding [UxPersonalNotes], Source={x:Static services:LocalizationResourceManager.Instance}}" CharacterSpacing="3" FontSize="11"
                               FontAttributes="Bold" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        <ImageButton Grid.Column="1" Source="action_edit.svg" Command="{Binding OpenJournalCommand}"
                                     WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"
                                     SemanticProperties.Description="{Binding [UxEditMemory], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                    </Grid>
                    <Label Text="{Binding [UxMemoryHint], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="14" TextColor="{StaticResource InkSoft}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasNotes}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding NotesText}" IsVisible="{Binding HasNotes}"
                           FontSize="15"
                           LineHeight="1.3"
                           TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <ImageButton Source="expense_other.svg" Clicked="OnExpenseClicked" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Padding="12" SemanticProperties.Description="{Binding [UxAddExpense], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        <Label Text="{Binding [UxExpense], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="{StaticResource InkSoft}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <ImageButton Source="today_folded_map.svg" Command="{Binding OpenMapsCommand}" IsEnabled="{Binding HasAddress}"
                            WidthRequest="52" HeightRequest="52" Padding="13" BackgroundColor="Transparent" HorizontalOptions="Center"
                            SemanticProperties.Description="{Binding [UxOpenMaps], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        <Label Text="{Binding [UxMap], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="{StaticResource InkSoft}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <ImageButton Source="tab_journal.svg" Command="{Binding OpenJournalCommand}"
                            WidthRequest="52" HeightRequest="52" Padding="13" BackgroundColor="Transparent" HorizontalOptions="Center"
                            SemanticProperties.Description="{Binding [UxOpenJournal], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        <Label Text="{Binding [UxJournal], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="{StaticResource InkSoft}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4" IsVisible="{Binding CanLinkDocument}">
                        <ImageButton Source="doc_add.svg" Command="{Binding LinkDocumentCommand}"
                            WidthRequest="52" HeightRequest="52" Padding="13" BackgroundColor="Transparent" HorizontalOptions="Center"
                            SemanticProperties.Description="{Binding [UxLinkDocument], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                        <Label Text="{Binding [UxDocuments], Source={x:Static services:LocalizationResourceManager.Instance}}" FontSize="12" TextColor="{StaticResource InkSoft}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Border Padding="14,12" BackgroundColor="#FFFCF8" Stroke="#DDD4C9"
                        StrokeThickness="1" IsVisible="{Binding HasLinkedDocument}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding [UxDocument], Source={x:Static services:LocalizationResourceManager.Instance}}" CharacterSpacing="2" FontSize="10" TextColor="#9D794F" />
                            <Label Text="{Binding LinkedDocumentTitle}" FontSize="14" TextColor="#1A1714"
                                   MaxLines="1" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="1" Source="doc_open.svg" Command="{Binding OpenLinkedDocumentCommand}"
                            BackgroundColor="Transparent" Padding="12" WidthRequest="48" HeightRequest="48"
                            SemanticProperties.Description="{Binding [UxOpenDocument], Source={x:Static services:LocalizationResourceManager.Instance}}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</pages:TripScopedPage>
