<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels" xmlns:dto="clr-namespace:TravelCompanion.Shared.Dtos;assembly=TravelCompanion.Shared" xmlns:services="clr-namespace:TravelCompanion.Mobile.Services"
 x:Class="TravelCompanion.Mobile.Pages.DayProposalPage" x:DataType="viewModels:DayProposalViewModel" Title="{Binding [ProposalPageTitle], Source={x:Static services:LocalizationResourceManager.Instance}}">
<Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="14"><ScrollView><VerticalStackLayout Spacing="14"><Label Text="{Binding [ProposalCompare], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Title}" Style="{StaticResource Title}"/><Label Text="{Binding Narrative}" Style="{StaticResource Body}"/>
<Label Text="{Binding [ProposalCurrent], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource SubHeadline}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentItems}" Spacing="6"><BindableLayout.ItemTemplate><DataTemplate x:DataType="dto:ScheduleItemDto"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Label Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}'}" Style="{StaticResource Metadata}"/><Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Body}"/><Label Grid.Column="2" Text="{Binding [ProposalProtected], Source={x:Static services:LocalizationResourceManager.Instance}}" IsVisible="{Binding IsProtected}" Style="{StaticResource Metadata}"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
<Label Text="{Binding [ProposalProposed], Source={x:Static services:LocalizationResourceManager.Instance}}" Style="{StaticResource SubHeadline}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding Changes}" Spacing="10"><BindableLayout.ItemTemplate><DataTemplate x:DataType="dto:ItineraryChangeDto"><Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Kind}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Title}" Style="{StaticResource SectionTitle}"/><Label Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}'}" Style="{StaticResource Metadata}"/><Label Text="{Binding Explanation}" Style="{StaticResource Body}"/><HorizontalStackLayout Spacing="8"><Button Text="{Binding [ProposalKeep], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:DayProposalViewModel}}, Path=ExcludeCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}"/><Button Text="{Binding [ProposalReplace], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:DayProposalViewModel}}, Path=ReplaceCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}"/><Button Text="{Binding [ProposalMoveEarlier], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:DayProposalViewModel}}, Path=MoveEarlierCommand}" CommandParameter="{Binding .}" Style="{StaticResource GhostButton}"/></HorizontalStackLayout></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
<VerticalStackLayout BindableLayout.ItemsSource="{Binding Warnings}"><BindableLayout.ItemTemplate><DataTemplate><Label Text="{Binding ., StringFormat='⚠ {0}'}" Style="{StaticResource Metadata}"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
<Label Text="{Binding StatusMessage}" Style="{StaticResource Body}"/><Border Style="{StaticResource ErrorPanel}" IsVisible="{Binding HasError}"><Label Text="{Binding ErrorMessage}"/></Border></VerticalStackLayout></ScrollView>
<Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="{Binding [ProposalApplyAll], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/><Button Grid.Column="1" Text="{Binding [ProposalUndo], Source={x:Static services:LocalizationResourceManager.Instance}}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource GhostButton}"/></Grid></Grid>
</ContentPage>
