<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TravelCompanion.Mobile.ViewModels"
             x:Class="TravelCompanion.Mobile.Pages.SupportPage"
             x:DataType="viewModels:SupportViewModel"
             Title="Cuenta"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="18,18,18,0" Spacing="14">
            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ayuda durante el viaje" Style="{StaticResource SectionTitle}" />
                    <Label Text="Canal para dudas, cambios de reserva y recomendaciones de ultimo momento." FontSize="14" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="WhatsApp" />
                        <Button Grid.Column="1" Text="Email" Style="{StaticResource GhostButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cuenta" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding DisplayName}" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding Email}" Style="{StaticResource Metadata}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Biometria" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Usar huella, Face ID o biometria disponible al abrir la app." Style="{StaticResource Metadata}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsBiometricEnabled}"
                                VerticalOptions="Center" />
                    </Grid>
                    <Button Text="Bloquear app"
                            Command="{Binding LockCommand}" />
                    <Button Text="Cerrar sesion"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding LogoutCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Emergencias" Style="{StaticResource SectionTitle}" />
                    <Label Text="Policia: 110" FontSize="14" />
                    <Label Text="Ambulancia y bomberos: 119" FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
