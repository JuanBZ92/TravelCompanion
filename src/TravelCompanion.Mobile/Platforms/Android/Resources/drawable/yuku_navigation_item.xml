<?xml version="1.0" encoding="utf-8" ?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#183D3329">
  <item>
    <selector>
      <item android:state_checked="true">
        <layer-list>
          <item android:gravity="top|center_horizontal" android:width="24dp" android:height="2dp">
            <shape android:shape="rectangle">
              <solid android:color="#B8956A" />
              <corners android:radius="1dp" />
            </shape>
          </item>
        </layer-list>
      </item>
      <item><shape><solid android:color="@android:color/transparent" /></shape></item>
    </selector>
  </item>
</ripple>
