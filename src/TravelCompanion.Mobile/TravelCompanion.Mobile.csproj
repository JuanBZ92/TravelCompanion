<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>TravelCompanion.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en-US</NeutralLanguage>

		<!-- Display name -->
		<ApplicationTitle>TravelCompanion.Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.yuku.travelcompanion.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>87</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Keep Android device launches reliable when starting without the debugger or after clean/rebuild cycles. -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
	  <!-- New App Store delivery after build 63; other platforms keep their version. -->
	  <ApplicationVersion>64</ApplicationVersion>
	  <ProvisioningType>manual</ProvisioningType>
	  <CodesignKey>Apple Distribution: Juan Zardini (AG5JMK42KA)</CodesignKey>
	  <CodesignProvision>TravelCompanionProfile</CodesignProvision>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)'=='net10.0-ios'">
	  <TravelCompanionApiBaseUrl Condition="'$(TravelCompanionApiBaseUrl)' == ''">https://travelcompanion-api-57dw.onrender.com</TravelCompanionApiBaseUrl>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)'=='net10.0-android'">
	  <TravelCompanionApiBaseUrl Condition="'$(TravelCompanionApiBaseUrl)' == ''">https://travelcompanion-api-57dw.onrender.com</TravelCompanionApiBaseUrl>
	</PropertyGroup>

	<ItemGroup Condition="'$(TravelCompanionApiBaseUrl)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TravelCompanionApiBaseUrl</_Parameter1>
			<_Parameter2>$(TravelCompanionApiBaseUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup Condition="'$(TravelCompanionDiagnosticsEnabled)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TravelCompanionDiagnosticsEnabled</_Parameter1>
			<_Parameter2>$(TravelCompanionDiagnosticsEnabled)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#18201D" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#18201D" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.60" />
		<PackageReference Include="Oscore.Maui.Biometric" Version="2.5.1" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Android.Google.BillingClient" Version="8.0.0" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and !$([MSBuild]::IsOSPlatform('osx'))">
		<StoreKitBridgeFramework Condition="'$(StoreKitBridgeFramework)' == '' and Exists('$(MSBuildProjectDirectory)/../../artifacts/storekit/StoreKitBridge.xcframework/Info.plist')">$(MSBuildProjectDirectory)/../../artifacts/storekit/StoreKitBridge.xcframework</StoreKitBridgeFramework>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<XcodeProject Include="Platforms/iOS/StoreKitBridge/StoreKitBridge.xcodeproj" Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(StoreKitBridgeFramework)' == ''">
			<SchemeName>StoreKitBridge</SchemeName>
			<Kind>Framework</Kind>
			<ForceLoad>true</ForceLoad>
			<Frameworks>StoreKit UIKit</Frameworks>
		</XcodeProject>
		<NativeReference Include="$(StoreKitBridgeFramework)" Condition="'$(StoreKitBridgeFramework)' != ''">
			<Kind>Framework</Kind>
			<ForceLoad>true</ForceLoad>
			<Frameworks>StoreKit UIKit</Frameworks>
		</NativeReference>
	</ItemGroup>

	<Target Name="ValidateStoreKitBridge" BeforeTargets="PrepareForBuild"
		Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(DesignTimeBuild)' != 'true'">
		<Error Condition="!$([MSBuild]::IsOSPlatform('osx')) and '$(StoreKitBridgeFramework)' == ''"
			Text="Falta StoreKitBridge.xcframework. En el Mac ejecutá bash scripts/build-ios-storekit.sh y extraé el ZIP generado en artifacts/storekit de este repositorio Windows. Luego volvé a publicar. Ver docs/ios-storekit-build.md." />
		<Error Condition="'$(StoreKitBridgeFramework)' != '' and !Exists('$(StoreKitBridgeFramework)')"
			Text="No existe StoreKitBridgeFramework: $(StoreKitBridgeFramework)." />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\TravelCompanion.Shared\TravelCompanion.Shared.csproj" />
	</ItemGroup>

</Project>
