<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelCompanion.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TravelCompanion.Mobile.Pages"
    Title="Travel Companion"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource NightSurface}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource PrimaryDark}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource NightMuted}}">

    <ShellContent
        Title="Ingresar"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Desbloquear"
        ContentTemplate="{DataTemplate pages:BiometricUnlockPage}"
        Route="biometric-unlock" />

    <ShellContent
        Title="Nueva password"
        ContentTemplate="{DataTemplate pages:ChangePasswordPage}"
        Route="change-password" />

    <TabBar Route="main">
        <ShellContent
            x:Name="RecommendationsTab"
            Title="Discover"
            Icon="tab_ideas.svg"
            ContentTemplate="{DataTemplate pages:RecommendationsPage}"
            Route="recommendations" />

        <ShellContent
            x:Name="ScheduleTab"
            Title="Today"
            Icon="tab_trip.svg"
            ContentTemplate="{DataTemplate pages:SchedulePage}"
            Route="schedule" />

        <ShellContent
            x:Name="AssistantTab"
            Title="Assistant"
            Icon="tab_ideas.svg"
            ContentTemplate="{DataTemplate pages:TravelChatPage}"
            Route="assistant" />

        <ShellContent
            x:Name="DocsTab"
            Title="Docs"
            Icon="tab_docs.svg"
            ContentTemplate="{DataTemplate pages:DocsPage}"
            Route="docs" />
    </TabBar>

</Shell>
